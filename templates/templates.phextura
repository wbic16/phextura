 } {}%
 \IfBooleanTF{#1}{%有星号，显示页码
 \includepdf[fitpaper=true,pagecommand={\thispagestyle{hit@scanpage}}]{#2}%
 }{%无星号，不显示页码
 \includepdf[fitpaper=true,pagecommand={\thispagestyle{empty}}]{#2}%
 }%
 }%
 }
