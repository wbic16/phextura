    \end{multicols}%
  }
  \newenvironment{art}[2][]
    {\begin{@art}[#1]{\articletitle{#2}}}{\end{@art}}
  \newenvironment{artsubtit}[3][]
    {\begin{@art}[#1]{\subjecttitle{#2}{#3}}}{\end{@art}}
