    \RequirePackage { xcolor }
    \providecolorset { HTML }
      % Prefix/postfix of all color names
      { } { }
      {
        \use_none:n
        ; MNthmtitle  , 0F0066
        ; MNthmbg     , EBFEFF
        ; MNthmline   , 4836B3
        ; MNextitle   , 692219
        ; MNexbg      , FFF0EB
