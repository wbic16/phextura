\ifmodern\else\everypar={\leftskip=34pt}\fi
\ifnumlines\let\go\linenumbers\else\let\go\relax\fi\go
}{%
\ifnumlines\let\go\endlinenumbers\else\let\go\relax\fi\go
    \par
    \unskip
    \minipagefootnote@here
    \@minipagefalse   
    \color@endgroup
\egroup% end setbox\absbox
}%

