{
  \etocsettocstyle{\section*{\contentsname}}{}
  \etocsetstyle {section}
  {}
  {\leavevmode\leftskip 0cm\relax}
  {\bfseries\normalsize\makebox[.6cm][l]{\etocnumber}
    \etocname\nobreak\hfill\nobreak
