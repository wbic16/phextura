    \begingroup
      \value{secnumdepth}=-\maxdimen
      \subsectionmark{#1}%
    \endgroup
  \else
    \@mkdouble{\MakeMarkcase{#1}}%
  \fi
}
\newcommand*{\idx@@forcemarknumbered}[1]{%
