\else%
\expandafter\gdef\csname email@\romannumeral\the\allauthorcnt\endcsname{}%
\ifthenelse{\equal{#1}{show}}{%
\protected@xdef\@@email{\ifx\@@email\empty#2\else\@@email, #2\fi}}{}%
\fi\fi\global\correspauthorfalse}

