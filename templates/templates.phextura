      {\@currenttocentry}%
    \fi
  \else
    \expandafter\ifnum\scr@v@is@ge{3.15}\relax
      \begingroup
        \let\@elt\@stpelt
        \csname cl@#1\endcsname
      \endgroup
    \fi
    \typeout{#1 without number}%
    \ifx\@currenttocentry\@empty\else
      \hy@insteadofrefstepcounter{#1}%
      \scr@ifundefinedorrelax{add#1tocentry}{%
        \addtocentrydefault{#1}%
      }{%
        \@nameuse{add#1tocentry}%
      }{}{\@currenttocentry}%
    \fi
  \fi
  \if@currentusehead
    \csname #1mark\expandafter\endcsname\expandafter{\@currentheadentry}%
  \fi
  \ifx\@currenttocentry\@empty\else
    \ifdim \@chapterlistsgap>\z@
      \doforeachtocfile{%
        \Iftocfeature{\@currext}{chapteratlist}{%
          \addtocontents{\@currext}{\protect\addvspace{\@chapterlistsgap}}%
        }{}%
      }%
      \expandafter\ifnum \scr@v@is@eq{first}\relax
        \@ifundefined{float@addtolists}{}{%
          \scr@float@addtolists@warning
          \float@addtolists{\protect\addvspace{\@chapterlistsgap}}%
        }%
      \fi
    \fi
  \fi
  \scr@t@st@nd@w@rn@m@k@ch@pt@rh@@d{#1}%
  \if@twocolumn
    \if@at@twocolumn
      \@nameuse{@make#1head}{#3}%
    \else
      \edef\scr@restoreparsetup{%
        \parskip\the\parskip
        \parfillskip\the\parfillskip
        \parindent\the\parindent
      }%
      \@topnewpage[%
        \expandafter\ifnum\scr@v@is@ge{3.46}\relax
        \scr@restoreparsetup
        \vskip\topskip
        \fi
        \@nameuse{@make#1head}{#3\ifhmode\strut\fi}%
        \expandafter\ifnum\scr@v@is@ge{3.46}\relax
        \vskip\dimeval{\ht\strutbox-\dp\strutbox-\topskip+\parskip}%
        \fi
      ]%
    \fi
  \else
    \@nameuse{@make#1head}{#3}%
  \fi
  \@afterheading
}
