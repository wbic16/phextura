  {\textbraceleft #1\textbraceright}%
}
\DeclareRobustCommand{\tbcode}[1]{\mbox{\texttt{#1}}}
\AtBeginDocument{%
\ifx\nolinkurl\undefined
  \DeclareRobustCommand{\tbcodebreak}{\url}
\else
  \DeclareRobustCommand{\tbcodebreak}{\nolinkurl}
\fi
}
\DeclareRobustCommand{\thinskip}{\hskip 0.16667em\relax}
\AtBeginDocument{%
\ifx\hyper@normalise\undefined
  \ifx\url\undefined      % define our own simplistic non-hyperref \url
    \def\url{\begingroup  % might as well catch common special chars
      \catcode`\#=12 \catcode`\$=12 \catcode`\%=12 \catcode`\^=12
      \catcode`\&=12 \catcode`\_=12 \catcode`\~=12
      \finish@tub@url}
  \def\finish@tub@url#1{\tt #1\endgroup}
  \fi
  \let\tburl\url  % no hyperref, so just \url is fine;
  \let\tbsurl\url % \let instead of \def so we can still
  \let\tbhurl\url % use \def\url{\tbsurl} without infloop.
\else
  % This hyperref hook-in is due to Ulrike Fischer.
  % \url{https://github.com/latex3/hyperref/issues/125}.
  % \tb[sh]url@ are defined next.
  \DeclareRobustCommand*{\tburl}{\tbsurl}%
  \DeclareRobustCommand*{\tbsurl}{\hyper@normalise\tbsurl@}%
  \DeclareRobustCommand*{\tbhurl}{\hyper@normalise\tbhurl@}%
\fi
}
\ExplSyntaxOn
\cs_new:Npn \str_if_starts_with:nnTF #1#2
  {
    % #1 = prefix to test
    % #2 = full string
    %
    % compare the first N characters (tokens) of the full string #2,
    %   where N is the length of the prefix #1,
    % to the prefix.
    \str_if_eq:eeTF
      { \str_range:nnn {#2} {1} { \str_count:n {#1} } }
      {#1}
  }

\def\tbsurl@#1  % https
 {
  \group_begin:
   %
   % \url uses math mode for typesetting; fvextra sets \everymath to
   % play with the catcode of -, among others, which ends up causing an
   % infinite loop when we try to typeset the DOI url.
   % https://github.com/gpoore/fvextra/issues/39
   %
   % There's no sensible way to use \everymath with \url, so clear it
   % (suggested to the url.sty author). url.sty also doesn't handle an
   % active hyphen in general: https://tex.stackexchange.com/questions/114704
   \everymath = {}
   %
   % URL encoding for when pdf management (\DocumentMetadata) is active,
   % else a % in the input url ends up as a %25 in the active link.
   % From Ulrike, 4apr26.
   \IfPDFManagementActiveT{
      \bool_if:NTF \l__hyp_href_url_encode_bool
     {
       \tl_set:Nn \l__hyp_text_enc_uri_print_tl {utf8/URI}
     }
     {
       \tl_set:Nn \l__hyp_text_enc_uri_print_tl {utf8/string}
     }
   }% end pdf management
   %
   \str_set:Nn \l_tmpa_str {#1}
   %
   % This checks if http:// is contained anywhere within the argument url,
   % but that was not good enough, since http:// might occur inside the url,
   % e.g., https://web.archive.org/web/20090809184749/http://www.eco-log.de/
   %   \str_if_in:NnTF \l_tmpa_str {http://}
   %
   % Instead we check for "starts with http://".
   % Another fix would have been to insert a constant string "foo" before
   % the argument and the prefix, but since the clean solution is at hand,
   % might as well use it.
   \str_if_starts_with:nnTF {http://} {#1}
    {
      \tbhurl@{#1} % if http, redirect to remove protocol
      % this version prints the http, as we originally thought was better.
      % \expandafter\hyper@linkurl
      % \expandafter{\expandafter\Hurl\expandafter{\l_tmpa_str}}{\l_tmpa_str}
    }
    {
      \str_remove_once:Nn \l_tmpa_str {https://}
      \expandafter\hyper@linkurl
        \expandafter{\expandafter\Hurl\expandafter{\l_tmpa_str}}
                                                          {https://\l_tmpa_str}
    }
  \group_end:
 } % end \tbsurl@
\def\tbhurl@#1
 {
   \str_set:Nn\l_tmpa_str{#1}
   \str_remove_once:Nn \l_tmpa_str {http://}
   \expandafter\hyper@linkurl\expandafter{\expandafter\Hurl\expandafter
                                            {\l_tmpa_str}}{http://\l_tmpa_str}
 }
\ExplSyntaxOff
