\cs_new_protected:Nn \__gzt_uppercased_monthname_french:n
{
  \@orgargctr=#1\relax
  \ifcase\@orgargctr
  \PackageError{datetime}{Invalid~ month~ number~ \the\@orgargctr}{
    Month~ numbers~ should~ go~ from~ 1~ (janvier)~ to~ 12~ (decembre)}
  \or JANVIER
  \or F\'EVRIER
  \or MARS
  \or AVRIL
  \or MAI
  \or JUIN
  \or JUILLET
  \or AO\^UT
  \or SEPTEMBRE
  \or OCTOBRE
  \or NOVEMBRE
  \or D\'ECEMBRE
  \else
  \PackageError{datetime}{Invalid~ month~ number~ \the\@orgargctr}{
    Month~ numbers~ should~ go~ from~ 1~ (janvier)~ to~ 12~ (decembre)}
  \fi
}
