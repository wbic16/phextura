%\newcommand*{\cvitem}[3][.825]{%
%  \cvline[#1]{#2}{#3\vspace*{.75em}}}   % the \vspace*{} inside the cvline environment is a hack... (should conceptually be outside the environment)

% compatibility with versions <= 0.5
