$$\displaystyle\mathbb{P}\left(\sup_{t\in\mathcal{T}}|\widehat{\mathcal{E}}_{a}^{(t)}-\mathcal{E}_{a,\pi}^{(t)}|>\epsilon\right)\leq\mathbb{P}(E_{\mathrm{cnt}}^{c})+\sum_{t\in\mathcal{T}}\mathbb{E}\left[\mathbf{1}_{E_{\mathrm{cnt}}}\min\left\{1,\epsilon^{-r}C_{t,r}(\varkappa_{\ast,a}\log d)^{C_{t,r}}d^{-1/C_{t,r}}\right\}\right].$$


