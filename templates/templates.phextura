    { \str_if_eq_p:Vn \l__dfg_rfs_staff_type_tl { nonResearch } }
    { \tl_if_blank_p:V \l__dfg_rfs_field_tl }
  }
  { \tl_set:Nn \l__dfg_rfs_field_cell_tl { \SetCell{bg=tableNoValue} } }
