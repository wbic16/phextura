  structure=book,
  pagelayout=standard,
  headerstyle=inner,
  headerfont=roman,
  defaultfont=cochineal,
  greekfont=none,
  mathfont=minimal,
  smallcapsstyle=low,
  liststyle=bulged,
  footnotestyle=bulged,
  quotesize=footnotesize,
  quotestyle=center,
  captionstyle=standard,
  marginpar=true,
  tocstyle=standard,
  partstyle=left,
  chapstyle=left,
  secstyle=left,
  subsecstyle=left,
  subsubsecstyle=left,
  partnumstyle=Roman,
  chapnumstyle=arabic,
  secnumstyle=arabic,
  subsecnumstyle=arabic,
  subsubsecnumstyle=arabic,
  partfont=roman,
  chapfont=roman,
  secfont=italic,
  subsecfont=roman,
  subsubsecfont=roman,
  parfont=italic,
  subparfont=roman,
  tocpartfont=roman,
  tocchapfont=roman,
  tocsecfont=roman,
  tocsubsecfont=roman,
  tocsubsubsecfont=roman,
  tocparfont=roman,
  tocsubparfont=roman,
  maketitlestyle=suftesi,
  titlefont=roman,
  authorfont=roman,
  datefont=roman,
  toctitlefont=italic,
  tocauthorfont=roman,
  reverseauthortitle=false,
  authortitlealign=left}
