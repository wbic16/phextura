    {
      \raggedright
      \bool_if:NTF \g_stm_nologo_bool
      { \textit{URL:\c_space_token} } 
      { \includegraphics[height=8pt]{thumbnails/cas-url.jpeg}\c_space_token } 
      \seq_use:Nn \g_stm_uad_seq { ;~ }
    }
  }
  { }
  \group_end:
}

