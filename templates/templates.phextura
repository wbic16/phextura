\AfterPackage{scrlayer-scrpage}{%
  \DeclareNewLayer[%
    background,headsep,%
    addhoffset=\tud@dim@logox-\tud@dim@widemargin,%
    addwidth=-\tud@dim@logox+\tud@dim@widemargin,%
    voffset=\tud@dim@logoy,%
    addvoffset=\tud@dim@layoutvoffset,%
