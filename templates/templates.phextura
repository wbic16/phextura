\msg_new:nnnn { talk } { overheight-header }
  { Overheight~header~on~frame~ \int_use:N \g__talk_frame_int ! }
  {
    Typesetting~the~frame~header,~there~was~too~much~vertical~space~used.
    You~likely~need~to~adjusst~the~overall~space~available~for~frame~titles.
  }
\msg_new:nnnn { talk } { subtitle-not-implemented }
  { Frame~subtitle~not~printed~on~frame~ \int_use:N \g__talk_frame_int ! }
  {
    Typesetting~the~frame~header,~the~frame~subtitle~"#1"~was~given;~
    at~present,~printing~frame~subtitles~is~not~implemented~in~the~standard~
    template.~The~text~will~therefore~be~lost.
  }
\msg_new:nnnn { talk } { unknown-frame-name }
  { Unknown~frame~name~"#1"! }
  {
    You~asked~to~reuse~the~contents~of~a~frame~with~the~name~"#1",~
    but~that~name~was~never~defined.
  }
\msg_new:nnnn { talk } { duplicate-frame-name }
  { Duplicate~frame~name~"#1"! }
  {
    You~asked~to~save~the~contents~of~this~frame~with~the~name~"#1",~
    but~that~name~has~already~been~used.
  }
