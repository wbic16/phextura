          \@tempdima\jsc@tocl@width \advance\@tempdima 1zw
          \@dottedtocline{4}{\@tempdima}{5zw}}
\newcommand*{\l@subparagraph}{%
          \@tempdima\jsc@tocl@width \advance\@tempdima 2zw
          \@dottedtocline{5}{\@tempdima}{6zw}}
