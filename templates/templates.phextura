\str_if_eq:VnTF \l__ugentdocs_colormodel_tl {cmyk} {
  %% UGent
  \definecolor{ugent@main}    {cmyk}{1.00,0.40,0.00,0.00} % UGent Blue
  \definecolor{ugent@accent}  {cmyk}{0.00,0.10,1.00,0.00} % UGent Yellow
  %% Faculties
  \definecolor{ugent@lw}      {cmyk}{0.00,0.32,1.00,0.00} % Arts and Philosophy
  \definecolor{ugent@re}      {cmyk}{0.00,0.87,0.85,0.00} % Law and Criminology
  \definecolor{ugent@we}      {cmyk}{0.75,0.00,0.10,0.03} % Sciences
  \definecolor{ugent@ge}      {cmyk}{0.00,0.69,0.29,0.00} % Medicine and Health Sciences
  \definecolor{ugent@ea}      {cmyk}{0.49,0.13,0.00,0.00} % Engineering and Architecture
  \definecolor{ugent@eb}      {cmyk}{0.31,0.05,1.00,0.00} % Economics and Business Administration
  \definecolor{ugent@di}      {cmyk}{0.44,0.70,0.00,0.00} % Veterinary Medicine
  \definecolor{ugent@pp}      {cmyk}{0.00,0.61,0.97,0.00} % Psychology and Educational Sciences
  \definecolor{ugent@bw}      {cmyk}{0.74,0.00,0.29,0.00} % Bioscience Engineering
  \definecolor{ugent@fw}      {cmyk}{0.16,0.83,0.00,0.00} % Pharmaceutical Sciences
  \definecolor{ugent@ps}      {cmyk}{0.71,0.00,1.00,0.00} % Political and Social Sciences

  \definecolor{orcidcolor}    {cmyk}{0.40,0.00,1.00,0.00}
}{
  %% UGent
  \definecolor{ugent@main}    {RGB}{30,100,200}   % UGent Blue
  \definecolor{ugent@accent}  {RGB}{255,210,0}    % UGent Yellow
  %% Faculties
  \definecolor{ugent@lw}      {RGB}{241,164,43}   % Arts and Philosophy
  \definecolor{ugent@re}      {RGB}{220,78,40}    % Law and Criminology
  \definecolor{ugent@we}      {RGB}{45,140,168}   % Sciences
  \definecolor{ugent@ge}      {RGB}{232,94,113}   % Medicine and Health Sciences
  \definecolor{ugent@ea}      {RGB}{139,190,232}  % Engineering and Architecture
  \definecolor{ugent@eb}      {RGB}{174,176,80}   % Economics and Business Administration
  \definecolor{ugent@di}      {RGB}{130,84,145}   % Veterinary Medicine
  \definecolor{ugent@pp}      {RGB}{251,126,58}   % Psychology and Educational Sciences
  \definecolor{ugent@bw}      {RGB}{39,171,173}   % Bioscience Engineering
  \definecolor{ugent@fw}      {RGB}{190,81,144}   % Pharmaceutical Sciences
  \definecolor{ugent@ps}      {RGB}{113,168,96}   % Political and Social Sciences

  \definecolor{orcidcolor}    {RGB}{166,206,57}
}
