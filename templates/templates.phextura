  \newcommand{\titlesubject}[2]
    {\addsec[#1]{{\LARGE #1}\\{\large #2}}}
  \newcommand{\articlesection}[1]{\subsection*{#1}}
  \newcommand{\currentsig}{}
  \newenvironment{@art}[2][]{%
    \begin{multicols}{2}[#2]
