        hline{1,Z} = { \heavyrulewidth, solid },
        hline{2}   = { \lightrulewidth, solid },
        row{1}     = {c, m, font = \small\bfseries },
        #1,
      }
  }
  {
      \end{longtblr}
    \group_end:
  }
