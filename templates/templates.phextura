    \bool_if:NT \l__ctex_patch_cleveref_bool
      {
        \@ifpackageloaded { hyperref }
          {
            \@ifpackagewith { hyperref } { implicit = false }
              { }
              { \__ctex_cleveref_hook_aux:N \H@refstepcounter }
          }
          {
            \__ctex_cleveref_hook_aux:N \refstepcounter@noarg
