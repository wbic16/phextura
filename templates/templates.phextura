    \vskip \baselineskip}
  \newcommand*{\ebsindent}{\relax}
\else
  \renewcommand{\singlespacing}{\setstretch{1.0}%
    \vskip \baselineskip}
  \renewcommand{\onehalfspacing}{\setstretch{1.5}%
    \vskip \baselineskip}
  \newcommand*{\ebsindent}{\addvspace{\medskipamount}\noindent}
\fi
