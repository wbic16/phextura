  \elb@rule{\textwidth}\vspace{11pt}]}}
\newcommand{\elb@rule}[1]{\rule{#1}{0.6pt}}
\newcommand{\affiliation}[1]{\footnote{#1}}
\newcommand{\sameaffiliation}[1][0]{%
