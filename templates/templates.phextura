\tl_gset:Nn \g__gzt_president_signatory_string_tl {pr\'esident~ de~ la~ \g__gzt_smf_short_string_tl}
\tl_gset:Nn \g__gzt_editorinchief_string_tl {R\'edacteur~ en~ chef }
