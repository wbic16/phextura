  \endgroup}
\CodeEscapeChar\\

\@ifundefined{MakePrivateLetters}{%\label{MPL}
  \def\MakePrivateLetters{\makeatletter\catcode`\*=11 }}{}
\def\MakePrivateOthers{\let\do=\@makeother \doprivateothers}
