$$\displaystyle\left|\vartheta_{k}(\widetilde{u}_{k}^{([0:t])})-\vartheta_{k}(\widetilde{\check{u}}_{k}^{([0:t])})\right|\leq\Lambda_{\vartheta}\left(1+\|u_{k}^{([0:t])}\|+\|\check{u}_{k}^{([0:t])}\|+2\sqrt{t+1}\|X_{k\cdot}\Upsilon\|\right)^{\mathfrak{p}-1}\|u_{k}^{([0:t])}-\check{u}_{k}^{([0:t])}\|.$$


