  \tl_gset:Nn \l_city_punc_tl { , }
  \tl_gset:Nn \l_postal_code_punc_tl { , }
  \tl_gset:Nn \l_state_punc_tl { , }
  \tl_gset:Nn \l_country_punc_tl { }
}

