   \end{@coverlist}%
   \vfill
   \begin{@coverlist}%
     \@distributionfont\@distribution
   \end{@coverlist}%
   \newpage\thispagestyle{empty}\hbox{}\newpage
  \thispagestyle{empty}%
  \setcounter{page}{1}%
  \vspace*{-1.5in}%
