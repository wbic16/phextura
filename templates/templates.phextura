\preprintsty@sw{
\vspace*{-\headsep}\vspace*{\headheight}
\footnotesize
{\footnotesize\textsc{\@journalinfo}}\par
{\footnotesize Typeset using \LaTeX\ {\bf preprint} style in AASTeX7.0.1}
\par\vspace*{-\baselineskip}\vspace*{0.625in}
}{
  \manuscriptsty@sw{%
    \vspace*{-\headsep}\vspace*{\headheight}
