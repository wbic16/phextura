\if@chicago
 \def\@eapj@cap@font{\scshape}
 \def\@eapj@figname{Fig.}
 \def\@eapj@tabname{TABLE}
 \def\@eapj@ApJLetters{ApJ}
\else
 \def\@eapj@cap@font{\bfseries}
 \def\@eapj@figname{Figure}
 \def\@eapj@tabname{Table}
 \def\@eapj@ApJLetters{ApJL}
\fi

