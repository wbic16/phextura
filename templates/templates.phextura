            You should simply replace `\detokenize{#2}'\noexpand\MessageBreak
            by `\detokenize{#3}'%
          }%
          \noexpand\KOMAExecuteOptions{#3}%
          \noexpand\def\noexpand\CurrentOption{\CurrentOption}%
        }%
      }{%
        \edef\reserved@a{\noexpand\endgroup
          \noexpand#1{%
