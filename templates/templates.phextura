\newcommand*{\usesizeofkomafont}[1]{%
  \begingroup
    \scr@prepareforkomafont
    \sbox\@tempboxa{%
      \usekomafont{#1}{%
        \selectfont
        \global\let\g@scr@f@size\f@size
        \global\let\g@scr@f@baselineskip\f@baselineskip
        \global\let\g@scr@f@linespread\f@linespread
      }%
    }%
  \endgroup
