\titlecontents*{section}[\SUF@tocindent@chap]{}{%
  \SUF@SEC@contentslabel\adjtoclabelsep\SUF@tocSEC@font}
  {\SUF@tocSEC@font}{, \thecontentspage.}[][\adjtocpagesep][]
