\cs_new_protected:Npn \__talk_column_align_bottom:n #1
  { \vbox:n {#1} }
\cs_new_protected:Npn \__talk_column_align_center:n #1
  {
    \check@mathfonts
    \vbox_set:Nn \l__talk_tmp_box {#1}
    \box_set_ht:Nn \l__talk_tmp_box
      {
          0.5 \box_ht:N \l__talk_tmp_box
        + 0.5 \box_dp:N \l__talk_tmp_box
        + ( \l__talk_vcenter_offset_tl )
      }
    \box_set_dp:Nn \l__talk_tmp_box
      {
          \box_ht:N \l__talk_tmp_box
        - ( \l__talk_vcenter_offset_tl ) * 2
      }
    \box_use_drop:N \l__talk_tmp_box
  }
