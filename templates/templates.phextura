\newenvironment{preamblepage}{%
\cleardoublepage%~
\newpage%
\thispagestyle{empty}%
\baselineskip=.76cm
\parindent=\z@}% at the beginnig of the environment
{\thispagestyle{empty}}% at the end of  environment
