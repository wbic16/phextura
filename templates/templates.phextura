  , number-format = \prepartname\thepart\postpartname
  , heading-decls = \raggedright\parindent\z@\headfont
  , number-decls  = \Large
  , title-decls   = \huge
  , headformat-instance = part
  , para-indent    =  \if@english false\else true \fi
}
