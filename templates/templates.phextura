{\renewcommand\labelitemii{\textopenbullet}}%
{\renewcommand\labelitemii{#3}}%
\IfBlankTF{#4}%
{\renewcommand\labelitemiii{\starredbullet}}%
{\renewcommand\labelitemiii{#4}}%
