  }{% non-starred:
    \ParseLaTeXeHeading {part-nostar} {\BooleanFalse} {#2} {#3}
  }}
\DeclareInstance{heading}{part}{display}
{
  , name          = part
  , level         = -1
  , after-penalty-vspace = 0pt
  , number-format = \huge\prepartname\thepart\postpartname
  , heading-decls = \Huge\centering\bfseries
