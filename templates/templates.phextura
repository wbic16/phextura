       \usebox{\neo@stream@headercontent}
    };

    \coordinate (RefY) at ([yshift=-1cm]headerbox.south);
    \coordinate (CenterMargin) at (current page.north |- RefY);

    \begin{scope}[on background layer, line cap=round]
        \foreach \xa/\xb/\y/\lw/\c/\o in {-5/4.2/0/4pt/primaryColor/1, -3.4/2.4/0.19/2pt/secondaryColor/1, -2/3.4/-0.19/2pt/tertiaryColor/1, -0.6/1.6/0.38/1pt/primaryColor/0.4, -4.3/-1.8/-0.38/1pt/primaryColor/0.4} {
            \draw[\c, line width=\lw, opacity=\o] ([xshift=\xa cm, yshift=\y cm]CenterMargin) -- ([xshift=\xb cm, yshift=\y cm]CenterMargin);
