    \fi
    \ifx\@nil#3\@nil\else
      \noexpand\special@index{%
        \the\@temptokenb\noexpand\levelchar
        ##1\noexpand\actualchar{\string\ttfamily\space##1}%
        \noexpand\encapchar main%
