    \or% nottotoc
      \tud@locked@num@set{tud@declaration@toc@num}{0}%
    \or% totoc
      \ifnum\tud@declaration@toc@num<\thr@@\relax%
        \tud@locked@num@set{tud@declaration@toc@num}{1}%
      \else%
        \tud@locked@num@set{tud@declaration@toc@num}{3}%
      \fi%
