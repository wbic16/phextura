      }%
      {%
         \setcounter{SDpage}{\thepage}%
      }%
  }%
\ifbool{@twoside}%
  {%
    \ifnumodd{\value{SDpage}}%
      {%
        \makebox[\textwidth][l]{\makebox[\SDlinewidth]{%
          \usebox{\SDfigbox}\hfill\usebox{\SDcapbox}}}%
      }{%
        \makebox[\textwidth][r]{\makebox[\SDlinewidth]{%
          \usebox{\SDcapbox}\hfill\usebox{\SDfigbox}}}%
      }%
  }{%
