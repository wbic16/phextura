\__sysu_define_element:nn { b / declaration / auth-decl }
  {
    content =
      {
        本人完全了解中山大学有关保留、
        使用学位论文的规定，即：
        学校有权保留学位论文
        并向国家主管部门或其指定机构
        送交论文的电子版和纸质版；
        有权将学位论文用于非赢利目的的少量复制
        并允许论文进入学校图书馆、院系资料室被查阅；
        有权将学位论文的内容编入有关数据库进行检索；
        可以采用复印、缩印或其他方法保存学位论文；
        可以为建立了馆际合作关系的兄弟高校用户
        提供文献传递服务和交换服务。
        \para_end:
        保密论文保密期满后，适用本声明。
      },
    bottom-skip = 2 \baselineskip,
    align = n
  }
