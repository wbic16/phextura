    \group_begin:
      \skip_set:Nn \l__ctex_heading_skip {#1}
      \dim_compare:nNnF \l__ctex_heading_skip = \c_zero_dim
        { \skip_horizontal:N \l__ctex_heading_skip }
    \group_end:
  }
