\def\keypreface{\@toklist={}
 \get@keypreface@body}
\def\endkeypreface{\relax}
\long\def\get@keypreface@body#1\end{%
  \@toklist=\expandafter{\the\@toklist#1}%
  \find@keypreface@end}
