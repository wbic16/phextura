    , smaller~subcounter     .bool_set:N    = \l__QA_smaller_subcounter_bool
    , smaller subcounter     .bool_set:N    = \l__QA_smaller_subcounter_bool

    , answer-outside-the-box .bool_set:N    = \l__QA_answer_outside_the_box_bool
