}

\ExplSyntaxOn
\clist_new:N \beautybook@unknownoptions
\cs_new_protected:Npn \beautybook@unknown
  {
    \bool_if:NTF \l__keys_no_value_bool
      { % eg. 12pt, twoside
        \clist_put_right:Nx \beautybook@unknownoptions
          { \l_keys_key_str }
