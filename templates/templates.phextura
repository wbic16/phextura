\@namedef{ver@thumbpdf.sty}{9999/99/99}
\LoadClass[a4paper, full]{l3doc}
\RequirePackage[heading, sub3section, fontset=none]{ctex}
\RequirePackage[sort&compress]{gbt7714}
\RequirePackage{
  caption,
  geometry,
  graphicx,
  listings,
