\newcommand*{\sls@set@values}[4][]{%
  \begingroup
    \Ifstr{#1}{}{%
      \FamilyKeyStateUnknown
    }{%
      \KOMA@set@ifkey{#1}{@tempswa}{#4}%
    }%
