    \geometry{
      top        = 3.0cm,
      bottom     = 3.0cm,
      left       = 3.0cm,
      right      = 2.5cm,
      headheight = 2.5cm,
      headsep    = 0.0cm,
      footskip   = 0.8cm,
    }%
}
