source-archive: abntexto.tar.xz (TeX Live tlnet)
source-files:
  scroll +1: tex/latex/abntexto/abntexto-3-2-1-beta.cls (class, 28481 bytes, sha256 507b713a28ba8ae12af4df0a434998dd981c6a5a640c39c5768302b94e8fbacf, storage utf8)
use in LaTeX: \documentclass{abntexto}
