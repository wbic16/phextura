\RequirePackage{l3keys2e}
\RequirePackage{core/luatex-cn-core-template}
\ProvidesExplClass {ltc-tw-vbook} {2026/10/29} {0.4.3} {Chinese Vertical Book Class (Taiwan)}

% ============================================================================
