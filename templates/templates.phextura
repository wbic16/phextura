\def\cc@countleftbracket{(}
\def\cc@countrightbracket{)}
\NewDocumentCommand{\countleftbracket}{m}{\def\cc@countleftbracket{#1}}
\NewDocumentCommand{\countrightbracket}{m}{\def\cc@countrightbracket{#1}}

