  \__gzt_new_theorem:nnVV
  {style=\l__gzt_newtheorem_style_tl}
  {#2}
  {\l__gzt_newtheorem_frenchtitle_tl}
  {\l__gzt_newtheorem_englishtitle_tl}
}
