  \@ifundefined{c@algorithm}{}{\setcounter{algorithm}{0}}%
  \@ifundefined{c@algocf}{}{\setcounter{algocf}{0}}%
  \@ifundefined{c@example}{}{\setcounter{example}{0}}%
  \@ifundefined{c@definition}{}{\setcounter{definition}{0}}%
}
