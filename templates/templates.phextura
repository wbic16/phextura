  \@bsphack
  \def\@title{#3}%
  \@ifempty{#1}{\def\@shorttitle{\@title}}{\def\@shorttitle{#1}}%
           \@ifempty{#2}{\def\@toctitle{\@shorttitle}}{\def\@toctitle{#2}}%
  \@esphack}%
\newcommandtwoopt*{\subtitle}[3][][]{%
  \@bsphack
  \def\@subtitle{#3}%
  \@ifempty{#1}{\def\@shortsubtitle{\@subtitle}}{\def\@shortsubtitle{#1}}%
