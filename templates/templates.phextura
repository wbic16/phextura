\def\ptxcd_institution{#1}
}
\gdef\ptxcd_datename{Datum}
\gdef\ptxcd_dateseparator{:~}
\setkomafont{disposition}{\sffamily\bfseries}
\cs_new:Nn \ptxcd_titlerule_sep: {\the\dp\strutbox}
