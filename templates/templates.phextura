\newlength{\@B}     % Bleed outside crop / cameraready
\newlength{\@HBS}   % Height bottom strip
\newlength{\@HTS}   % Height top strip
\newlength{\@MS}    % Margin Spine (front/back cover)
\newlength{\@MTLR}  % Margin Text Left Right
\newlength{\@MTTB}  % Margin Text Top Bottom
\newlength{\@HT}    % Height Title
\newlength{\@WD}    % Width Data area
\newlength{\@HD}    % Height Data area
\newlength{\@BT}    % Bleed Top
\newlength{\@WI}    % Width Image
\newlength{\@HI}    % Height Image
\ExplSyntaxOff
\ExplSyntaxOn
\setlength\@B{3mm}
\bool_if:NTF \l__ugentdocs_bwphdcover_bool {
  % BW phd cover
  \setlength\@HBS{4\gridunit}
  \setlength\@HTS{0mm}
  \setlength\@BT{\@B}
  \setlength\@MS{0mm}
  \setlength\@MTLR{2\gridunit}
  \setlength\@MTTB{\gridunit}
  \setlength\@WD{0mm}
  \setlength\@HD{0mm}
  \setlength\@HT{2\@HBS}
}{
  % UGent cover
  \setlength\@HBS{4\gridunit}
  \tl_if_empty:NTF \l__ugentdocs_fselector_tl {
    \setlength\@HTS{0mm}
    \setlength\@BT{\@B}
  }{
    \setlength\@HTS{3\gridunit}
    \setlength\@BT{0mm}
  }
  \setlength\@MS{\gridunit}
  \setlength\@MTLR{\gridunit}
  \setlength\@MTTB{\gridunit}
  \setlength\@WD{12\gridunit}
  \setlength\@HD{10\gridunit}
  \pgfmathsetlength{\@HT}{0.5*\@PH+0.5*\@HBS-0.5*\@HTS+0.5*\@HD}
}
\ExplSyntaxOff
\ExplSyntaxOn
\setlength\@HT{0.9\@PH}

\bool_if:NTF \l__ugentdocs_coverbg_bool {
  \setlength\@MTLR{2\gridunit}
}{
  \setlength\@MTLR{\gridunit}
}
\ExplSyntaxOff
\ExplSyntaxOn
\tl_new:N \l__ugentdocs_authortable_tl
\ExplSyntaxOff
\ExplSyntaxOn
\newcommand{\@coverbodybama}{
  \node[anchor=north~west, inner~sep=0pt, text~width=\@PW-\@MTLR-\gridunit,
  minimum~height=22.05cm, align=flush~left] at (\@MTLR,\@HT)
  {%
    \raggedright
    \begin{spacing}{2.5}
      {\fontsize{25}{30}\selectfont\color{covertitlecolor}\bfseries
        \MakeUppercase{\uline{\@title}}}
    \end{spacing}

    \vskip 1em

    {\fontsize{15}{18}\selectfont\color{covertitlecolor}
      \MakeUppercase{\@subtitle}}

    \vskip 1em

    \begingroup\color{coverdatacolor}
    \ifx\@wordcount\@empty\else
    \translatekey{wordcount}:~\@wordcount
    \fi

    \bool_if:NTF \l__ugentdocs_embargo_bool {
      \vskip 5em
      {\fontsize{15}{18}\selectfont\translatekey[uppercase]{confidential}}
      \vskip 5em
    }{
      \vskip 10em
    }

    \tl_set:Nx \l__ugentdocs_authortable_tl { \printseq{authorswaff}{\cr}{\cr}{\cr} }
    {\fontsize{15}{18}\selectfont
      \leavevmode\vbox{\halign{##\hfil&\hskip1em##\hfil\cr
          \l__ugentdocs_authortable_tl
          \cr}}
    }

    \ifx\@studentnr\@empty\else
    \par\translatekey{studentnr}:~\@studentnr
    \fi

    \vskip 1em

    {\fontsize{12}{15}\selectfont
      \getseqcaption{supervisors}{
        :~\printseq{supervisors}{~\&~}{,~}{\translatekey{andlist}~}\\}
    }

    {\fontsize{12}{15}\selectfont
      \getseqcaption{cosupervisors}{
        :~\printseq{cosupervisors}{~\&~}{,~}{\translatekey{andlist}~}\\}
    }

    {\fontsize{12}{15}\selectfont
      \getseqcaption{extsupervisors}{
        :~\printseq{extsupervisors}{~\&~}{,~}{\translatekey{andlist}~}\\}
    }

    \ifseqempty{tutors}{}{
      \vskip 1em
      {\fontsize{12}{15}\selectfont
        \getseqcaption{tutors}{}
        :~\printseq{tutors}{~\&~}{,~}{\translatekey{andlist}~}
      }
    }

    \vskip 1em
    {\@doctype{}~\translatekey[lowercase]{submittedto}%
      \ifx\@fselector\@empty\else{}%
        {}~\translatekey[lowercase]{the-de}~\@faculty{}~\translatekey[lowercase]{of}%
      \fi{}%
      {}~\translatekey{org-deugent},~\translatekey{bmfulfil}%
      {}~\printseq{degrees}{~\&~}{,~}{\translatekey{andlist}~}}

    \vskip 1em
    \translatekey{acyear}:~\@academicyear
    \endgroup
  };
}
\ExplSyntaxOff
\newcommand{\@coverbodyreport}{}
\newcommand{\@coverbodyexam}{}
\ExplSyntaxOn
\newcommand*\@coverbody{
  \exp_args:Nx \str_case:nnF { \l__ugentdocs_covertype_tl } {
    { phd }    { \@coverbodyphd }
    { course } { \@coverbodycourse }
    { bama }   { \@coverbodybama }
    { report } { \@coverbodyreport }
    { exam }   { \@coverbodyexam }
  }{
    \msg_error:nnx { ugentdocs } { cover~type~not~implemented } { \l__ugentdocs_covertype_tl }
  }
}
\ExplSyntaxOff
\ExplSyntaxOn
\newcommand{\@frontcover}{
  \begin{tikzpicture}[inner~sep=0pt, outer~sep=0pt]
  \clip (0,0) rectangle (\@PW,\@PH);

  % Faculty logo
  \begin{scope}[shift={(0,\@PH-3*\gridunit)}]
    \faclogo{3*\gridunit}{ugent@\@fselector}{0}
  \end{scope}

  % Coloured background
  \bool_if:NT \l__ugentdocs_coverbg_bool {
    \fill[coverbgcolor] (\gridunit,4*\gridunit) rectangle (\@PW,\@PH-\@HTS);
    \begingroup
    \colorlet{hypercolor}{covertitlecolor}
  }

  % Cover body
  \@coverbody

  % UGent logo
  \begin{scope}[shift={(0,0)}]
    \ugentlogo{4*\gridunit}{ugent@main}{0}
  \end{scope}

  % Front cover logos
  \ifx\@frontcoverlogos\@empty\else
    \node[anchor=south~east, inner~sep=0pt,
      text~width=\paperwidth-(2+\@ugenttextw/\@logounit)*\gridunit,
      minimum~height=2*\gridunit, align=flush~right]
    at (\paperwidth-\gridunit,\gridunit)
      {\@frontcoverlogos};
  \fi

  \bool_if:NT \l__ugentdocs_coverbg_bool {
    \endgroup
  }
  \end{tikzpicture}
}
\ExplSyntaxOff
\newcommand{\@backcover}{}
\ExplSyntaxOn
\cs_new:Nn \__ugentdocs_sigblock:nn {
  \begin{minipage}[t]{\linewidth}
    \centering
    \rule{0pt}{1.25cm}\\
    \rule{0.8\linewidth}{0.4pt}\\[0.3em]
    #2\\
    {\small\itshape #1}
  \end{minipage}
}

\int_new:N \l__ugentdocs_sigcount_int

\cs_new:Nn \__ugentdocs_sigrow_step:nn {
  \int_incr:N \l__ugentdocs_sigcount_int
  \__ugentdocs_sigblock:nn {#1} {#2}
  \int_compare:nNnTF {\int_mod:nn {\l__ugentdocs_sigcount_int}{2}} = {1}
  { & }
  { \tabularnewline[2em] }
}

\tl_new:N \l__ugentdocs_sigrow_tl
\seq_new:N \l__ugentdocs_sigpairs_seq

\cs_new:Nn \__ugentdocs_siggroup:Nn {
  \int_compare:nNnTF {\seq_count:N #1} = {1}
  {
    \noindent
    \begin{tabularx}{\textwidth}{@{}X@{\hspace{1.5cm}}X@{}}
      \seq_map_inline:Nn #1 { \__ugentdocs_sigblock:nn {#2} {##1} } & \tabularnewline
    \end{tabularx}
  }{
    \seq_clear:N \l__ugentdocs_sigpairs_seq
    \int_zero:N \l__ugentdocs_sigcount_int
    \tl_clear:N \l__ugentdocs_sigrow_tl
    \seq_map_inline:Nn #1 {
      \int_incr:N \l__ugentdocs_sigcount_int
      \int_compare:nNnTF {\int_mod:nn {\l__ugentdocs_sigcount_int}{2}} = {1}
      {
        \tl_set:Nn \l__ugentdocs_sigrow_tl { \__ugentdocs_sigblock:nn {#2} {##1} }
      }{
        \seq_put_right:Nx \l__ugentdocs_sigpairs_seq
        { \exp_not:V \l__ugentdocs_sigrow_tl & \exp_not:n { \__ugentdocs_sigblock:nn {#2} {##1} } }
        \tl_clear:N \l__ugentdocs_sigrow_tl
      }
    }
    \tl_if_empty:NF \l__ugentdocs_sigrow_tl {
      \seq_put_right:Nx \l__ugentdocs_sigpairs_seq { \exp_not:V \l__ugentdocs_sigrow_tl & }
    }
    \noindent
    \begin{tabularx}{\textwidth}{@{}X@{\hspace{1.5cm}}X@{}}
      \seq_use:Nn \l__ugentdocs_sigpairs_seq { \tabularnewline[2em] }
    \end{tabularx}
  }
}

\cs_new:Nn \__ugentdocs_autographpage: {
  \seq_if_empty:NF \g__ugentdocs_authors_seq {
    \translatekey{the-de}~\getseqcaption[lowercase]{authors}{}, \par\vskip 1em
    \__ugentdocs_siggroup:Nn \g__ugentdocs_authors_seq { } % Sub-name key not implemented
  }
  \vskip 2em
  \seq_if_empty:NF \g__ugentdocs_allsupervisors_seq {
    \translatekey{the-de}~\getseqcaption[lowercase]{allsupervisors}{}
    \ifseqempty{tutors}{}{~\translatekey[lowercase]{and}~\getseqcaption[lowercase]{tutors}{}}, \par\vskip 1em
    \__ugentdocs_siggroup:Nn \g__ugentdocs_allsupervisorstutors_seq { } % Sub-name key not implemented
  }
}
\ExplSyntaxOff
\ExplSyntaxOn
\renewcommand{\@copyrightnotices}{%
  \clearpage
  \str_if_eq:VnTF \l__ugentdocs_language_tl {dutch} {
    \@bamadisclaimer
  }{
    \begingroup % Has to be with selectlanguage for the date translation
    \selectlanguage{dutch}
    \@bamadisclaimer
    \endgroup
    \\[\baselineskip]
    \selectlanguage{english}
    \@bamadisclaimer
  }
  \\[\baselineskip]
  \@location,~\@date
  \\[\baselineskip]
  \__ugentdocs_autographpage:

  \vspace*{\stretch{1}}
  \clearpage
}
\newcommand{\@bamadisclaimer}{
  {\translatekey{the-de}~\getseqcaption[lowercase]{authors}{}
    {}~\translatekey[lowercase]{and}~\getseqcaption[lowercase]{allsupervisors}{}}
  \bool_if:NTF \l__ugentdocs_embargo_bool {
    \bool_if:NTF \l__ugentdocs_embargotemp_bool {
      {~\@embargotempwithdates}
    }{
      {~\translatekey{embargofullbama}}
    }
  }{
    {~\translatekey{arrbama}}
  }
}
