\keys_define:nn {ptxcd/fonts} {
  freefonts .choice:,
  freefonts / true .code:n = {
      \bool_gset_true:N  \g__ptxcd_freefonts_bool
      \bool_gset_false:N \g__ptxcd_font_error_bool
    },
  freefonts / auto .code:n = {
      \bool_gset_false:N \g__ptxcd_freefonts_bool
      \bool_gset_false:N \g__ptxcd_font_error_bool
    },
  freefonts / false .code:n = {
      \bool_gset_false:N \g__ptxcd_freefonts_bool
      \bool_gset_true:N \g__ptxcd_font_error_bool
    },
  freefonts .initial:n = auto,
  freefonts .default:n = true,
  freefonts .usage:n = load,
  fontdefaults .bool_gset:N = \g__ptxcd_fontdefaults_bool,
  fontdefaults .initial:n = false,
  fontdefaults .default:n = true,
  fontdefaults .usage:n = load,
  LaTeX-logo .bool_gset:N = \g__ptxcd_use_LaTeX_Logo_bool,
  LaTeX-logo .initial:n = false,
  LaTeX-logo .usage:n = load,
}
\ProcessKeyOptions[ptxcd/fonts]
\bool_if:NF \g__ptxcd_fontdefaults_bool {
  \let\rwth@cached@fdefault\sfdefault
}

\RequirePackage{iftex}
\ifPDFTeX
  \bool_if:NTF \g__ptxcd_freefonts_bool {
    \RequirePackage{arimo}
  } {
    \bool_if:NTF \g__ptxcd_font_error_bool
      {\use_ii:nnn}
      {\use:n}
    {\file_if_exist:nTF {uarial.sty}} {
      \RequirePackage[scaled]{uarial}
    } {
      \RequirePackage{arimo}
    }
  }
  \RequirePackage[T1]{fontenc}
\else
  \RequirePackage{fontspec}
  \bool_if:NTF \g__ptxcd_freefonts_bool {
    \RequirePackage{arimo}
  } {
    \bool_if:NTF \g__ptxcd_font_error_bool
      {\use_ii:nnn}
      {\use:n}
    {
      \fontspec_font_if_exist:nTF {Arial}
    }{
      \setsansfont[
        ItalicFont     = *-Italic ,
        BoldFont       = *-Bold ,
        BoldItalicFont = *-BoldItalic
      ]{Arial}
    }{
      \RequirePackage{arimo}
    }
  }
\fi
\bool_if:NTF \g__ptxcd_fontdefaults_bool {
  \renewcommand*{\familydefault}{\sfdefault}
} {
  \let\rwth@sffamily\sfdefault
  \let\rwth@cached@sfdefault\sfdefault
}
\RequirePackage{anyfontsize}
\DeclareEmphSequence{\bfseries}

\cs_if_exist:NF \ptxcd@OrigLaTeXLogo {
  \bool_if:NF \g__ptxcd_use_LaTeX_Logo_bool {
    \let\ptxcd@OrigLaTeXLogo\LaTeX
    \let\ptxcd@OrigTeXLogo\TeX
    \renewcommand*\LaTeX{LaTeX}
    \renewcommand*\TeX{TeX}
  }
}
\endinput
