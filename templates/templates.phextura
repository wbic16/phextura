\tl_new:N   \l__dfg_funding_cache_sum_two_tl
\tl_new:N   \l__dfg_funding_cache_sum_three_tl
\tl_new:N   \l__dfg_funding_cache_sum_four_tl
\tl_new:N   \l__dfg_funding_cache_sum_five_tl
