    \if@tud@res@swa%
      \tud@strlowercase\tud@res@a{#1}%
      \edef\tud@res@a{\tud@res@a#2.fd}%
      \IfFileExists{\tud@res@a}{\@tud@res@swafalse}{}%
    \fi%
    \if@tud@res@swa%
      \edef\tud@res@a{#1#2.fd}%
      \IfFileExists{\tud@res@a}{\@tud@res@swafalse}{}%
    \fi%
    \if@tud@res@swa%
      \aftergroup\@secondoftwo%
    \else%
      \aftergroup\@firstoftwo%
    \fi%
  \endgroup%
}
