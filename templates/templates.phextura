  \end{__gzt_bibliography_tcbox}
  \nopagebreak[0]
  \IfBooleanTF {#1}
  {
    \printminibios*
  }{
    \printminibios
  }
}
\cs_set_eq:NN \__gzt_bibbycategory \bibbycategory
\RenewDocumentCommand \bibbycategory { s O{} } {
  \bool_if:NT {\g__gzt_multicols_bool} {
    \end{multicols}
  }
