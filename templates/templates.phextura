\newcommand*{\setheadwidth}[2][]{%
  \PackageWarning{scrlayer-scrpage}{%
    Command `\string\setheadwidth' is deprecated.\MessageBreak
    I'm using \detokenize{\KOMAoptions{headwidth=#2:#1}} instead,\MessageBreak
    and so should you do}%
