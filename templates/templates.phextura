\define@boolkey[pd]{class}[pd@@]{clock}[true]{%
  \ifpd@@clock
    \newcount\pd@clockcnt
    \def\pd@startclock##1##2{%
      function pdshowtime(){%
        var pdtime=new Date();%
        this.getField("pdclock.\the\pd@clockcnt").value=util.printd("##1",pdtime);%
        this.dirty=false;%
      }%
      pdshowtime();%
      var pdclock_\the\pd@clockcnt=app.setInterval("pdshowtime()",##2);%
    }%
  \fi
}
