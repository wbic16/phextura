\newcommand*\tud@normalize@@gluekey[3]{%
  \begingroup%
    \edef\tud@res@a{#2}%
    \@tud@res@swafalse%
    \expandafter\if\expandafter\@car\tud@res@a\relax\@nil+\@tud@res@swatrue\fi%
