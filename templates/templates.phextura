    \ifthenelse{\equal{\hypertitle}{}}
       {\renewcommand{\hypertitle}{\currenttitle}}{}
    \ifthenelse{\equal{\hyperauthor}{}}
       {\renewcommand{\hyperauthor}{\currentauthor}}{}
    \ifthenelse{\equal{\hyperabstract}{}}
