\newcommand*{\clearpairofpagestyles}{%
  \ihead[]{}\chead[]{}\ohead[]{}\ifoot[]{}\cfoot[]{}\ofoot[]{}%
}%
\newcommand*{\clearscrheadfoot}{%
  \PackageWarning{scrlayer-scrpage}{%
    replacing deprecated \string\clearscrheadfoot\space by\MessageBreak
