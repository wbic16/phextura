    2%
  \fi
}
\newcommand\hfut@set@math@font@newcm{%
  \hfut@load@unimath
  \hfut@set@unimath@style
  \setmathfont{NewCMMath-Book}[
    Extension    = .otf,
    StylisticSet = \hfut@newcm@integral@stylistic@set,
  ]%
  \setmathfont{NewCMMath-Book}[
