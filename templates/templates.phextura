                  ----8<-------------------------8<----%
                }%
              \fi
            }%
          },%
}
\ekvdefinekeys{udiss}{%
  store   titleshape     = {\udiss@title@shape},%
  initial titleshape     = {\bfseries},%
  store   titlefont      = {\udiss@title@font},%
