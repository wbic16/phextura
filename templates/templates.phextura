  \KOMA@kav@replacevalue{typearea.\scr@pkgextension}{headlines}{#1}%
  \KOMA@kav@replacevalue{typearea.\scr@pkgextension}{headheight}{#1\baselineskip}%
}
\KOMA@key{footlines}{%
