\clearpage
\pagenumbering{Roman}%
\renewcommand{\hautotalpages}{\pageref{hauctocend}}%
\pagestyle{fancy}%
}

\newcommand{\hautocend}{%
\label{hauctocend}%
\clearpage
\renewcommand{\hautotalpages}{\pageref{LastPage}}%
}

