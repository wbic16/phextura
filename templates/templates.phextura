\hook_gput_code:nnn { begindocument / end } { . }
  {
    \cctab_begin:c { c_ \KOMAClassName _cmdhook_cctab }
    \exp_args:Nne
    \hook_gput_code:nnn { cmd / @startsection / before } { \KOMAClassName }
      {
