  \hfut@load@unimath
  \hfut@set@unimath@style
  \hfut@set@stix@names
  \setmathfont{\hfut@font@name@stix@math}[
    Extension    = .otf,
    StylisticSet = \hfut@xits@integral@stylistic@set,
  ]%
  \setmathfont{\hfut@font@name@stix@math}[
    Extension    = .otf,
    StylisticSet = 1,
    range        = {scr,bfscr},
  ]%
}

