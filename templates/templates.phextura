{\renewcommand\labelitemiv{\textperiodcentered}}%
{\renewcommand\labelitemiv{#5}}%
}%
{%
\IfBlankF{#2}{\renewcommand\labelitemi{#2}}%
\IfBlankF{#3}{\renewcommand\labelitemii{#3}}%
