%% ==============================================================================
%% Base class loading
%% ==============================================================================

%% Output mode pre-configuration

\ifneo@twoupafourmode
	\PassOptionsToClass{a5paper}{scrartcl}
	\AtEndPreamble{
		\KOMAoptions{paper=a5}
		\neo@setupmargins
	}
\fi

\ifneo@twoupathreemode
	\PassOptionsToClass{a4paper}{scrartcl}
\fi

\ifneo@fourupathreemode
	\PassOptionsToClass{a5paper}{scrartcl}
	\AtEndPreamble{
		\KOMAoptions{paper=a5}
		\neo@setupmargins
	}
\fi

\ifneo@simpletwoupmode
	\PassOptionsToClass{a4paper}{scrartcl}
	\AtEndPreamble{
		\KOMAoptions{paper=a4}
		\neo@setupmargins
	}
\fi

\ifneo@bookletafourmode
	\PassOptionsToClass{a5paper}{scrartcl}
	\AtEndPreamble{
		\KOMAoptions{paper=a5}
		\neo@setupmargins
	}
\fi

\ifneo@bookletathreemode
	\PassOptionsToClass{a4paper}{scrartcl}
\fi

%% Load base class

\LoadClass{scrartcl}

\KOMAoptions{%
  DIV=last,
  parskip=\neoschool@parskip
}

\AtEndPreamble{%
  \@for\neo@tempopt:=\@unusedoptionlist\do{%
    \ifx\neo@tempopt\@empty\else
      \StrBefore{\neo@tempopt=}{=}[\neo@tempkey]%
      \@tempswafalse
      \ifcsname KV@neoschool@\neo@tempkey\endcsname\@tempswatrue\fi
      \@for\neo@tempitem:=scrartcl.cls,typearea.sty,scrkbase.sty,tocbasic.sty,scrlayer.sty,scrlayer-scrpage.sty\do{%
        \ifcsname KV@KOMA.\neo@tempitem @\neo@tempkey\endcsname\@tempswatrue\fi
      }%
      \ifcsname neo@unknownoption@\neo@tempkey\endcsname\@tempswatrue\fi
      \if@tempswa\else
        \expandafter\let\csname neo@unknownoption@\neo@tempkey\endcsname\@empty
        \ClassWarningNoLine{neoschool}{Unknown option '\neo@tempkey'}%
      \fi
    \fi
  }
  \let\@unusedoptionlist\@empty
}

\title{}

%% Page layout configuration

\newcommand{\neo@setupmargins}{%
  \KOMAoptions{%
    BCOR=0pt,
    headinclude=true,
    footinclude=true
  }%
  \ifdim\paperwidth>\paperheight
    \areaset{\dimexpr\paperwidth-2.7cm\relax}{\dimexpr\paperheight-0.5cm\relax}
  \else
    \areaset{\dimexpr\paperwidth-2cm\relax}{\dimexpr\paperheight-0.45cm\relax}
  \fi
}

% Intentionally small margins for teaching materials
\neo@setupmargins

\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000

\raggedbottom

%% ==============================================================================
%% Output Options
%% ==============================================================================

\ifLuaTeX
  \directlua{
    neoschool = neoschool or {}
    local whatsit = node.id("whatsit")
    local hlist = node.id("hlist")
    local vlist = node.id("vlist")
    local strip = {}
    for i, name in pairs(node.whatsits()) do
      if name == "open" or name == "write" or name == "close" or name == "pdf_dest" then strip[i] = true end
    end
    local function clean(head)
      local n = head
      while n do
        local nxt = n.next
        if n.id == whatsit and strip[n.subtype] then
          head = node.remove(head, n)
          node.free(n)
        elseif n.id == hlist or n.id == vlist then
          n.list = clean(n.list)
        end
        n = nxt
      end
      return head
    end
    function neoschool.stripwrites(reg)
      local b = tex.box[reg]
      if b then b.list = clean(b.list) end
    end
  }
  \newbox\neo@pgfbox
  \newcommand{\neo@pgfcopybox}{%
    \ifcsname neo@pgfplaced@\the\pgf@clpn @\the\pgfactualpage\endcsname
      \setbox\neo@pgfbox\copy\csname pgfpages@box@\the\pgf@clpn\endcsname
      \directlua{neoschool.stripwrites(\number\neo@pgfbox)}%
      \box\neo@pgfbox
    \else
      \expandafter\global\expandafter\let\csname neo@pgfplaced@\the\pgf@clpn @\the\pgfactualpage\endcsname\@empty
      \expandafter\copy\csname pgfpages@box@\the\pgf@clpn\endcsname
    \fi
  }
  \newcommand{\neo@pgfstripcopies}{%
    \patchcmd{\pgfpages@buildshipoutbox}{\expandafter\copy\csname pgfpages@box@\the\pgf@clpn\endcsname}{\neo@pgfcopybox}{}{%
      \ClassWarningNoLine{neoschool}{pgfmorepages copy hook not found: identical copies may duplicate the auxiliary writes}%
    }%
  }
\else
  \newcommand{\neo@pgfstripcopies}{%
    \ClassWarningNoLine{neoschool}{Identical copies (2a5toa4, 2a4toa3, 4a5toa3) write the auxiliary data once per copy with this engine: table of contents and labels are duplicated. Compile with lualatex}%
  }
\fi

\AtEndPreamble{
	\ifneo@twoupafourmode
		\usepackage{pgfmorepages}
		\pgfmorepagesloadextralayouts
		\pgfpagesuselayout{repeated 2-up}[a4paper,landscape]
		\neo@pgfstripcopies
		\pgfpagesphysicalpage{2}{}
		\pgfpageslogicalpageoptions{1}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.25\pgfphysicalwidth}{.5\pgfphysicalheight}
		}
		\pgfpageslogicalpageoptions{2}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.75\pgfphysicalwidth}{.5\pgfphysicalheight}
		}
	\fi

	\ifneo@twoupathreemode
		\usepackage{pgfmorepages}
		\pgfmorepagesloadextralayouts
		\pgfpagesuselayout{repeated 2-up}[a3paper,landscape]
		\neo@pgfstripcopies
		\pgfpagesphysicalpage{2}{}
		\pgfpageslogicalpageoptions{1}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.25\pgfphysicalwidth}{.5\pgfphysicalheight}
		}
		\pgfpageslogicalpageoptions{2}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.75\pgfphysicalwidth}{.5\pgfphysicalheight}
		}
	\fi

	\ifneo@fourupathreemode
		\usepackage{pgfmorepages}
		\pgfmorepagesloadextralayouts
		\pgfpagesuselayout{repeated 4-up}[a3paper]
		\neo@pgfstripcopies
		\pgfpagesphysicalpage{4}{}
		\pgfpageslogicalpageoptions{1}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.25\pgfphysicalwidth}{.25\pgfphysicalheight}
		}
		\pgfpageslogicalpageoptions{2}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.25\pgfphysicalwidth}{.75\pgfphysicalheight}
		}
		\pgfpageslogicalpageoptions{3}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.75\pgfphysicalwidth}{.25\pgfphysicalheight}
		}
		\pgfpageslogicalpageoptions{4}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.75\pgfphysicalwidth}{.75\pgfphysicalheight}
		}
	\fi

	\ifneo@simpletwoupmode
		\usepackage{pgfmorepages}
		\pgfmorepagesloadextralayouts
		\pgfpagesuselayout{2 on 1}[a3paper,landscape]
		\pgfpagesphysicalpage{2}{}
		\pgfpageslogicalpageoptions{1}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.25\pgfphysicalwidth}{.5\pgfphysicalheight}
		}
		\pgfpageslogicalpageoptions{2}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.75\pgfphysicalwidth}{.5\pgfphysicalheight}
		}
	\fi

	\ifneo@bookletafourmode
		\usepackage{pgfmorepages}
		\pgfmorepagesloadextralayouts
		\pgfpagesuselayout{4 on 2, book format}[a4paper,landscape]
		\pgfpagesphysicalpage{4}{}
		\pgfpageslogicalpageoptions{4}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.25\pgfphysicalwidth}{.25\pgfphysicalheight}
		}
		\pgfpageslogicalpageoptions{1}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.25\pgfphysicalwidth}{.75\pgfphysicalheight}
		}
		\pgfpageslogicalpageoptions{2}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.75\pgfphysicalwidth}{.25\pgfphysicalheight}
		}
		\pgfpageslogicalpageoptions{3}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.75\pgfphysicalwidth}{.75\pgfphysicalheight}
		}    \fi

	\ifneo@bookletathreemode
		\usepackage{pgfmorepages}
		\pgfmorepagesloadextralayouts
		\pgfpagesuselayout{4 on 2, book format}[a3paper,landscape]
		\pgfpagesphysicalpage{4}{}
		\pgfpageslogicalpageoptions{4}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.25\pgfphysicalwidth}{.25\pgfphysicalheight}
		}
		\pgfpageslogicalpageoptions{1}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.25\pgfphysicalwidth}{.75\pgfphysicalheight}
		}
		\pgfpageslogicalpageoptions{2}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.75\pgfphysicalwidth}{.25\pgfphysicalheight}
		}
		\pgfpageslogicalpageoptions{3}{
			resized width=.9\pgfphysicalwidth,
			resized height=\pgfphysicalheight,
			center=\pgfpoint{.75\pgfphysicalwidth}{.75\pgfphysicalheight}
		}
	\fi
}


%% ==============================================================================
%% Vertical spacing configuration
%% ==============================================================================

\ifdim\neo@vspace@factor pt=1.0pt
  \neo@effective@beforeafterskip=\neo@beforeafterskip
  \neo@effective@baseskip=0.75\baselineskip
  \neo@effective@code@beforeafterskip=\neo@code@box@beforeafterskip
  \neo@effective@ad@beforeafterskip=\neo@ad@beforeafterskip
  \neo@effective@ex@beforeafterskip=0.85\neo@ex@beforeafterskip
\else
  \pgfmathsetmacro{\neo@temp@factor}{\neo@vspace@factor * 0.75}
  \neo@effective@beforeafterskip=\dimexpr\neo@vspace@factor\neo@beforeafterskip\relax
  \neo@effective@baseskip=\dimexpr\neo@temp@factor\baselineskip\relax
  \neo@effective@code@beforeafterskip=\dimexpr\neo@vspace@factor\neo@code@box@beforeafterskip\relax
  \neo@effective@ad@beforeafterskip=\dimexpr\neo@vspace@factor\neo@ad@beforeafterskip\relax
  \neo@effective@ex@beforeafterskip=\dimexpr\neo@vspace@factor\dimexpr0.85\neo@ex@beforeafterskip\relax\relax
\fi

%% ==============================================================================
%% Two-column mode adjustment
%% ==============================================================================

\if@twocolumn
  \setlength{\columnsep}{2em}
\fi

%% ==============================================================================
%% Indentation configuration
%% ==============================================================================

\AtEndOfClass{%
  \ifneoschool@noindent
    \AtBeginDocument{\setlength{\parindent}{0pt}}%
  \else
    \AtBeginDocument{\setlength{\parindent}{\neoschool@indent}}%
  \fi
}

