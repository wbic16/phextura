\def\normaldia{%
   \normalsize%
   \diagramxii%
   \setboardwidth%
}
\def\smalldia{%
   \small%
   \diagramx%
   \setboardwidth%
}
\setboolean{showacademictitle}{false}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\inner@frame\z@%
\v@frame@dist\z@%
\h@frame@dist\z@%
\setboardwidth
\newif\if@first%
