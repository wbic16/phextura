 \endgroup
 \vspace{2cm}
 \begingroup
   \centering
   \textbf{\heiti \fontsize{20}{0} \selectfont \hit@expand}\\
 \endgroup
 \vspace{2.5cm}
\parbox[h][10cm][t]{\textwidth}{\centering\hit@titlepage@info}\par
\begingroup
  \centering
  {\heiti  \sihao\hit@format@date{\hit@date@zh@digit}{\hit@date}\par}%
\endgroup
  \thispagestyle{empty}
  \restoregeometry
}
