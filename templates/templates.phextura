  \let\\\space
  \let\mathbb\@firstofone\let\mathcal\@firstofone\let\mathscr\@firstofone\let\mathfrak\@firstofone
  \let\mathbf\@firstofone\let\mathrm\@firstofone\let\mathit\@firstofone\let\mathsf\@firstofone\let\mathtt\@firstofone
  \let\boldsymbol\@firstofone\let\bm\@firstofone
  \let\vec\@firstofone\let\vv\@firstofone\let\overrightarrow\@firstofone\let\hat\@firstofone\let\widehat\@firstofone
  \let\tilde\@firstofone\let\widetilde\@firstofone\let\dot\@firstofone\let\ddot\@firstofone
}

%% ==============================================================================
%% Font configuration
%% ==============================================================================

\newcommand{\neo@fontset@main}{%
  \Ifstr{\neo@fontset}{ams}{%
    \IfFontExistsTF{NewCM10-Book.otf}%
      {\setmainfont{NewCM10-Book.otf}[BoldFont=NewCM10-Bold.otf, ItalicFont=NewCM10-BookItalic.otf, BoldItalicFont=NewCM10-BoldItalic.otf]}%
      {\setmainfont{lmroman10-regular.otf}[BoldFont=lmroman10-bold.otf, ItalicFont=lmroman10-italic.otf, BoldItalicFont=lmroman10-bolditalic.otf, SmallCapsFont=lmromancaps10-regular.otf]}%
  }{}%
  \Ifstr{\neo@fontset}{mir}{%
    \IfFontExistsTF{Literaturnaya}%
      {\setmainfont{Literaturnaya}}%
      {\setmainfont{texgyreschola-regular.otf}[BoldFont=texgyreschola-bold.otf, ItalicFont=texgyreschola-italic.otf, BoldItalicFont=texgyreschola-bolditalic.otf]}%
  }{}%
  \Ifstr{\neo@fontset}{phys}{%
    \setmainfont{STIXTwoText-Regular.otf}[BoldFont=STIXTwoText-Bold.otf, ItalicFont=STIXTwoText-Italic.otf, BoldItalicFont=STIXTwoText-BoldItalic.otf]%
  }{}%
  \Ifstr{\neo@fontset}{acm}{%
    \setmainfont{LibertinusSerif-Regular.otf}[BoldFont=LibertinusSerif-Bold.otf, ItalicFont=LibertinusSerif-Italic.otf, BoldItalicFont=LibertinusSerif-BoldItalic.otf]%
  }{}%
  \Ifstr{\neo@fontset}{ieee}{%
    \setmainfont{texgyretermes-regular.otf}[BoldFont=texgyretermes-bold.otf, ItalicFont=texgyretermes-italic.otf, BoldItalicFont=texgyretermes-bolditalic.otf]%
  }{}%
  \Ifstr{\neo@fontset}{springer}{%
    \setmainfont{texgyretermes-regular.otf}[BoldFont=texgyretermes-bold.otf, ItalicFont=texgyretermes-italic.otf, BoldItalicFont=texgyretermes-bolditalic.otf]%
  }{}%
}
\newcommand{\neo@fontset@sans}{%
  \Ifstr{\neo@fontset}{ams}{%
    \IfFontExistsTF{NewCMSans10-Book.otf}%
      {\setsansfont{NewCMSans10-Book.otf}[BoldFont=NewCMSans10-Bold.otf, ItalicFont=NewCMSans10-BookOblique.otf, BoldItalicFont=NewCMSans10-BoldOblique.otf]}%
      {\setsansfont{lmsans10-regular.otf}[BoldFont=lmsans10-bold.otf, ItalicFont=lmsans10-oblique.otf, BoldItalicFont=lmsans10-boldoblique.otf]}%
  }{%
  \Ifstr{\neo@fontset}{acm}{%
    \setsansfont{LibertinusSans-Regular.otf}[BoldFont=LibertinusSans-Bold.otf, ItalicFont=LibertinusSans-Italic.otf]%
  }{%
    \setsansfont{texgyreheros-regular.otf}[Scale=0.94, BoldFont=texgyreheros-bold.otf, ItalicFont=texgyreheros-italic.otf, BoldItalicFont=texgyreheros-bolditalic.otf]%
  }}%
}
\newcommand{\neo@fontset@math}{%
  \Ifstr{\neo@fontset}{ams}{\IfFontExistsTF{NewCMMath-Book.otf}{\setmathfont{NewCMMath-Book.otf}}{\setmathfont{latinmodern-math.otf}}}{}%
  \Ifstr{\neo@fontset}{mir}{\setmathfont{texgyreschola-math.otf}\ifLuaTeX\IfFontExistsTF{Literaturnaya}{\setmathfont[range={it/{latin,Latin}}, Scale=1]{Literaturnaya Italic}\setmathfont[range={up/{latin,Latin,num}}, Scale=1]{Literaturnaya}}{}\fi}{}%
  \Ifstr{\neo@fontset}{phys}{\setmathfont{STIXTwoMath-Regular.otf}}{}%
  \Ifstr{\neo@fontset}{springer}{\setmathfont{texgyretermes-math.otf}}{}%
  \Ifstr{\neo@fontset}{ieee}{\setmathfont{texgyretermes-math.otf}}{}%
  \Ifstr{\neo@fontset}{acm}{\setmathfont{LibertinusMath-Regular.otf}}{}%
}
\newcommand{\neo@fontset@pdftext}{%
  \Ifstr{\neo@fontset}{ams}{\IfFileExists{mlmodern.sty}{\RequirePackage{mlmodern}}{\RequirePackage{lmodern}}}{}%
  \Ifstr{\neo@fontset}{mir}{\RequirePackage{tgschola}}{}%
  \Ifstr{\neo@fontset}{phys}{\RequirePackage{newtxtext}}{}%
  \Ifstr{\neo@fontset}{springer}{\RequirePackage{newtxtext}}{}%
  \Ifstr{\neo@fontset}{ieee}{\RequirePackage{newtxtext}}{}%
  \Ifstr{\neo@fontset}{acm}{\RequirePackage{libertinus}}{}%
}
\newcommand{\neo@fontset@pdfsans}{%
  \Ifstr{\neo@fontset}{mir}{\RequirePackage[scale=0.92]{tgheros}}{}%
}
\newcommand{\neo@fontset@pdfmath}{%
  \Ifstr{\neo@fontset}{ams}{\RequirePackage{amssymb}}{}%
  \Ifstr{\neo@fontset}{mir}{\RequirePackage{amssymb}\RequirePackage{fouriernc}}{}%
  \Ifstr{\neo@fontset}{phys}{\RequirePackage{newtxmath}}{}%
  \Ifstr{\neo@fontset}{springer}{\RequirePackage{newtxmath}}{}%
  \Ifstr{\neo@fontset}{ieee}{\RequirePackage{newtxmath}}{}%
  \Ifstr{\neo@fontset}{acm}{\RequirePackage{libertinust1math}}{}%
}

\edef\mainface{\expandonce{\neoschool@mainface}}
\edef\sansface{\expandonce{\neoschool@sansface}}
\edef\monoface{\expandonce{\neoschool@monoface}}
\edef\mathface{\expandonce{\neoschool@mathface}}
\edef\facefamily{\expandonce{\neoschool@facefamily}}

\newif\ifneoschool@mathletters
\ifx\neoschool@mathletters\@empty\else\neoschool@mathletterstrue\fi

\ExplSyntaxOn
\cs_new_protected:Npn \neo_pick_font:Nn #1#2
  {
    \clist_set:NV \l_tmpa_clist #1
    \int_compare:nNnT { \clist_count:N \l_tmpa_clist } > { 1 }
      {
        \tl_clear:N \l_tmpa_tl
        \clist_map_inline:Nn \l_tmpa_clist
          {
            \str_if_eq:nnTF {#2} {package}
              { \IfFileExists{##1.sty}{ \tl_set:Nn \l_tmpa_tl {##1} \clist_map_break: }{} }
              { \IfFontExistsTF{##1}{ \tl_set:Nn \l_tmpa_tl {##1} \clist_map_break: }{} }
          }
        \tl_if_empty:NTF \l_tmpa_tl
          {
            \ClassWarningNoLine{neoschool}{None~of~the~fonts~'\clist_use:Nn \l_tmpa_clist {,~}'~is~available;\MessageBreak using~the~default~font}
          }
          {
            \tl_set:Nx \l_tmpb_tl { \clist_item:Nn \l_tmpa_clist {1} }
            \tl_if_eq:NNF \l_tmpa_tl \l_tmpb_tl
              { \ClassWarningNoLine{neoschool}{Font~'\l_tmpb_tl'~not~found;~using~'\l_tmpa_tl'} }
          }
        \tl_set_eq:NN #1 \l_tmpa_tl
      }
  }
\cs_new_protected:Npn \neo@pickfonts #1
  {
    \neo_pick_font:Nn \neoschool@mainface {#1}
    \neo_pick_font:Nn \neoschool@sansface {#1}
    \neo_pick_font:Nn \neoschool@monoface {#1}
    \neo_pick_font:Nn \neoschool@mathface {#1}
    \edef\mainface{\expandonce{\neoschool@mainface}}
    \edef\sansface{\expandonce{\neoschool@sansface}}
    \edef\monoface{\expandonce{\neoschool@monoface}}
    \edef\mathface{\expandonce{\neoschool@mathface}}
  }
\ExplSyntaxOff

\newif\ifneo@mathletters@greek
\newcommand{\neo@applymathletters}{%
  \def\neo@tempa{main}%
  \ifx\neoschool@mathletters\neo@tempa
    \edef\neo@ml@font{\ifx\neoschool@mainface\@empty TeX Gyre Pagella\else\neoschool@mainface\fi}%
  \else
    \let\neo@ml@font\neoschool@mathletters
  \fi
  \begingroup
    \fontspec{\neo@ml@font}%
    \iffontchar\font"03B1 \global\neo@mathletters@greektrue\fi
  \endgroup
  \IfFontExistsTF{\neo@ml@font\space Italic}%
    {\edef\neo@ml@italic{\neo@ml@font\space Italic}}%
    {\let\neo@ml@italic\neo@ml@font}%
  \ifneo@mathletters@greek
    \neo@mlsetfont{it/{latin,Latin,greek,Greek}}{\neo@ml@italic}%
    \neo@mlsetfont{up/{latin,Latin,greek,Greek,num}}{\neo@ml@font}%
  \else
    \neo@mlsetfont{it/{latin,Latin}}{\neo@ml@italic}%
    \neo@mlsetfont{up/{latin,Latin,num}}{\neo@ml@font}%
  \fi
}
% #1 : plage unicode-math ; #2 : macro contenant le nom de la police.
% Les options de 'mathlettersoptions' (FakeBold, etc.) sont ajoutées à Scale=1.
\newcommand{\neo@mlsetfont}[2]{%
  \edef\neo@tempb{\noexpand\setmathfont[range={#1}, Scale=1%
    \ifx\neoschool@mathlettersoptions\@empty\else, \unexpanded\expandafter{\neoschool@mathlettersoptions}\fi
    ]{\unexpanded\expandafter{#2}}}%
  \neo@tempb
}

\newcommand{\neo@checkfontcmd}[3]{%
  \edef\neo@tempa{#2}%
  \ifx\neo@tempa\@empty\else
    \ifcsname\neo@tempa\endcsname\else
      \ClassWarningNoLine{neoschool}{Option '#1': '\neo@tempa' is not a font\MessageBreak command; ignored (expected #3)}%
    \fi
  \fi
}
\AtBeginDocument{%
  \neo@checkfontcmd{headfamily}{\neoschool@headfamily}{rmfamily, sffamily or ttfamily}%
  \neo@checkfontcmd{headweight}{\neoschool@headweight}{bfseries or mdseries}%
  \neo@checkfontcmd{headshape}{\neoschool@headshape}{upshape, itshape, slshape or scshape}%
  \edef\neo@tempc{\neoschool@headfamily}\edef\neo@tempd{\neoschool@titlefamily}%
  \ifx\neo@tempc\neo@tempd\else\neo@checkfontcmd{titlefamily}{\neoschool@titlefamily}{rmfamily, sffamily or ttfamily}\fi
  \edef\neo@tempd{\neoschool@headfootfamily}%
  \ifx\neo@tempc\neo@tempd\else\neo@checkfontcmd{headfootfamily}{\neoschool@headfootfamily}{rmfamily, sffamily or ttfamily}\fi
  \edef\neo@tempc{\neoschool@headweight}\edef\neo@tempd{\neoschool@titleweight}%
  \ifx\neo@tempc\neo@tempd\else\neo@checkfontcmd{titleweight}{\neoschool@titleweight}{bfseries or mdseries}\fi
  \neo@checkfontcmd{titleshape}{\neoschool@titleshape}{upshape, itshape, slshape or scshape}%
  \def\neo@tempb{scshape}%
  \edef\neo@tempa{\neoschool@headshape}%
  \ifx\neo@tempa\neo@tempb
    \begingroup
      \csname\neoschool@headfamily\endcsname\csname\neoschool@headweight\endcsname
      \neo@IfSCAvailableTF{}{\ClassWarningNoLine{neoschool}{Option 'headshape=scshape': the heading font has\MessageBreak no small capitals; headings keep normal letters}}%
    \endgroup
  \fi
}

\newcommand{\neo@checkbold}[3]{%
  \begingroup
    #1\mdseries\upshape\selectfont\edef\neo@tempa{\fontname\font}%
    \bfseries\selectfont\edef\neo@tempb{\fontname\font}%
    \ifx\neo@tempa\neo@tempb
      \ClassWarningNoLine{neoschool}{The #3 font has no bold face;\MessageBreak bold text looks normal. Use #2={AutoFakeBold=2}\MessageBreak for a synthetic bold}%
    \fi
  \endgroup
}
\AtBeginDocument{%
  \ifPDFTeX\else
    \neo@checkbold{\rmfamily}{mainfaceoptions}{main}%
    \neo@checkbold{\sffamily}{sansfaceoptions}{sans}%
  \fi
}

\newenvironment{fullwidth}{\if@twocolumn\par\begin{strip}\fi}{\if@twocolumn\end{strip}\fi}

\newcommand{\neo@setmathface}[1]{%
  \edef\neo@tempa{\noexpand\setmathfont[#1,\ifx\neoschool@mathfacescale\@empty\else Scale=\neoschool@mathfacescale,\fi\unexpanded\expandafter{\neoschool@mathfaceoptions}]{\unexpanded\expandafter{\mathface}}}%
  \neo@tempa
}

\ifPDFTeX
  \ifneoschool@mathletters\ClassWarningNoLine{neoschool}{Option 'mathletters' requires LuaLaTeX; ignored}\fi
  \RequirePackage[utf8]{inputenc}
  \RequirePackage[T1]{fontenc}
  \neo@pickfonts{package}

  \IfStrEq{\facefamily}{}{%
    \IfStrEq{\mainface}{}{%
      \ifx\neo@fontset\@empty\RequirePackage{newpxtext}\else\neo@fontset@pdftext\fi
    }{%
      \RequirePackage[\neoschool@mainfaceoptions]{\neoschool@mainface}%
    }%

    \IfStrEq{\sansface}{}{\ifx\neo@fontset\@empty\else\neo@fontset@pdfsans\fi}{%
      \RequirePackage[\neoschool@sansfaceoptions]{\neoschool@sansface}%
    }%
    \IfStrEq{\monoface}{}{}{%
      \RequirePackage[\neoschool@monofaceoptions]{\neoschool@monoface}%
    }%

    \IfStrEq{\mathface}{}{%
      \ifx\neo@fontset\@empty\else\neo@fontset@pdfmath\fi
      \ifx\neo@fontset\@empty\ifneo@mathastext
        \RequirePackage[italic,eulergreek]{mathastext}%
      \else
        \RequirePackage{amssymb}%
        \RequirePackage{newpxmath}%
      \fi\fi
    }{%
      \RequirePackage[\neoschool@mathfaceoptions]{\neoschool@mathface}%
    }%
  }{%
    \RequirePackage[\neoschool@facefamilyoptions]{\neoschool@facefamily}%
  }

\else
  \AtBeginDocument{
    \providecommand{\square}{\mdlgwhtsquare}
    \providecommand{\blacksquare}{\mdlgblksquare}
  }
  \ifXeTeX
    \ifneoschool@mathletters\ClassWarningNoLine{neoschool}{Option 'mathletters' requires LuaLaTeX; ignored}\fi
    \RequirePackage{fontspec}
    \neo@pickfonts{font}

    \defaultfontfeatures{Ligatures=TeX,Scale=MatchLowercase}
    \defaultfontfeatures[\rmfamily]{Scale=1}

    \IfStrEq{\mathface}{}{%
      \ifx\neo@fontset\@empty\else\RequirePackage{unicode-math}\neo@fontset@math\fi
      \ifx\neo@fontset\@empty\ifneo@mathastext
        \RequirePackage{amssymb}%
        \RequirePackage[italic,eulergreek]{mathastext}%
      \else
        \RequirePackage{unicode-math}
         \IfFontExistsTF{texgyrepagella-math.otf}
           {\setmathfont{texgyrepagella-math.otf}}
           {\setmathfont{latinmodern-math.otf}}
      \fi\fi
    }{%
      \RequirePackage{unicode-math}
      \neo@setmathface{}%
    }

    \IfStrEq{\mainface}{}{%
      \ifx\neo@fontset\@empty\else\neo@fontset@main\fi
      \ifx\neo@fontset\@empty\IfFontExistsTF{texgyrepagella-regular.otf}{%
        \setmainfont{texgyrepagella-regular.otf}[
        BoldFont=texgyrepagella-bold.otf,
        ItalicFont=texgyrepagella-italic.otf,
        BoldItalicFont=texgyrepagella-bolditalic.otf
        ]%
      }{\setmainfont{lmroman10-regular.otf}[
          BoldFont       = lmroman10-bold.otf,
          ItalicFont     = lmroman10-italic.otf,
          BoldItalicFont = lmroman10-bolditalic.otf
      ]}\fi
    }{%
      \setmainfont[\neoschool@mainfaceoptions, Scale=\neoschool@mainfacescale]{\neoschool@mainface}%
    }

    \IfStrEq{\sansface}{}{%
      \ifx\neo@fontset\@empty\else\neo@fontset@sans\fi
      \ifx\neo@fontset\@empty\IfFontExistsTF{texgyreheros-regular.otf}{%
        \setsansfont{texgyreheros-regular.otf}[
        BoldFont=texgyreheros-bold.otf,
        ItalicFont=texgyreheros-italic.otf,
        BoldItalicFont=texgyreheros-bolditalic.otf
        ]%
      }{\setsansfont{lmsans10-regular.otf}[
          BoldFont       = lmsans10-bold.otf,
          ItalicFont     = lmsans10-oblique.otf,
          BoldItalicFont = lmsans10-boldoblique.otf
      ]}\fi
    }{%
      \setsansfont[\neoschool@sansfaceoptions, Scale=\neoschool@sansfacescale]{\neoschool@sansface}%
    }

    \IfStrEq{\monoface}{}{%
      \IfFontExistsTF{texgyrecursor-regular.otf}{%
        \setmonofont{texgyrecursor-regular.otf}[
        Ligatures={ResetAll,TeXOff},
        BoldFont=texgyrecursor-bold.otf,
        ItalicFont=texgyrecursor-italic.otf,
        BoldItalicFont=texgyrecursor-bolditalic.otf
        ]%
      }{\setmonofont{lmmono10-regular.otf}[
          Ligatures      = {ResetAll,TeXOff},
          BoldFont       = lmmonolt10-bold.otf,
          ItalicFont     = lmmono10-italic.otf,
          BoldItalicFont = lmmonolt10-boldoblique.otf
      ]}%
    }{%
      \setmonofont[Ligatures={ResetAll,TeXOff}, \neoschool@monofaceoptions, Scale=\neoschool@monofacescale]{\neoschool@monoface}%
    }
    \Ifstr{\neo@fontset}{mir}{%
      \IfStrEq{\monoface}{}{%
        \setmonofont{texgyrecursor-regular.otf}[Scale=0.95, Ligatures={ResetAll,TeXOff}, BoldFont=texgyrecursor-bold.otf, ItalicFont=texgyrecursor-italic.otf, BoldItalicFont=texgyrecursor-bolditalic.otf]%
      }{}%
    }{}%

  \else
    \ifLuaTeX
      \RequirePackage{fontspec}
      \neo@pickfonts{font}

      \defaultfontfeatures{Ligatures=TeX,Scale=MatchLowercase,Renderer=HarfBuzz}
      \defaultfontfeatures[\rmfamily]{Scale=1}

      \IfStrEq{\mathface}{}{%
        \ifx\neo@fontset\@empty
        \ifneo@mathastext
          \RequirePackage{amssymb}%
          \RequirePackage[italic,eulergreek]{mathastext}%
        \else
          \ifneoschool@mathletters
            \RequirePackage{unicode-math}\setmathfont{texgyrepagella-math.otf}%
          \else
            \RequirePackage{amssymb}%
            \RequirePackage{newpxmath}%
          \fi
        \fi
        \else\RequirePackage{unicode-math}\neo@fontset@math\fi
      }{%
        \RequirePackage{unicode-math}
        \neo@setmathface{}%
      }

      \IfStrEq{\mainface}{}{%
        \ifx\neo@fontset\@empty\setmainfont{TeX Gyre Pagella}\else\neo@fontset@main\fi
      }{%
        \setmainfont[\neoschool@mainfaceoptions, Scale=\neoschool@mainfacescale]{\neoschool@mainface}%
      }
      \IfStrEq{\mathface}{}{%
        \ifx\neo@fontset\@empty\ifneo@mathastext\else\ifneoschool@mathletters\else
          \SetSymbolFont{operators}{normal}{\encodingdefault}{\rmdefault}{m}{n}%
          \SetSymbolFont{operators}{bold}{\encodingdefault}{\rmdefault}{b}{n}%
        \fi\fi\fi
      }{}
      \ifneoschool@mathletters
        \ifneo@mathastext
          \ClassWarningNoLine{neoschool}{Option 'mathletters' ignored with 'mathastext'}%
        \else
          \def\neo@tempa{main}%
          \ifx\neo@fontset\@empty\neo@applymathletters\else
            \ifx\neoschool@mathletters\neo@tempa
              \ifx\neoschool@mainface\@empty\else\neo@applymathletters\fi
            \else\neo@applymathletters\fi
          \fi
        \fi
      \fi

      \IfStrEq{\sansface}{}{%
        \ifx\neo@fontset\@empty\setsansfont[Scale=0.94]{TeX Gyre Heros}\else\neo@fontset@sans\fi
      }{%
        \setsansfont[\neoschool@sansfaceoptions, Scale=\neoschool@sansfacescale]{\neoschool@sansface}%
      }

      \IfStrEq{\monoface}{}{%
        \setmonofont[Scale=1.05, Ligatures={ResetAll,TeXOff}, BoldFont=lmmonolt10-bold.otf, BoldItalicFont=lmmonolt10-boldoblique.otf]{Latin Modern Mono}%
      }{%
        \setmonofont[Ligatures={ResetAll,TeXOff}, \neoschool@monofaceoptions, Scale=\neoschool@monofacescale]{\neoschool@monoface}%
      }

    \fi
  \fi
\fi

\@ifpackageloaded{unicode-math}{\disable@package@load{amssymb}{}\disable@package@load{amsfonts}{}}{%
  \ifPDFTeX\else\disable@package@load{unicode-math}{\ClassWarning{neoschool}{Package unicode-math ignored: math fonts are chosen with the mathface option}}\fi}
\AddToHook{package/amsthm/before}{\let\openbox\relax\let\neo@proof\proof\let\neo@endproof\endproof\let\proof\relax\let\endproof\relax}
\AddToHook{package/amsthm/after}{\let\proof\neo@proof\let\endproof\neo@endproof}

% SemiBold Weight
\ifPDFTeX
  \providecommand{\sbseries}{\bfseries}
  \providecommand{\textsb}[1]{\textbf{#1}}
\else
  \AtEndPreamble{%
    \ifneoschool@semibold
      \newcommand{\neo@configure@semibold}[2]{%
        \ifx#1\@empty\else
          \def\neo@temp@extra{}%
          \IfFontExistsTF{#1 SemiBold}{%
            \edef\neo@temp@extra{FontFace={sb}{n}{* SemiBold}}%
          }{}%
          \IfFontExistsTF{#1 SemiBold Italic}{%
            \ifx\neo@temp@extra\@empty\else\appto\neo@temp@extra{,}\fi
            \appto\neo@temp@extra{FontFace={sb}{it}{* SemiBold Italic}}%
          }{}%
          \ifx\neo@temp@extra\@empty\else
            \def\neo@temp@lig{}%
            \ifstrequal{#2}{mono}{\def\neo@temp@lig{Ligatures={ResetAll,TeXOff},}}{}%
            \edef\neo@tempa{\expandafter\noexpand\csname set#2font\endcsname{\unexpanded\expandafter{#1}}[\unexpanded\expandafter{\neo@temp@lig}\unexpanded\expandafter\expandafter\expandafter{\csname neoschool@#2faceoptions\endcsname},Scale=\csname neoschool@#2facescale\endcsname,\unexpanded\expandafter{\neo@temp@extra}]}%
            \neo@tempa
          \fi
        \fi
      }

      \neo@configure@semibold{\neoschool@mainface}{main}
      \neo@configure@semibold{\neoschool@sansface}{sans}
      \neo@configure@semibold{\neoschool@monoface}{mono}
    \fi
  }

  \def\sb@code{sb}

  \DeclareRobustCommand\sbseries{%
    \not@math@alphabet\sbseries\relax
    \begingroup
    \def\@font@warning##1{}%
    \fontseries{sb}\selectfont
    \xdef\neo@sb@temp{\f@series}%
    \endgroup
    \ifx\neo@sb@temp\sb@code
      \fontseries{sb}\selectfont
    \else
      \fontseries\bfdefault\selectfont
    \fi
  }

  \DeclareTextFontCommand{\textsb}{\sbseries}
\fi

\ifneo@sfbody
  \renewcommand{\familydefault}{\sfdefault}
\fi

%% ==============================================================================
%% Monospace Text
%% ==============================================================================

\newcommand{\neo@ifmathmode}[2]{%
  \relax\ifmmode #1\else #2\fi
}

\AtEndOfClass{%
  \ifneoschool@inlinecodebox
    \AtBeginDocument{%
      \ifneo@darktheme
        \colorlet{inlineCodeBg}{verbColor!20!white!10!black}%
        \colorlet{inlineCodeFrame}{verbColor!50!white}%
      \else
        \colorlet{inlineCodeBg}{verbColor!6!white}%
        \colorlet{inlineCodeFrame}{verbColor!30!white}%
      \fi
    }%
    \tcbset{
      neoinlinecodestyle/.style={
        enhanced,
        arc=2pt,
        boxsep=0pt,
        top=2pt,
        bottom=2.5pt,
        left=3pt,
        right=3pt,
        colback=inlineCodeBg,
        colframe=inlineCodeFrame,
        boxrule=\neo@thinrule,
        nobeforeafter,
        tcbox raise base,
      }
    }
    \renewrobustcmd{\texttt}[1]{%
      \neo@ifmathmode{%
        \mathtt{#1}%
      }{%
        \tcbox[neoinlinecodestyle]{%
          \ttfamily
          \hyphenchar\font=`\-%
          \color{verbColor}\scalebox{0.92}{\neo@safetitle{#1}}%
        }%
      }%
    }%
  \else
    \renewrobustcmd{\texttt}[1]{%
      \neo@ifmathmode{%
        \mathtt{#1}%
      }{%
        \begingroup
        \ttfamily
        \ifneoschool@tthyphenation\hyphenchar\font=`\-\neo@tthyphenstrue\else\hyphenchar\font=\m@ne\language\l@nohyphenation\neo@tthyphensfalse\fi
        \color{verbColor}\neo@ttbreaks{#1}%
        \endgroup
      }%
    }%
  \fi
}

\newcommand{\neo@plaintt}{\renewcommand{\texttt}[1]{\neo@ifmathmode{\mathtt{##1}}{{\ttfamily ##1}}}}
\tcbset{every box/.append style={before title={\neo@plaintt}}}

%% ==============================================================================
%% KOMA-Script Typography
%% ==============================================================================

% Title Content Formatter
\newcommand{\neo@title@style}{%
  \csname\neoschool@headweight\endcsname\csname\neoschool@headfamily\endcsname\csname\neoschool@headshape\endcsname%
}
\newcommand{\neo@sectionfont@style}{%
  \csname\neoschool@sectionweight\endcsname\csname\neoschool@sectionfamily\endcsname
  \ifx\neoschool@sectionshape\@empty\else\csname\neoschool@sectionshape\endcsname\fi
}
\newcommand{\neo@thmfont@style}{%
  \csname\neoschool@thmweight\endcsname\csname\neoschool@thmfamily\endcsname\csname\neoschool@thmshape\endcsname
}
\newcommand{\neo@exfont@style}{%
  \csname\neoschool@exweight\endcsname\csname\neoschool@exfamily\endcsname\csname\neoschool@exshape\endcsname
}
\newcommand{\neo@adfont@style}{%
  \csname\neoschool@adweight\endcsname\csname\neoschool@adfamily\endcsname\csname\neoschool@adshape\endcsname
}
\let\neo@boxhead@style\relax
\newcommand{\neo@title@other@style}{%
  \csname\neoschool@headweight\endcsname\csname\neoschool@headfamily\endcsname%
}
\newcommand{\neo@main@title@@style}{%
  \csname\neoschool@titleweight\endcsname\csname\neoschool@titlefamily\endcsname%
}

\newcommand{\hugeHuge}{\scalefont{2.47}\selectfont}
\newcommand{\LARGEhuge}{\scalefont{2.06}\selectfont}
\newcommand{\LargeLARGEplus}{\scalefont{1.77}\selectfont}
\newcommand{\LargeLARGE}{\scalefont{1.66}\selectfont}
\newcommand{\LargeLARGEminus}{\scalefont{1.55}\selectfont}
\newcommand{\largeLarge}{\scalefont{1.32}\selectfont}
\newcommand{\normalsizelarge}{\scalefont{1.1}\selectfont}
\newcommand{\smallnormalsize}{\scalefont{0.95}\selectfont}
\newcommand{\footnotesizesmall}{\scalefont{0.82}\selectfont}
\newcommand{\scriptsizefootnotesize}{\scalefont{0.77}\selectfont}
\newcommand{\tinyscriptsize}{\scalefont{0.66}\selectfont}

\ifcsname\neoschool@titlesize\endcsname\else
  \ClassWarningNoLine{neoschool}{Unknown titlesize value '\neoschool@titlesize'. Using 'LargeLARGEminus'}%
  \def\neoschool@titlesize{LargeLARGEminus}%
\fi

\setkomafont{disposition}{\mdseries}

\setkomafont{subject}{%
  \normalfont\sffamily
  \fontsize{9}{11}\selectfont
  \color{subjectColor}%
}

\setkomafont{title}{%
  \neo@main@title@@style
  \csname\neoschool@titlesize\endcsname
  \color{titleColor}%
}

\setkomafont{subtitle}{%
  \normalfont\sffamily\mdseries
  \fontsize{12}{16}\selectfont
  \color{subtitleColor}%
}

\setkomafont{author}{%
  \normalfont\rmfamily\scshape
  \fontsize{10}{13}\selectfont
  \color{authorColor}%
}

\setkomafont{section}{%
  \neo@sectionfont@style
  \Large
  \color{sectionColor}%
}

\setkomafont{subsection}{%
  \neo@sectionfont@style
  \large
  \color{subsectionColor}%
}

\setkomafont{subsubsection}{%
  \rmfamily
  \bfseries
  \itshape
  \color{subsubsectionColor}%
}

\setkomafont{pagenumber}{\small\csname\neoschool@headfootfamily\endcsname\color{\neoschool@headfootcolor}}
\setkomafont{part}{\neo@title@style\color{titleColor}\huge}
\setkomafont{partnumber}{\neo@title@style\color{titleColor}\LARGE}

\setkomafont{sectionentry}{\sffamily\bfseries\color{tocSectionColor}}
\setkomafont{sectionentrypagenumber}{\sffamily\bfseries\color{tocSectionColor}}

% Part entries in TOC: colored rule separator
\newcommand{\neo@toc@partrule}{%
  \nopagebreak[4]\vskip2pt
  \nopagebreak[4]%
  {\color{tocTitleColor!40}\hrule height 0.6pt}%
  \nopagebreak[4]\vskip4pt\nopagebreak[4]%
}

% Skip KOMA TOC entry styling when etoc will take over (compacttoc/twocoltoc)
\ifneo@compacttoc\else
\ifneo@twocoltoc\else
  \DeclareTOCStyleEntry[%
    beforeskip=2.5em plus 2pt,
    entryformat=\neo@title@style\Large\color{tocTitleColor},
    entrynumberformat=\neo@title@style\Large\color{tocTitleColor},
    pagenumberformat=\neo@title@style\large\color{tocTitleColor},
    linefill=\hfill,
    onstarthigherlevel=\nopagebreak\aftergroup\nopagebreak,
    onstartlowerlevel=\nopagebreak\aftergroup\nopagebreak,
    onstartsamelevel=\nopagebreak\aftergroup\nopagebreak
  ]{tocline}{part}

  \DeclareTOCStyleEntry[linefill=\textcolor{tocSectionColor}{\TOCLineLeaderFill}]{section}{section}
  \DeclareTOCStyleEntry[%
    linefill=\textcolor{tocSubsectionColor}{\TOCLineLeaderFill},
    entryformat=\sffamily\mdseries\color{tocSubsectionColor},
    pagenumberformat=\sffamily\mdseries\color{tocSubsectionColor}
  ]{subsection}{subsection}

  % Add rule after part TOC entries
  \let\neo@orig@l@part\l@part
  \renewcommand*{\l@part}[2]{%
    \neo@orig@l@part{##1}{##2}%
    \neo@toc@partrule
  }
\fi
\fi

% Page number format
\renewcommand*\pagemark{%
  {\usekomafont{pagenumber}
    \csname neo@pagename\endcsname\nobreakspace\thepage\nobreakspace/\nobreakspace
    {\hypersetup{linkcolor=\neoschool@headfootcolor}\pageref{LastPage}}
  }
}

\newpairofpagestyles{firstpage}{%
  \ihead{}\chead{}\ohead{}%
  \innerfoot{\@date}\cfoot{}\ofoot{\pagemark}%
}

\newpairofpagestyles{customfirstpage}{%
  \ihead{}\chead{}\ohead{}%
  \innerfoot{\@date}\cfoot{\textsc{\@author}}\ofoot{\pagemark}%
}

% Short title support
\newcommand{\shorttitle}[1]{\gdef\@shorttitle{#1}}
\let\@shorttitle\@empty

\newcommand{\neo@displaytitle}{\neo@displaytitle@cached}
\let\neo@displaytitle@cached\@empty

\ExplSyntaxOn
\seq_new:N \l__neo_title_seq
\tl_new:N \l__neo_title_tl
\int_new:N \l__neo_title_int
\cs_new_protected:Npn \neo@truncatetitle
  {
    \seq_set_split:NnV \l__neo_title_seq { ~ } \@title
    \tl_clear:N \l__neo_title_tl
    \int_zero:N \l__neo_title_int
    \seq_map_inline:Nn \l__neo_title_seq
      {
        \int_add:Nn \l__neo_title_int { \tl_count:n {##1} + 1 }
        \int_compare:nNnTF { \l__neo_title_int } > { 85 }
          { \seq_map_break: }
          { \tl_put_right:Nn \l__neo_title_tl { ##1 ~ } }
      }
    \tl_if_empty:NTF \l__neo_title_tl
      { \cs_gset_eq:NN \neo@displaytitle@cached \@title }
      { \protected@xdef \neo@displaytitle@cached { \exp_not:V \l__neo_title_tl \exp_not:N \ldots } }
  }
\ExplSyntaxOff

\AtBeginDocument{%
  \ifx\@shorttitle\@empty
    \begingroup
      \edef\neo@title@detok{\detokenize\expandafter{\@title}}%
      \StrLen{\neo@title@detok}[\neo@title@len]%
      \ifnum\neo@title@len>85\relax
        \IfSubStr{\neo@title@detok}{\@backslashchar}{%
          \ClassWarning{neoschool}{%
            The document title is longer than 85 characters and contains
            macros that prevent automatic truncation.\MessageBreak
            Provide a shorter version with \protect\shorttitle{...}%
          }%
          \global\let\neo@displaytitle@cached\@title
        }{%
          \ifPDFTeX
            \neo@truncatetitle
          \else
            \StrLeft{\@title}{85}[\neo@title@trunc]%
            \protected@xdef\neo@displaytitle@cached{\neo@title@trunc\noexpand\ldots}%
          \fi
        }%
      \else
        \global\let\neo@displaytitle@cached\@title
      \fi
    \endgroup
  \else
    \global\let\neo@displaytitle@cached\@shorttitle
  \fi
}

\newpairofpagestyles{followingpages}{%
  \ihead{}\chead{}\ohead{}%
  \innerfoot{\neo@displaytitle}\cfoot{}\ofoot{\pagemark}%
}

\newpairofpagestyles{pagenum}{%
  \ihead{}\chead{}\ohead{}%
  \innerfoot{}\cfoot{\pagemark}\ofoot{}%
}

% Header font configuration
\renewcommand*{\headfont}{%
  \small
  \csname\neoschool@headfootfamily\endcsname
  \color{\neoschool@headfootcolor}
}

%% ==============================================================================
%% Title Styles and Setting
%% ==============================================================================

\newcommand{\neo@checktitlelayout}{%
  \let\neo@layoutexec\neo@createfulltitle
  \IfStrEq{\neoschool@titlelayout}{exam}{\let\neo@layoutexec\neo@examcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{eval}{\let\neo@layoutexec\neo@evalcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{evalicons}{\let\neo@layoutexec\neo@evaliconscontent}{}%
  \IfStrEq{\neoschool@titlelayout}{evalgrade}{\let\neo@layoutexec\neo@evalgradecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{evaliconsgrade}{\let\neo@layoutexec\neo@evaliconsgradecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{titlebox}{\let\neo@layoutexec\neo@titleboxcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{tighttitle}{\let\neo@layoutexec\neo@tighttitlecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{onlytitle}{\let\neo@layoutexec\neo@onlytitle@content}{}%
  \IfStrEq{\neoschool@titlelayout}{bubbles}{\let\neo@layoutexec\neo@bubblescontent}{}%
  \IfStrEq{\neoschool@titlelayout}{particles}{\let\neo@layoutexec\neo@particlescontent}{}%
  \IfStrEq{\neoschool@titlelayout}{confetti}{\let\neo@layoutexec\neo@confetticontent}{}%
  \IfStrEq{\neoschool@titlelayout}{minimal}{\let\neo@layoutexec\neo@minimalcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{bar}{\let\neo@layoutexec\neo@barcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{spine}{\let\neo@layoutexec\neo@spinecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{wave}{\let\neo@layoutexec\neo@wavecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{blocks}{\let\neo@layoutexec\neo@blockscontent}{}%
  \IfStrEq{\neoschool@titlelayout}{stream}{\let\neo@layoutexec\neo@streamcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{brush}{\let\neo@layoutexec\neo@brushcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{flow}{\let\neo@layoutexec\neo@flowcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{magazine}{\let\neo@layoutexec\neo@magazinecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{tech}{\let\neo@layoutexec\neo@techcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{book}{\let\neo@layoutexec\neo@bookcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{notion}{\let\neo@layoutexec\neo@notioncontent}{}%
  \IfStrEq{\neoschool@titlelayout}{simplenotion}{\let\neo@layoutexec\neo@simplenotioncontent}{}%
  \IfStrEq{\neoschool@titlelayout}{bristol}{\let\neo@layoutexec\neo@bristolcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{amslike}{\let\neo@layoutexec\neo@amslikecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{mirlike}{\let\neo@layoutexec\neo@mirlikecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{physlike}{\let\neo@layoutexec\neo@physlikecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{springerlike}{\let\neo@layoutexec\neo@springerlikecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{springerrule}{\let\neo@layoutexec\neo@springerrulecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{ieeelike}{\let\neo@layoutexec\neo@ieeelikecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{acmlike}{\let\neo@layoutexec\neo@acmlikecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{band}{\let\neo@layoutexec\neo@bandcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{memphis}{\let\neo@layoutexec\neo@memphiscontent}{}%
  \IfStrEq{\neoschool@titlelayout}{circles}{\let\neo@layoutexec\neo@circlescontent}{}%
  \IfStrEq{\neoschool@titlelayout}{bauhaus}{\let\neo@layoutexec\neo@bauhauscontent}{}%
  \IfStrEq{\neoschool@titlelayout}{grid}{\let\neo@layoutexec\neo@gridcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{geometric}{\let\neo@layoutexec\neo@geometriccontent}{}%
  \IfStrEq{\neoschool@titlelayout}{banner}{\let\neo@layoutexec\neo@bannercontent}{}%
  \IfStrEq{\neoschool@titlelayout}{cloud}{\let\neo@layoutexec\neo@cloudcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{champagne}{\let\neo@layoutexec\neo@champagnecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{mockexam}{\let\neo@layoutexec\neo@mockexamcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{shortexam}{\let\neo@layoutexec\neo@shortexamcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{shorteval}{\let\neo@layoutexec\neo@shortevalcontent}{}%
  \IfStrEq{\neoschool@titlelayout}{shorttitle}{\let\neo@layoutexec\neo@shorttitlecontent}{}%
  \IfStrEq{\neoschool@titlelayout}{shortlesson}{\let\neo@layoutexec\neo@shortlessoncontent}{}%
  \global\let\neo@saved@rnd\pgfmath@rnd@z
  \neo@layoutexec
  \global\let\pgfmath@rnd@z\neo@saved@rnd
}

\newcommand{\neo@printtitle}{%
  \begingroup
    \csname\neoschool@titlefamily\endcsname
    \csname\neoschool@titleweight\endcsname
    \csname\neoschool@titleshape\endcsname
    \color{titleColor}%
    \usekomafont{title}{\@title}
  \endgroup
}

% Inspired layouts
\newcommand{\neo@inspired@author}[1]{%
  \ifx\@author\@empty\else{#1\@author\par}\fi
}
\newcommand{\neo@amslikecontent}{%
  \thispagestyle{customfirstpage}%
  \begin{center}
    {\normalfont\bfseries\large\MakeUppercase{\@title}\par}
    \ifx\@subtitle\@empty\else\medskip{\normalfont\normalsize\@subtitle\par}\fi
    \bigskip
    \neo@inspired@author{\normalfont\scshape\small}
    \ifx\@date\@empty\else\smallskip{\normalfont\small\@date\par}\fi
  \end{center}
  \vspace{1.5\baselineskip}
}
\newcommand{\neo@mirlikecontent}{%
  \thispagestyle{customfirstpage}%
  \begin{center}
    \ifx\@subject\@empty\else{\normalfont\small\textls[180]{\MakeUppercase{\@subject}}\par}\medskip\fi
    {\normalfont\bfseries\LARGE\@title\par}
    \ifx\@subtitle\@empty\else\medskip{\normalfont\itshape\large\@subtitle\par}\fi
    \medskip
    \rule{2.5cm}{0.4pt}\par
    \medskip
    \neo@inspired@author{\normalfont\small}
  \end{center}
  \vspace{1.5\baselineskip}
}
\newcommand{\neo@physlikecontent}{%
  \thispagestyle{customfirstpage}%
  \begin{center}
    {\normalfont\bfseries\large\@title\par}
    \ifx\@subtitle\@empty\else\smallskip{\normalfont\normalsize\@subtitle\par}\fi
    \medskip
    \neo@inspired@author{\normalfont\normalsize}
    \ifx\@subject\@empty\else{\normalfont\itshape\small\@subject\par}\fi
    \ifx\@date\@empty\else\smallskip{\normalfont\small(\@date)\par}\fi
  \end{center}
  \vspace{1.5\baselineskip}
}
\newcommand{\neo@springerlikecontent}{%
  \thispagestyle{customfirstpage}%
  \begingroup
    \setlength{\fboxsep}{0pt}%
    \noindent\colorbox{\neoschool@globalcolor!10!backgroundColor}{%
      \parbox{\linewidth}{%
        \vspace*{14pt}%
        \leftskip=14pt \rightskip=14pt plus 1fil \parindent=0pt
        \ifx\@subject\@empty\else{\normalfont\sffamily\small\@subject\par}\smallskip\fi
        {\normalfont\sffamily\bfseries\LARGE\@title\par}
        \ifx\@subtitle\@empty\else\medskip{\normalfont\sffamily\large\@subtitle\par}\fi
        \ifx\@author\@empty\else\medskip{\normalfont\itshape\@author\par}\fi
        \vspace*{14pt}%
      }%
    }\par
  \endgroup
  \vspace{1.5\baselineskip}
}
\newcommand{\neo@springerrulecontent}{%
  \thispagestyle{customfirstpage}%
  \begingroup\raggedright
    \ifx\@subject\@empty\else{\normalfont\sffamily\small\@subject\par}\smallskip\fi
    {\normalfont\sffamily\bfseries\LARGE\@title\par}
    \ifx\@subtitle\@empty\else\medskip{\normalfont\sffamily\large\@subtitle\par}\fi
    \medskip
    \neo@inspired@author{\normalfont\itshape}
    \smallskip
    \noindent\rule{\linewidth}{0.4pt}\par
  \endgroup
  \vspace{1.5\baselineskip}
}
\newcommand{\neo@ieeelikecontent}{%
  \thispagestyle{customfirstpage}%
  \begin{center}
    {\normalfont\fontsize{22}{26}\selectfont\@title\par}
    \ifx\@subtitle\@empty\else\smallskip{\normalfont\large\@subtitle\par}\fi
    \medskip
    \neo@inspired@author{\normalfont\large}
    \ifx\@subject\@empty\else{\normalfont\itshape\small\@subject\par}\fi
  \end{center}
  \vspace{\baselineskip}
}
\newcommand{\neo@acmlikecontent}{%
  \thispagestyle{customfirstpage}%
  \begingroup\raggedright
    {\normalfont\sffamily\bfseries\Large\@title\par}
    \ifx\@subtitle\@empty\else\smallskip{\normalfont\sffamily\large\@subtitle\par}\fi
    \medskip
    \neo@inspired@author{\normalfont\sffamily\large}
    \ifx\@subject\@empty\else{\normalfont\sffamily\small\@subject\par}\fi
  \endgroup
  \vspace{\baselineskip}
}

% Core definitions and lengths
\def\neo@left{left}
\def\neo@right{right}
\def\neo@center{center}
\newcommand*{\neo@pagex}[1]{\the\dimexpr\paperwidth*#1/2100\relax}

\newlength{\neo@titlespacing}
\setlength{\neo@titlespacing}{\baselineskip}

% Define tight spacing commands
\newcommand{\neo@tightspacing}{%
  \setlength{\topsep}{0pt}
  \setlength{\parskip}{0pt}
}

% Redefine center, flushright, and flushleft environments with tight spacing
\let\neo@oldcenter\center
\let\neo@oldendcenter\endcenter

\newenvironment{neo@titlecenter}{%
  \neo@tightspacing
  \neo@oldcenter
}{%
  \neo@oldendcenter
}

\let\neo@oldflushright\flushright
\let\neo@oldendflushright\endflushright
\newenvironment{neo@flushright}{%
  \neo@tightspacing
  \neo@oldflushright
}{%
  \neo@oldendflushright
}

\let\neo@oldflushleft\flushleft
\let\neo@oldendflushleft\endflushleft
\newenvironment{neo@flushleft}{%
  \neo@tightspacing
  \neo@oldflushleft
}{%
  \neo@oldendflushleft
}

% Title decoration handler
\ExplSyntaxOn
\newcommand{\neo@titledecoration}{%
  \str_case:VnF \neoschool@titledecor
  {
    {rule} { \vspace{2\neo@titlespacing}%
      {\color{structuralColor}\rule{0.33\linewidth}{\neo@decorativerule}}}
    {midrule} { \vspace{2\neo@titlespacing}%
      {\color{structuralColor}\rule{0.5\linewidth}{\neo@decorativerule}}}
    {fullrule} { \vspace{2\neo@titlespacing}%
      {\color{structuralColor}\rule{0.66\linewidth}{\neo@decorativerule}}}
    {ornament} { \vspace{2\neo@titlespacing}%
      {\color{structuralColor}\scalebox{2}[1.5]{\adforn{21}\,\adforn{11}\,\adforn{49}}}}
    {none} { }
  }
  { \ClassWarning{neoschool}{Unknown~titledecor~style~'\neoschool@titledecor'.~Using~none.} }
}
\ExplSyntaxOff

\newlength{\neo@sep@subject}   \setlength{\neo@sep@subject}{6pt}
\newlength{\neo@sep@subtitle}  \setlength{\neo@sep@subtitle}{8pt}
\newlength{\neo@sep@author}    \setlength{\neo@sep@author}{10pt}
\newlength{\neo@sep@after}     \if@twocolumn\setlength{\neo@sep@after}{2em}\else\setlength{\neo@sep@after}{1em}\fi

\let\@subject\@empty
\let\@subtitle\@empty
\let\@author\@empty

\newcommand{\neo@createfulltitle}{%
  \begingroup
    \ifx\neoschool@titlealign\neo@left
      \raggedright
    \else
      \ifx\neoschool@titlealign\neo@right\raggedleft\else\centering\fi
    \fi

    \ifx\@subject\empty\else
      {\usekomafont{subject}\MakeUppercase{\textls[50]{\@subject}}\par}
      \vspace{\neo@sep@subject}
    \fi

    {\usekomafont{title}\@title\par}

    \ifx\@subtitle\empty\else
      \vspace{\neo@sep@subtitle}
      {\usekomafont{subtitle}\@subtitle\par}
    \fi

    \ifx\@author\@empty\else
      \vspace{\neo@sep@author}
      {\usekomafont{author}\@author\par}
    \fi

    \neo@titledecoration

    \vspace{\neo@sep@after}
  \endgroup
}

% Only title creation (no author, subject, etc.)
\newcommand{\neo@createonlytitle}{%
  \usekomafont{title}{\@title}\par
  \neo@titledecoration%
}

\renewcommand\maketitle{%
  \thispagestyle{firstpage}
  \ifx\@subject\@empty\else\hypersetup{pdfsubject={\@subject}}\fi
  \IfStrEq{\neoschool@titlelayout}{onlytitle}{%
    \neo@handleonlytitle
    {\neo@onlytitle@content}
    {\neo@onlytitle@content}
  }{%
    \begingroup
    \edef\neo@tempval{\neoschool@titlelayout}%
    \@tempswafalse
    \@for\neo@tempitem:=default,titlebox,tighttitle,shorttitle\do{\ifx\neo@tempitem\neo@tempval\@tempswatrue\fi}%
    \if@tempswa\else\let\neoschool@titlealign\neo@center\fi
    \if@twocolumn
      \twocolumn[{%
        \begingroup
        \ifx\neoschool@titlealign\neo@left
          \begin{neo@flushleft}
            \neo@checktitlelayout
          \end{neo@flushleft}
        \else
          \ifx\neoschool@titlealign\neo@right
            \noindent\raggedleft
            \neo@checktitlelayout
            \par
          \else
            \begin{neo@titlecenter}
              \neo@checktitlelayout
            \end{neo@titlecenter}
          \fi
        \fi
        \endgroup
      }]
    \else
      \begingroup
      \ifx\neoschool@titlealign\neo@left
        \begin{neo@flushleft}
          \noindent\neo@checktitlelayout
        \end{neo@flushleft}
      \else
        \ifx\neoschool@titlealign\neo@right
          \noindent\raggedleft
          \neo@checktitlelayout
          \par
        \else
          \begin{neo@titlecenter}
            \neo@checktitlelayout
          \end{neo@titlecenter}
        \fi
      \fi
      \endgroup
    \fi
    \endgroup
  }%
}

\newcommand{\neo@setwrap}[2]{%
  \setbox\z@\hbox{#2}%
  \ifdim\wd\z@>\dimexpr\textwidth-2ex\relax
    \tikzset{#1/.style={text width=\dimexpr\textwidth-2ex\relax, align=\neo@titletextalign, execute at begin node={\hyphenpenalty\@M\exhyphenpenalty\@M}}}%
  \else
    \tikzset{#1/.style={}}%
  \fi
}
\newcommand{\neo@setwraps}{%
  \neo@setwrap{neo@wraptitle}{\csname\neoschool@titlefamily\endcsname\csname\neoschool@titleweight\endcsname\csname\neoschool@titleshape\endcsname\usekomafont{title}\@title}%
  \neo@setwrap{neo@wrapsubtitle}{\usekomafont{subtitle}\@subtitle}%
  \neo@setwrap{neo@wrapsubject}{\usekomafont{subject}\@subject}%
}

% Title box
\newcommand{\neo@titleboxcontent}{%
  \thispagestyle{customfirstpage}
  \newcommand{\neo@fancycolor}{exerciseColor!10!backgroundColor}

  \pgfdeclarelayer{background}
  \pgfsetlayers{background,main}

  \neo@setwraps
  \begin{tikzpicture}[remember picture,overlay]
    \def\titleanchor{west}
    \def\neo@titletextalign{left}
    \def\titlebasepos{current page text area.north west}
    \def\titlexshift{1ex}
    \def\subtitlepos{title.south west}
    \def\subjectpos{title.north west}

    \ifx\neoschool@titlealign\neo@center
      \def\titleanchor{center}
      \def\neo@titletextalign{center}
      \def\titlebasepos{current page text area.north}
      \def\titlexshift{0ex}
      \def\subtitlepos{title.south}
      \def\subjectpos{title.north}
    \fi
    \ifx\neoschool@titlealign\neo@right
      \def\titleanchor{east}
      \def\neo@titletextalign{right}
      \def\titlebasepos{current page text area.north east}
      \def\titlexshift{-1ex}
      \def\subtitlepos{title.south east}
      \def\subjectpos{title.north east}
    \fi
    \ifx\@subject\@empty
      \def\startYshift{\dimexpr-\baselineskip\relax}
    \else
      \def\startYshift{\dimexpr-3\baselineskip\relax}
    \fi

    \node[anchor=\titleanchor, neo@wraptitle] (title) at
    ($([xshift=\titlexshift,yshift=\startYshift]\titlebasepos)$)
    {\csname\neoschool@titlefamily\endcsname
      \csname\neoschool@titleweight\endcsname
      \csname\neoschool@titleshape\endcsname
      \color{titleColor}\usekomafont{title}\@title};

    \ifx\@subtitle\@empty\else
      \node[below=5mm of \subtitlepos, anchor=\titleanchor, neo@wrapsubtitle] (subtitle)
      {\usekomafont{subtitle}\@subtitle};
    \fi

    \ifx\@subject\@empty\else
      \node[above=5mm of \subjectpos, anchor=\titleanchor, neo@wrapsubject] (subject)
      {\usekomafont{subject}\@subject};
    \fi

    \coordinate (boxtop) at (title.north);
    \coordinate (boxbottom) at (title.south);
    \ifx\@subject\@empty\else
      \coordinate (boxtop) at (subject.north);
    \fi
    \ifx\@subtitle\@empty\else
      \coordinate (boxbottom) at (subtitle.south);
    \fi

    \begin{pgfonlayer}{background}
      \def\boxpaddingH{0cm}
      \def\boxpaddingTop{0.5cm}
      \def\boxpaddingBottom{0.5cm}
      \fill[\neo@fancycolor]
      ($(current page text area.north west)!(boxtop)!(current page text area.south west) + (-\boxpaddingH, \boxpaddingTop)$) -|
      ($(current page text area.north east)!(boxtop)!(current page text area.south east) + (\boxpaddingH, \boxpaddingTop)$) |-
      ($(current page text area.north east)!(boxbottom)!(current page text area.south east) + (\boxpaddingH, -\boxpaddingBottom)$) -|
      ($(current page text area.north west)!(boxbottom)!(current page text area.south west) + (-\boxpaddingH, -\boxpaddingBottom)$) |- cycle;
    \end{pgfonlayer}
  \end{tikzpicture}

  \ifx\@subject\@empty
    \ifx\@subtitle\@empty
      \def\vspaceadjust{-1cm}
    \else
      \def\vspaceadjust{-0.15cm}
    \fi
  \else
    \ifx\@subtitle\@empty
      \def\vspaceadjust{-0.25cm}
    \else
      \def\vspaceadjust{0.5cm}
    \fi
  \fi
  \neo@top@compensate%
  \if@twocolumn\vspace*{\dimexpr10\baselineskip+\oddsidemargin+\vspaceadjust\relax}\par%
  \else\vspace*{\dimexpr7.5\baselineskip+\oddsidemargin+\vspaceadjust\relax}\par\fi
}


% Tight Title

\newlength{\neoTitleHeight}
\newcommand{\neo@tighttitlecontent}{%
  \thispagestyle{customfirstpage}
  \neo@setwraps
  \begin{tikzpicture}[remember picture, overlay]
    \def\titleanchor{west}
    \def\neo@titletextalign{left}
    \def\titlebasepos{current page text area.north west}
    \def\titlexshift{-1ex}
    \def\subtitlepos{title.south west}
    \def\subjectpos{title.north west}

    \ifx\neoschool@titlealign\neo@center
      \def\titleanchor{center}
      \def\neo@titletextalign{center}
      \def\titlebasepos{current page text area.north}
      \def\titlexshift{0ex}
      \def\subtitlepos{title.south}
      \def\subjectpos{title.north}
    \fi
    \ifx\neoschool@titlealign\neo@right
      \def\titleanchor{east}
      \def\neo@titletextalign{right}
      \def\titlebasepos{current page text area.north east}
      \def\titlexshift{1ex}
      \def\subtitlepos{title.south east}
      \def\subjectpos{title.north east}
    \fi

    \ifx\@subject\@empty
      \def\startYshift{0cm}
    \else
      \def\startYshift{-0.5cm}
    \fi

    \node[anchor=\titleanchor, neo@wraptitle] (title) at
    ($([xshift=\titlexshift,yshift=\startYshift]\titlebasepos)$)
    {%
      \csname\neoschool@titlefamily\endcsname
      \csname\neoschool@titleweight\endcsname
      \csname\neoschool@titleshape\endcsname
      \color{titleColor}\usekomafont{title}{\@title}%
    };

    \ifx\@subject\@empty\else
      \node[above=4.5mm of \subjectpos, anchor=\titleanchor, neo@wrapsubject] (subject)
      {\usekomafont{subject}\@subject};
    \fi

    \ifx\@subtitle\@empty
      \coordinate (lowestPoint) at (title.south);
    \else
      \node[below=5mm of \subtitlepos, anchor=\titleanchor, neo@wrapsubtitle] (subtitle)
      {\usekomafont{subtitle}\@subtitle};
      \coordinate (lowestPoint) at (subtitle.south);
    \fi

    \path let \p1 = (current page text area.north),
    \p2 = (lowestPoint)
    in \pgfextra{
      \global\neoTitleHeight=\dimexpr\y1-\y2\relax
    };
  \end{tikzpicture}

  \neo@top@compensate%

  \def\neo@geo@offset{1in + \topmargin + \headheight + \headsep}

  \if@twocolumn
    \vspace*{\dimexpr\neoTitleHeight - 4\baselineskip + \neo@geo@offset + 1cm\relax}
  \else
    \vspace*{\dimexpr\neoTitleHeight - 4\baselineskip + \neo@geo@offset + 0.35cm\relax}
  \fi
  \par
}

\newcommand{\neo@handleonlytitle}[2]{%
  \if@twocolumn
    \AfterEndPreamble{%
      \twocolumn[{#1\vspace*{.6in}\par}]
    }
  \else
    \AtBeginDocument{%
      #2\vspace*{0.4in}\par
    }
  \fi
  \thispagestyle{firstpage}
}

\newcommand{\neo@onlytitle@content}{%
  \IfStrEq{\neoschool@titlealign}{center}{%
    \begin{neo@titlecenter}\neo@createonlytitle\end{neo@titlecenter}%
  }{%
    \IfStrEq{\neoschool@titlealign}{right}{%
      \begin{neo@flushright}\neo@createonlytitle\end{neo@flushright}%
    }{%
      \begin{neo@flushleft}\neo@createonlytitle\end{neo@flushleft}%
    }%
  }%
}

%% ==============================================================================
%% Table of Contents
%% ==============================================================================

\addto\captionsfrench{\renewcommand{\contentsname}{Sommaire}}

\ifneo@french
  \AtBeginDocument{%
    \ifundef{\FBtocpartname}{}{%
      \ifcsdef{ifFBTocPartNameFull}{%
        \ifbool{FBTocPartNameFull}{%
          \renewcommand*{\addparttocentry}[2]{\addtocentrydefault{part}{}{\FBtocpartname{#1}\quad #2}}%
        }{}%
      }{}%
    }%
  }
\fi

\ifneo@monotoc
  \colorlet{tocTitleColor}{primaryColorUsed}
  \colorlet{tocSectionColor}{primaryColorUsed}
  \colorlet{tocSubsectionColor}{primaryColorUsed}
  \colorlet{tocSubsubsectionColor}{primaryColorUsed}
\else
  \colorlet{tocTitleColor}{primaryColorUsed}
  \colorlet{tocSectionColor}{sectionColor}
  \colorlet{tocSubsectionColor}{subsectionColor}
  \colorlet{tocSubsubsectionColor}{secondaryColorUsed!50!primaryColorUsed}
\fi

\AtBeginDocument{%
  \addtocontents{toc}{%
    \protect\hypersetup{%
      linktoc=all,%
      hidelinks%
    }%
  }
}

\ifboolexpr{bool{neo@compacttoc} or bool{neo@twocoltoc}}{
    \RequirePackage{etoc}
}{}

\newcommand{\neo@toctitle}{\section*{\contentsname}}

\ifneo@compacttoc
  \etocsetstyle{part}
    {}
    {\addvspace{2.5em plus 2pt}\nopagebreak[4]}
    {\noindent\neo@title@style\large\bfseries\color{tocTitleColor}\etocnumber\quad\etocname\hfill
     {\neo@title@style\large\bfseries\color{tocTitleColor}\etocpage}\par
     \nopagebreak[4]\vskip2pt\nopagebreak[4]%
     {\color{tocTitleColor!40}\hrule height 0.6pt}\nopagebreak[4]\vskip4pt\nopagebreak[4]}
    {}

  \etocsetstyle{section}
    {}
    {\addvspace{-0.25em plus 1pt}}
    {\noindent\sffamily\bfseries\color{tocSectionColor}\etocnumber\quad\etocname\dotfill
     {\sffamily\bfseries\color{tocSectionColor}\etocpage}\par}
    {}

  \etocsetstyle{subsection}
    {}
    {\addvspace{-0.5em plus 1pt}}
    {\hspace*{2em}\sffamily\mdseries\color{tocSubsectionColor}\etocnumber\quad\etocname\dotfill
     {\sffamily\mdseries\color{tocSubsectionColor}\etocpage}\par}
    {}

  \etocsetstyle{subsubsection}
    {}
    {\addvspace{-0.5em plus 1pt}}
    {\hspace*{4em}\sffamily\mdseries\small\color{tocSubsubsectionColor}\etocnumber\quad\etocname\dotfill
     {\sffamily\small\mdseries\color{tocSubsubsectionColor}\etocpage}\par}
    {}

  \etocsettocstyle{\neo@toctitle}{}
\fi

\ifneo@twocoltoc
  \ifneo@compacttoc\else
    \etocsetstyle{part}
      {}
      {\addvspace{2.5em plus 2pt}\nopagebreak[4]}
      {\noindent\neo@title@style\large\bfseries\color{tocTitleColor}\etocnumber\quad\etocname\hfill
       {\neo@title@style\large\bfseries\color{tocTitleColor}\etocpage}\par
       \nopagebreak[4]\vskip2pt\nopagebreak[4]%
       {\color{tocTitleColor!40}\hrule height 0.6pt}\nopagebreak[4]\vskip4pt\nopagebreak[4]}
      {}
    \etocsetstyle{section}
      {}
      {\addvspace{1em plus 1pt}}
      {\noindent\sffamily\bfseries\color{tocSectionColor}\etocnumber\quad\etocname\dotfill
       {\sffamily\bfseries\color{tocSectionColor}\etocpage}\par}
      {}
    \etocsetstyle{subsection}
      {}
      {}
      {\hspace*{1.5em}\sffamily\mdseries\color{tocSubsectionColor}\etocnumber\quad\etocname\dotfill
       {\sffamily\mdseries\color{tocSubsectionColor}\etocpage}\par}
      {}
    \etocsetstyle{subsubsection}
      {}
      {}
      {\hspace*{3em}\sffamily\mdseries\small\color{tocSubsubsectionColor}\etocnumber\quad\etocname\dotfill
       {\sffamily\small\mdseries\color{tocSubsubsectionColor}\etocpage}\par}
      {}
  \fi
  \etocmulticolstyle[2]{\neo@toctitle}
\fi

%% ==============================================================================
%% Section formatting utilities
%% ==============================================================================

\def\neo@align@right{right}
\def\neo@align@left{left}
\def\neo@align@center{center}

\newcommand*\circled[1]{\tikz[baseline=(char.base)]{%
    \node[shape=circle,draw,inner sep=2pt,line width=1.5pt,baseline=-1.25mm] (char) {#1};}
  \vspace{-2pt}
}

\newcommand*{\neo@IfSCAvailableTF}{%
  \ifcsname\f@encoding/\f@family/\f@series/sc\endcsname
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi
}

\newcommand{\neo@applytextstyle}[1]{%
  \Ifstr{\neoschool@sectiontextstyle}{smallcaps}{%
    {\normalsize\mdseries\scshape #1}%
  }{%
  \Ifstr{\neoschool@sectiontextstyle}{caps}{%
    {\neo@sectionfont@style\MakeUppercase{#1}}%
  }{%
  \Ifstr{\neoschool@sectiontextstyle}{sc}{%
    \neo@IfSCAvailableTF{\scshape\Large\neo@sectionfont@style #1}{\MakeUppercase{\large \neo@sectionfont@style #1}}%
  }{%
    \Ifstr{\neoschool@sectiontextstyle}{upper}{%
      \MakeUppercase{\large \neo@sectionfont@style #1}%
    }{%
      \Ifstr{\neoschool@sectiontextstyle}{lower}{%
        {\large\neo@sectionfont@style\upshape #1}%
      }{%
        \neo@sectionfont@style\Large #1%
      }%
    }%
  }}}%
}

\renewcommand{\sectionformat}{%
  \Ifstr{\neoschool@sectionnumstyle}{circle}{%
    \circled{{\large\neo@sectionfont@style\thesection}}\enskip%
  }{%
    \Ifstr{\neoschool@sectionnumstyle}{box}{%
      \raisebox{0ex}{%
        \setlength{\fboxrule}{1.5pt}%
        \fcolorbox{sectionColor}{backgroundColor}{%
          \color{sectionColor}%
          \csname\neoschool@sectionfamily\endcsname
          \csname\neoschool@sectionweight\endcsname
          \large\thesection%
        }%
      }\enskip%
    }{%
      \Ifstr{\neoschool@sectionnumstyle}{dash}{%
        \neo@sectionfont@style\thesection\enskip\textendash\enskip
      }{%
      \Ifstr{\neoschool@sectionnumstyle}{period}{%
        \Ifstr{\neoschool@sectiontextstyle}{smallcaps}{\normalsize\mdseries}{\neo@sectionfont@style}\thesection.\enskip
      }{%
      \Ifstr{\neoschool@sectionnumstyle}{para}{%
        \neo@sectionfont@style\S\,\thesection.\enskip
      }{%
        \neo@sectionfont@style\thesection\autodot\enskip
      }}}%
    }%
  }%
}

\newcommand{\neo@setsectionraggedstyle}{%
  \Ifstr{\neoschool@sectionalign}{right}{%
    \renewcommand*{\raggedsection}{\raggedleft}%
  }{%
    \Ifstr{\neoschool@sectionalign}{left}{%
      \renewcommand*{\raggedsection}{\raggedright}%
    }{%
      \renewcommand*{\raggedsection}{\centering}%
    }%
  }%
}

\renewcommand{\sectionlinesformat}[4]{%
  \Ifstr{#1}{section}{%
    \Ifstr{\neoschool@sectionstyle}{ornaments}{%
      \sectionformat@ornaments{#3}{#4}%
    }{%
      \Ifstr{\neoschool@sectionstyle}{highlighted}{%
        \sectionformat@highlighted{#3}{#4}%
      }{%
        \Ifstr{\neoschool@sectionstyle}{shaded}{%
          \sectionformat@shaded{#3}{#4}%
        }{%
          \Ifstr{\neoschool@sectionstyle}{shadedline}{%
            \sectionformat@shadedline{#3}{#4}%
          }{%
            \Ifstr{\neoschool@sectionstyle}{normal}{%
              \sectionformat@normal{#2}{#3}{#4}%
            }{%
              \sectionformat@other{#3}{#4}%
            }%
          }%
        }%
      }%
    }%
  }{%
    \@hangfrom{\hskip #2#3}{#4}%
  }%
}

\newcommand{\sectionformat@normal}[3]{%
  \neo@setsectionraggedstyle
  \parbox[t]{\linewidth}{%
    \raggedsection
    \@hangfrom{\color{sectionColor}#2}{%
      \color{sectionColor}%
      \neo@applytextstyle{#3}%
    }%
  }%
  \par\nobreak
}

\newcommand{\sectionformat@ornaments}[2]{%
  \neo@setsectionraggedstyle
  \raggedsection
  \vspace*{0.5em}%
  \Ifstr{\neoschool@sectionalign}{center}{%
    {\color{sectionColor}\adforn{36}}\enskip{\color{sectionColor}#1\neo@applytextstyle{#2}}\enskip{\color{sectionColor}\adforn{36}}%
  }{%
    \Ifstr{\neoschool@sectionalign}{left}{%
      {\color{sectionColor}#1\neo@applytextstyle{#2}}\enskip{\color{sectionColor}\adforn{36}}%
    }{%
      {\color{sectionColor}\adforn{36}}\enskip{\color{sectionColor}#1\neo@applytextstyle{#2}}%
    }%
  }%
  \par\nobreak
  \vspace*{0.2em}%
}

\newcommand{\neo@setsectiontikzalign}{%
  \ifx\neoschool@sectionalign\neo@align@left
    left%
  \else
    \ifx\neoschool@sectionalign\neo@align@right
      right%
    \else
      center%
    \fi
  \fi
}

\newcommand{\neo@setsectiontikzcolor}[1]{%
  \ifx\neoschool@sectionalign\neo@align@left
    \ifnum\pdf@strcmp{#1}{left}=0
      sectionColor!120
    \else
      sectionColor!20
    \fi
  \else
    \ifx\neoschool@sectionalign\neo@align@right
      \ifnum\pdf@strcmp{#1}{right}=0
        sectionColor!120
      \else
        sectionColor!20
      \fi
    \else
      sectionColor!25
    \fi
  \fi
}

\newcommand{\neo@setsectiontikzmiddle}{%
  \ifx\neoschool@sectionalign\neo@align@left
    sectionColor!90
  \else
    \ifx\neoschool@sectionalign\neo@align@right
      sectionColor!90
    \else
      sectionColor!120
    \fi
  \fi
}

\newcommand{\sectionformat@highlighted}[2]{%
  \noindent\begin{tikzpicture}[baseline]
    \node[
    anchor=base,
    align=\neo@setsectiontikzalign,
    text width=.985\linewidth,
    text=titleColor,
    line width=0.5pt,
    fill=titleColor!15!backgroundColor,
    rounded corners=\neoschool@sectionarc,
    ] (title) {%
      #1\neo@applytextstyle{#2}%
    };
  \end{tikzpicture}%
  \par%
}

\newcommand{\sectionformat@shaded}[2]{%
  \noindent\begin{tikzpicture}[baseline]
    \node[
    anchor=base,
    align=\neo@setsectiontikzalign,
    text width=.985\linewidth,
    text=backgroundColor,
    line width=0.5pt,
    left color={\neo@setsectiontikzcolor{left}},
    right color={\neo@setsectiontikzcolor{right}},
    middle color={\neo@setsectiontikzmiddle},
    rounded corners=\neoschool@sectionarc,
    ] (title) {%
      #1\neo@applytextstyle{#2}%
    };
  \end{tikzpicture}%
  \par%
}

\newcommand{\sectionformat@shadedline}[2]{%
  \noindent
  \begin{tikzpicture}[baseline]
    \node[
      text=sectionColor,
      anchor=base,
      inner sep=0pt,
      outer sep=0pt,
      align=\neo@setsectiontikzalign,
      text width=\linewidth
    ] (title) {%
      \color{sectionColor}%
      #1\neo@applytextstyle{#2}%
    };

    \ifx\neoschool@sectionalign\neo@align@center

      \shade[
        left color=sectionColor!20,
        right color=sectionColor
      ]
        ([yshift=-0.5em]title.south west)
        rectangle
        ([yshift=-0.6em,xshift=0.33\linewidth]title.south west);

      \shade[
        left color=sectionColor,
        middle color=sectionColor!120,
        right color=sectionColor
      ]
        ([yshift=-0.5em,xshift=0.33\linewidth]title.south west)
        rectangle
        ([yshift=-0.6em,xshift=0.66\linewidth]title.south west);

      \shade[
        left color=sectionColor,
        right color=sectionColor!20
      ]
        ([yshift=-0.5em,xshift=0.66\linewidth]title.south west)
        rectangle
        ([yshift=-0.6em]title.south east);

    \else
      \ifx\neoschool@sectionalign\neo@align@left
        \shade[
          left color=sectionColor,
          right color=sectionColor!20
        ]
          ([yshift=-0.5em]title.south west)
          rectangle
          ([yshift=-0.6em]title.south east);

      \else
        \shade[
          left color=sectionColor!20,
          right color=sectionColor
        ]
          ([yshift=-0.5em]title.south west)
          rectangle
          ([yshift=-0.6em]title.south east);
      \fi
    \fi

  \end{tikzpicture}%
  \par
}

\newcommand{\sectionformat@other}[2]{%
  \neo@setsectionraggedstyle
  \Ifstr{\neoschool@sectionstyle}{underline}{%
    \sectionformat@underline{#1}{#2}%
  }{%
    \sectionformat@default{#1}{#2}%
  }%
}

\newcommand{\sectionformat@underline}[2]{%
  \parbox[t]{\linewidth}{%
    \raggedsection
    {\color{sectionColor}#1\neo@applytextstyle{#2}}%
    \par\nobreak
    \kern-.75\ht\strutbox\color{sectionColor!30}\rule{\linewidth}{1pt}%
  }%
}

\newcommand{\sectionformat@default}[2]{%
  \raggedsection
  {\color{sectionColor}#1\neo@applytextstyle{#2}}%
  \par\nobreak
}

%% ==============================================================================
%% Abstract formatting
%% ==============================================================================

\newcommand{\neo@format@text}[1]{%
  \Ifstr{\neoschool@sectiontextstyle}{sc}{%
    \neo@IfSCAvailableTF{\scshape #1}{\MakeUppercase{#1}}%
  }{%
    \Ifstr{\neoschool@sectiontextstyle}{upper}{%
      \MakeUppercase{#1}%
    }{%
      \Ifstr{\neoschool@sectiontextstyle}{lower}{%
        {\upshape #1}%
      }{%
        #1%
      }%
    }%
  }%
}

\if@twocolumn
  \renewenvironment{abstract}{%
    \begin{strip}
      \vspace{-2.5em}
      \def\@tempabstract{DEFAULT}%
      \quotation
      \ifneoschool@inlineabstract
        \noindent
        {%
          \normalfont\neo@main@title@@style\color{titleColor}\normalsize
          \ifx\neoschool@abstracttitle\@tempabstract\abstractname\else\neoschool@abstracttitle\fi.~%
        }%
        \ignorespaces%
      \else
        \ifx\neoschool@abstracttitle\@empty\else
          {\noindent\centering
            \normalfont\neo@main@title@@style\color{titleColor}\normalsize
            \neo@format@text{\ifx\neoschool@abstracttitle\@tempabstract\abstractname\else\neoschool@abstracttitle\fi}\par}
          \vspace{1ex}
        \fi
      \fi}
    {\vspace{1ex}\endquotation\end{strip}}
\else
  \renewenvironment{abstract}{%
    \def\@tempabstract{DEFAULT}%
    \quotation
    \ifneoschool@inlineabstract
      \noindent
      {%
        \normalfont\neo@main@title@@style\color{titleColor}\normalsize
        \ifx\neoschool@abstracttitle\@tempabstract\abstractname\else\neoschool@abstracttitle\fi.~%
      }%
    \else
      \ifx\neoschool@abstracttitle\@empty\else
        {\noindent\centering
          \normalfont\neo@main@title@@style\color{titleColor}\normalsize
          \neo@format@text{\ifx\neoschool@abstracttitle\@tempabstract\abstractname\else\neoschool@abstracttitle\fi}\par}
        \vspace{1ex}
      \fi
    \fi
  }{\endquotation}
\fi

%% ==============================================================================
%% Part Formatting
%% ==============================================================================

\renewcommand*{\partformat}{%
  \textcolor{titleColor}{%
    \neo@title@style
    \huge
    {\usekomafont{partnumber}\partname~\thepart}
  }%
}

\RedeclareSectionCommand[beforeskip=5em]{part}

\renewcommand{\partlineswithprefixformat}[3]{%
  \centering
  \begin{minipage}{\linewidth}%
    \centering
    {#2}%
    \par
    \vspace{0.5em}%
    {\color{titleColor!30}\rule{0.5\linewidth}{2pt}}%
    \par
    \vspace{0.75em}%
    {\usekomafont{part}#3}%
  \end{minipage}%
  \par\nobreak
  \vspace{1.5em}%
}

%% ==============================================================================
%% Header and Footer Styles and Setting
%% ==============================================================================

\newlength{\neo@leftmargin}
\AtBeginDocument{\setlength{\neo@leftmargin}{\dimexpr 1in + \hoffset + \oddsidemargin\relax}}

\def\neo@header@type{}
\def\neo@header@school{}
\def\neo@header@academy{}
\def\neo@header@level{}
\def\neo@header@duration{}
\def\neo@header@calculator{}
\def\neo@header@leftcontent{}
\def\neo@header@rightcontent{}
\def\neo@header@leftcontentfill{}
\def\neo@header@rightcontentfill{}

\define@key[neo]{header}{type}{\def\neo@header@type{#1}}
\define@key[neo]{header}{school}{\def\neo@header@school{#1}}
\define@key[neo]{header}{academy}{\def\neo@header@academy{#1}}
\define@key[neo]{header}{level}{\def\neo@header@level{#1}}
\define@key[neo]{header}{duration}{\def\neo@header@duration{#1}}
\define@key[neo]{header}{calculator}{%
  \IfStrEqCase{#1}{%
    {true}{\def\neo@header@calculator{true}}%
    {false}{\def\neo@header@calculator{false}}%
    {exam}{\def\neo@header@calculator{exam}}%
  }[%
  \ClassError{neoschool}{Invalid calculator value: #1}%
  {Use 'true', 'false' or 'exam'}%
  ]%
}
\define@key[neo]{header}{leftcontent}{\def\neo@header@leftcontent{#1}}
\define@key[neo]{header}{rightcontent}{\def\neo@header@rightcontent{#1}}
\define@key[neo]{header}{leftcontentfill}{\def\neo@header@leftcontentfill{#1}}
\define@key[neo]{header}{rightcontentfill}{\def\neo@header@rightcontentfill{#1}}

\ifneo@french
  \def\neo@headerdefaults{type={Évaluation},school={CSI Lyon},academy={Lyon},level={Terminale},duration={1 heure}}
\else
  \ifneo@german
    \def\neo@headerdefaults{type={Klausur},school={},academy={},level={},duration={1 Stunde}}
  \else
    \def\neo@headerdefaults{type={Test},school={},academy={},level={},duration={1 hour}}
  \fi
\fi
\edef\neo@tempa{%
  \noexpand\presetkeys[neo]{header}{%
    \unexpanded\expandafter{\neo@headerdefaults},%
    calculator=true,%
    leftcontent={\noexpand\faBookOpen},%
    rightcontent={\noexpand\faSchool},%
    leftcontentfill=false,%
    rightcontentfill=false%
  }{}%
}
\neo@tempa

\newcommand{\neoheader}[1]{%
  \setkeys[neo]{header}{#1}%
}

\newif\ifneoheaderused
\neoheaderusedfalse

\let\neo@original@header\neoheader
\renewcommand{\neoheader}[1]{%
  \neoheaderusedtrue
  \neo@original@header{#1}%
}

\AtEndPreamble{%
  \ifneoheaderused\else
    \setkeys[neo]{header}{}%
  \fi
}

% Header configurations
\ifx\neo@pagestyle\@undefined
  \def\neo@pagestyle{followingpages}
\fi

\ifneo@fullheader
  \ihead{\neo@header@type}
  \chead{\@title}
  \ohead{\neo@header@level}
  \innerfoot{\@date}
  \cfoot{\neo@header@school}
  \ofoot{\pagemark}
  \def\neo@pagestyle{scrheadings}
  \neo@firstpagestyleoverridefalse
\fi

\pagestyle{\neo@pagestyle}

\ifneo@firstpagestyleoverride
  \def\neo@tempstyle{empty}
  \ifx\neo@pagestyle\neo@tempstyle
    \let\ps@firstpage\ps@empty
    \let\ps@pagenum\ps@empty
  \else
    \let\ps@firstpage\ps@pagenum
  \fi
\fi

\thispagestyle{firstpage}

\ExplSyntaxOn
\str_case:VnF \neoschool@headerules
{
  {headrule} { \KOMAoptions{headsepline=.4pt} }
  {footrule} { \KOMAoptions{footsepline=.4pt} }
  {headfootrule} { \KOMAoptions{headsepline=.4pt, footsepline=.4pt} }
  {none} { }
}
{ }
\ExplSyntaxOff

%% ==============================================================================
%% Evaluation Headers and Special Styles
%% ==============================================================================

%% Dimensions and Basic Configuration
%% ----------------------------------
\newlength{\neo@headerheight}
\setlength{\neo@headerheight}{35mm}

\newlength{\neo@iconsize}
\setlength{\neo@iconsize}{1.5cm}

\newlength{\neo@default@top@ref}
\if@twocolumn
  \setlength{\neo@default@top@ref}{1.5cm}\else\setlength{\neo@default@top@ref}{1.65cm}\fi

\newlength{\neo@current@total@topspace}
\newlength{\neo@compensation@value}

\newcommand{\neo@top@compensate}{%
  \setlength{\neo@current@total@topspace}{\dimexpr 1in + \voffset + \topmargin + \headheight + \headsep \relax}%
  \setlength{\neo@compensation@value}{\dimexpr \neo@default@top@ref - \neo@current@total@topspace \relax}%
  \vspace*{\neo@compensation@value}%
}

\newcommand{\neo@vspace@short}{%
  \neo@top@compensate%
  \if@twocolumn
    \vspace{2\baselineskip}%
  \else
    \vspace{\baselineskip}%
  \fi
}

\newcommand{\neo@vspace@eval}{%
  \neo@top@compensate%
  \ifx\@subject\empty
    \ifx\@subtitle\empty
      \if@twocolumn \vspace{4.35\baselineskip}\else \vspace{2.75\baselineskip}\fi
    \else
      \if@twocolumn \vspace{5.35\baselineskip}\else \vspace{3.75\baselineskip}\fi
    \fi
  \else
    \ifx\@subtitle\empty
      \if@twocolumn \vspace{5.35\baselineskip}\else \vspace{3.75\baselineskip}\fi
    \else
      \if@twocolumn \vspace{6.35\baselineskip}\else \vspace{4.75\baselineskip}\fi
    \fi
  \fi
}

\newcommand{\neo@vspace@evalicons}{%
  \neo@top@compensate%
  \if@twocolumn
    \vspace{6\baselineskip}%
  \else
    \vspace{4.75\baselineskip}%
  \fi
}

\newcommand{\neo@title@final@gap}{%
  \if@twocolumn
    \vspace{1.5\baselineskip}%
  \else
    \vspace{0.75\baselineskip}%
  \fi
}

\newcommand{\neo@short@exam@gap}{%
  \if@twocolumn
    \vspace{2.5\baselineskip}%
  \else
    \vspace{1.5\baselineskip}%
  \fi
}

%% Colors Setup
%% ----------------------------------
\newcommand{\neo@setupevalcolors}{%
  \def\neo@evalrulecolor{\neoschool@headfootcolor!25!backgroundColor}%
}

%% Basic Title Components
%% ----------------------------------

\def\neo@titleblock@yshift{-20mm}

\newsavebox{\neo@fitbox}
\newdimen\neo@fitlast
\newdimen\neo@fitone
\newdimen\neo@fitmax
\newif\ifneo@fitscaled
\newcommand{\neo@fit}[5]{%
  \begingroup
  \edef\neo@fitwidth{\the\dimexpr#1\relax}%
  \@tempcntb=#2\relax
  \def\neo@fitref{Xg}%
  \loop\ifnum\@tempcntb>\@ne\advance\@tempcntb\m@ne\expandafter\def\expandafter\neo@fitref\expandafter{\neo@fitref\\Xg}\repeat
  \setbox\neo@fitbox\hbox{\parbox[t]{\neo@fitwidth}{#3{#4Xg}\par}}%
  \global\neo@fitone=\dimexpr\ht\neo@fitbox+\dp\neo@fitbox\relax
  \setbox\neo@fitbox\hbox{\parbox[t]{\neo@fitwidth}{#3{#4\neo@fitref}\par}}%
  \global\neo@fitmax=\dimexpr\ht\neo@fitbox+\dp\neo@fitbox+4pt\relax
  \@tempcntb=\c@footnote
  \setbox\neo@fitbox\hbox{\parbox[t]{\neo@fitwidth}{#3{#4#5}\par}}%
  \global\neo@fitlast=\dimexpr\ht\neo@fitbox+\dp\neo@fitbox\relax
  \global\c@footnote=\@tempcntb
  \global\neo@fitscaledfalse
  \ifdim\neo@fitlast>\neo@fitmax
    \global\neo@fitscaledtrue
    \@tempcnta=\z@
    \loop
      \advance\@tempcnta\@ne
      \edef\neo@fitscale{\strip@pt\dimexpr 1pt-.06pt*\@tempcnta\relax}%
      \global\setbox\neo@fitbox\hbox{\scalebox{\neo@fitscale}{\parbox[t]{\dimexpr\neo@fitwidth*\p@/\dimexpr\neo@fitscale\p@\relax\relax}{#3{#4#5}\par}}}%
      \global\neo@fitlast=\dimexpr\ht\neo@fitbox+\dp\neo@fitbox\relax
      \global\c@footnote=\@tempcntb
      \@tempswafalse
      \ifdim\neo@fitlast>\neo@fitmax\ifnum\@tempcnta<9 \@tempswatrue\fi\fi
    \if@tempswa\repeat
  \fi
  \endgroup
  \ifneo@fitscaled\leavevmode\box\neo@fitbox\else#4#5\fi
}
\tikzset{neo@evalsubtitle/.style={}}
\newcommand{\neo@fitsublines}{\ifdim\neo@fitlast>1.5\neo@fitone 1\else 2\fi}

\newcommand{\neo@completetitle}[1][]{%
  \node[
  align=center,
  anchor=center,
  text width=0.75\textwidth,
  #1
  ] (title) at ([yshift=\neo@titleblock@yshift]current page.north) {%
    \neo@fit{\hsize}{2}{\centering}{\baselineskip=30pt
    \csname\neoschool@titlefamily\endcsname
    \csname\neoschool@titleweight\endcsname
    \csname\neoschool@titleshape\endcsname
    \color{titleColor}\usekomafont{title}}{{\@title}}
  };

  \ifx\@subject\empty\else
    \node[
    above=1.5mm of title.north,
    anchor=south,
    text width=0.85\textwidth,
    align=center,
    ] {%
      \usekomafont{subject}{\textls[50]{\MakeUppercase{\@subject}}}
    };
  \fi

  \ifx\@subtitle\empty\else
    \node[
    below=1.5mm of title.south,
    anchor=north,
    text width=0.85\textwidth,
    align=center, neo@evalsubtitle,
    ] {%
      \neo@fit{\hsize}{\neo@fitsublines}{\centering}{\usekomafont{subtitle}}{{\@subtitle}}
    };
  \fi
}

\newcommand{\neo@completegradetitle}[1][]{%
  \ifx\@subject\empty
    \ifx\@subtitle\empty
      \def\neo@grade@title@yshift{-4.25\baselineskip}
      \def\neo@grade@duration@yshift{-6.25\baselineskip}
      \def\neo@grade@name@yshift{-7.75\baselineskip}
      \if@twocolumn \gdef\neo@vspace@grade@before{\vspace{6.5\baselineskip}}
      \else \gdef\neo@vspace@grade@before{\vspace{6\baselineskip}}\fi
    \else
      \def\neo@grade@title@yshift{-4.25\baselineskip}
      \def\neo@grade@duration@yshift{-7.75\baselineskip}
      \def\neo@grade@name@yshift{-9.25\baselineskip}
      \if@twocolumn \gdef\neo@vspace@grade@before{\vspace{8\baselineskip}}
      \else \gdef\neo@vspace@grade@before{\vspace{7.5\baselineskip}}\fi
    \fi
  \else
    \ifx\@subtitle\empty
      \def\neo@grade@title@yshift{-5.25\baselineskip}
      \def\neo@grade@duration@yshift{-7.25\baselineskip}
      \def\neo@grade@name@yshift{-8.75\baselineskip}
      \if@twocolumn \gdef\neo@vspace@grade@before{\vspace{7.5\baselineskip}}
      \else \gdef\neo@vspace@grade@before{\vspace{7\baselineskip}}\fi
    \else
      \def\neo@grade@title@yshift{-5.25\baselineskip}
      \def\neo@grade@duration@yshift{-8.85\baselineskip}
      \def\neo@grade@name@yshift{-10.35\baselineskip}
      \if@twocolumn \gdef\neo@vspace@grade@before{\vspace{9\baselineskip}}
      \else \gdef\neo@vspace@grade@before{\vspace{8.5\baselineskip}}\fi
    \fi
  \fi

  \node[
  align=center,
  anchor=center,
  text width=0.85\textwidth,
  #1
  ] (title) at ([yshift=\neo@grade@title@yshift]current page.north) {%
    \neo@fit{\hsize}{2}{\centering}{\baselineskip=30pt
    \csname\neoschool@titlefamily\endcsname
    \csname\neoschool@titleweight\endcsname
    \csname\neoschool@titleshape\endcsname
    \color{titleColor}\usekomafont{title}}{{\@title}}
  };

  \ifx\@subject\empty\else
    \node[
    above=1.5mm of title.north,
    anchor=south,
    text width=0.85\textwidth,
    align=center,
    ] {%
      \usekomafont{subject}{\textls[50]{\MakeUppercase{\@subject}}}
    };
  \fi

  \ifx\@subtitle\empty
  \else
    \node[
    below=1.5mm of title.south,
    anchor=north,
    text width=0.85\textwidth,
    align=center, neo@evalsubtitle,
    ] {%
      \neo@fit{\hsize}{\neo@fitsublines}{\centering}{\usekomafont{subtitle}\large}{\@subtitle}
    };
  \fi

  \node[
  anchor=north,
  align=center,
  font=\small\sffamily,
  yshift=\neo@grade@duration@yshift
  ] at (current page.north) {%
    \neo@durationtxt{} \neo@header@duration\quad\textbullet\quad\neo@calculator
  };

  \node[
  anchor=north,
  align=center,
  font=\small\sffamily,
  yshift=\neo@grade@name@yshift
  ] at (current page.north) {%
    \color{\neoschool@globalcolor}\neo@nametxt{} \vardots[4cm]
  };
}

%% ==============================================================================
%% Enhanced Header without Icons
%% ==============================================================================

%% Configuration for Simple Header
%% ----------------------------------
\newcommand{\neo@setupheaderconfig}{%
  \edef\neo@leftcornershift{\dimexpr(\paperwidth - \textwidth)/4-5pt\relax}%
  \edef\neo@rightcornershift{\dimexpr(\paperwidth - \textwidth)/4\relax}%
  \def\neo@topyshift{8mm}%
  \def\neo@topyshiftgrade{8mm}%
}

%% Corner Text Nodes
%% ----------------------------------
\newcommand{\neo@cornernode}[4]{%
  \node[
  anchor=#1,
  font={\color{\neoschool@headfootcolor}\small\sffamily}
  ] at ([xshift=#2,yshift=-#3]current page.north #1) {%
    \begingroup
    #4%
    \endgroup
  };
}

%% ==============================================================================
%% Header with Icons
%% ==============================================================================

%% Icon Node Definition
%% ----------------------------------
\newcommand{\neo@iconnode}[6]{%
  \expandafter\ifstrequal\expandafter{#6}{true}{%
    \tikzset{neo@iconfill/.style={fill=titleColor,text=backgroundColor}}%
  }{%
    \tikzset{neo@iconfill/.style={fill=backgroundColor,text=titleColor}}%
  }%
  \node[
  rectangle,
  minimum height=\neo@iconsize,
  minimum width=\neo@iconsize,
  neo@iconfill,
  draw=titleColor,
  line width=0.5pt,
  anchor=center,
  font=\Large,
  rounded corners=2pt
  ] (#1) at #2 {#3};

  % Top text
  \node[
  above=2mm of #1,
  anchor=south,
  font={\color{\neoschool@headfootcolor}\small\sffamily}
  ] (#1-top) {%
    \begingroup
    #4%
    \endgroup
  };

  % Bottom text
  \node[
  below=2mm of #1,
  anchor=north,
  font={\color{\neoschool@headfootcolor}\small\sffamily}
  ] (#1-bottom) {%
    \begingroup
    #5%
    \endgroup
  };
}

%% ==============================================================================
%% Header Type Selection and Setup
%% ==============================================================================

%% Header without Icons
\newcommand{\neo@evalcontent}{%
  \thispagestyle{pagenum}
  \neo@setupevalcolors
  \neo@setupheaderconfig

  \ifx\@subject\empty
    \ifx\@subtitle\empty
      \def\neo@titleblock@yshift{-16mm}
      \def\neo@adjustedbottomyshift{24mm}
      \def\neo@adjustedruleposition{-0.85\neo@headerheight}
    \else
      \def\neo@titleblock@yshift{-16mm}
      \def\neo@adjustedbottomyshift{29mm}
      \def\neo@adjustedruleposition{-\neo@headerheight}
    \fi
  \else
    \ifx\@subtitle\empty
      \def\neo@titleblock@yshift{-22mm}
      \def\neo@adjustedbottomyshift{29mm}
      \def\neo@adjustedruleposition{-\neo@headerheight}
    \else
      \def\neo@titleblock@yshift{-20mm}
      \def\neo@adjustedbottomyshift{34mm}
      \def\neo@adjustedruleposition{-1.1\neo@headerheight}
    \fi
  \fi

  \begin{tikzpicture}[remember picture,overlay]
    \draw[\neo@evalrulecolor,line width=\neo@decorativerule]
    ([yshift=\neo@adjustedruleposition]current page.north west) --
    ([yshift=\neo@adjustedruleposition]current page.north east);
    \neo@completetitle
    \neo@cornernode{west}{\neo@leftcornershift}{\neo@topyshift}{\neo@header@type}
    \neo@cornernode{east}{-\neo@rightcornershift}{\neo@topyshift}{\neo@header@school}
    \neo@cornernode{west}{\neo@leftcornershift}{\neo@adjustedbottomyshift}{\neo@header@level}
    \neo@cornernode{east}{-\neo@rightcornershift}{\neo@adjustedbottomyshift}{\@date}
  \end{tikzpicture}%
  \neo@vspace@eval
}

%% Header with Icons
\newcommand{\neo@evaliconscontent}{%
  \thispagestyle{pagenum}
  \neo@setupevalcolors
  \begin{tikzpicture}[remember picture,overlay,neo@evalsubtitle/.style={text width=0.66\textwidth}]
    \draw[\neo@evalrulecolor,line width=\neo@decorativerule]
    ([yshift=-1.125\neo@headerheight]current page.north west) --
    ([yshift=-1.125\neo@headerheight]current page.north east);
    \neo@completetitle[text width=0.7\textwidth]
    \neo@iconnode{typeicon}
    {([xshift=30mm,yshift=-0.575\neo@headerheight]current page.north west)}
    {\neo@header@leftcontent}
    {\neo@header@type}
    {\neo@header@level}
    {\neo@header@leftcontentfill}
    \neo@iconnode{schoolicon}
    {([xshift=-30mm,yshift=-0.575\neo@headerheight]current page.north east)}
    {\neo@header@rightcontent}
    {\neo@header@school}
    {\@date}
    {\neo@header@rightcontentfill}
  \end{tikzpicture}%
  \neo@vspace@evalicons
}

%% Header with grading strip without Icons
\newcommand{\neo@evalgradecontent}{%
  \thispagestyle{empty}
  \neo@setupevalcolors
  \neo@setupheaderconfig
  \begin{tikzpicture}[remember picture,overlay]
    \neo@completegradetitle
    \neo@cornernode{west}{\neo@leftcornershift}{\neo@topyshiftgrade}{\neo@header@type}
    \neo@cornernode{east}{-\neo@rightcornershift}{\neo@topyshiftgrade}{\neo@header@level}

    \node[
    anchor=west,
    font={\small\sffamily}
    ] at ([xshift=\neo@leftcornershift,yshift=9mm]current page.south west) {%
      \color{\neoschool@headfootcolor}\@date%
    };

    \node[
    anchor=east,
    font={\small\sffamily}
    ] at ([xshift=-\neo@rightcornershift,yshift=9mm]current page.south east) {%
      \color{\neoschool@headfootcolor}\neo@header@school%
    };

    \node[
    font=\small\sffamily,
    inner sep=3mm
    ] at ([yshift=9mm]current page.south) {%
      \color{\neoschool@headfootcolor}\thepage
    };
  \end{tikzpicture}%
  \neo@vspace@grade@before

  \ifx\neoschool@totalpoints\@empty\gradingstrip\else\gradingstrip[\neoschool@totalpoints]\fi
  \neo@title@final@gap
}

%% Header with grading strip with Icons
\newcommand{\neo@evaliconsgradecontent}{%
  \thispagestyle{pagenum}
  \begin{tikzpicture}[remember picture,overlay,neo@evalsubtitle/.style={text width=0.66\textwidth}]
    \neo@completegradetitle[text width=0.7\textwidth]
    \neo@iconnode{typeicon}
    {([xshift=30mm,yshift=-0.675\neo@headerheight]current page.north west)}
    {\neo@header@leftcontent}
    {\neo@header@type}
    {\neo@header@level}
    {\neo@header@leftcontentfill}
    \neo@iconnode{schoolicon}
    {([xshift=-30mm,yshift=-0.675\neo@headerheight]current page.north east)}
    {\neo@header@rightcontent}
    {\neo@header@school}
    {\@date}
    {\neo@header@rightcontentfill}
  \end{tikzpicture}%
  \neo@vspace@grade@before

  \ifx\neoschool@totalpoints\@empty\gradingstrip\else\gradingstrip[\neoschool@totalpoints]\fi
  \neo@title@final@gap
}

%% Calculator Notice
%% ----------------------------------
\newcommand{\neo@calculator}{%
  \small \neo@calcintro{}%
  \def\@tempa{true}%
  \def\@tempb{exam}%
  \ifx\neo@header@calculator\@tempa
    ~\neo@calcallowed.%
  \else
    \ifx\neo@header@calculator\@tempb
      ~\neo@calcallowed{} \neo@calcexammodeonly{} \neo@calcexammode.%
    \else
      ~\neo@calcnotallowed.%
    \fi
  \fi
  \par
}

%% Exam Header
%% ----------------------------------
%% Exam style helper commands and setup
\newcommand{\neo@gettext}[1]{%
  \ifcase#1\or\neo@exam@institution\or\neo@exam@name\or\neo@exam@class\or\neo@exam@duration\or\neo@exam@date\or\neo@exam@mark\or\neo@exam@comments\fi
}

\newcommand{\neo@examfield}[2]{%
  \textbf{#1}\hspace{0.5em}#2%
}

%% Exam title style
\newcommand{\neo@examcontent}{%
  \thispagestyle{customfirstpage}
  \vspace*{-2cm}%
  \begin{tcolorbox}[%
    enhanced,
    frame hidden,
    colback=backgroundColor,
    colupper=\neoschool@globalcolor,
    top=\baselineskip,
    bottom=\baselineskip,
    left=0pt,
    right=0pt,
    width=\textwidth,
    after skip=0pt,
    ]
    {\renewcommand\arraystretch{1.25}%
      \begin{tblr}{X[4,l]X[1,c]X[4,r]}
        \neo@examfield{\neo@gettext{1} :}{\neo@header@school} &  &
                                                               \neo@examfield{\neo@gettext{5} :}{\@date}                  \\
        \neo@examfield{\neo@gettext{2} :}{\vardots[4cm]}      &  &
                                                               \neo@examfield{\neo@gettext{3} :}{\neo@header@level}
      \end{tblr}
    }

    \vspace{\baselineskip}
    \centering

    \begin{minipage}[c]{\linewidth}
      \centering\color{\neoschool@globalcolor}
      \neo@header@type
    \end{minipage}\vspace{.75\baselineskip}

    \csname\neoschool@titlefamily\endcsname
    \csname\neoschool@titleweight\endcsname
    \csname\neoschool@titleshape\endcsname
    \color{titleColor}
    \usekomafont{title}{\@title}\vspace{.65\baselineskip}

    \normalsize\normalfont\color{\neoschool@globalcolor}
    \begin{minipage}[c]{\linewidth}
      \centering
      \neo@examfield{\neo@gettext{4} :}{\neo@header@duration}\vspace{\baselineskip}

      \neo@calculator
    \end{minipage}
  \end{tcolorbox}

  \medskip

  \ifx\neoschool@totalpoints\@empty\gradingstrip\else\gradingstrip[\neoschool@totalpoints]\fi

  \neo@title@final@gap
}

%% French Exam Headers
%% ----------------------------------
% Common exam title commands
\NewDocumentCommand{\neo@examtitle}{m}{%
  {\color{titleColor}
    \csname\neoschool@titlefamily\endcsname
    \csname\neoschool@titleweight\endcsname
    \csname\neoschool@titleshape\endcsname
    \LARGE\MakeUppercase{#1}\par}
}

\NewDocumentCommand{\neo@examsubtitle}{m}{%
  {\color{titleColor!85!\neoschool@globalcolor}
    \csname\neoschool@titlefamily\endcsname
    \Large #1\par}
}

\NewDocumentCommand{\neo@examinfo}{m}{%
  {\color{titleColor!75!\neoschool@globalcolor}
    \csname\neoschool@titlefamily\endcsname
    \large #1\par}
}

\ExplSyntaxOn
\tl_new:N \l__neo_subject_tl
\bool_new:N \l__neo_elide_bool
\cs_new_protected:Npn \neo@examof
  {
    \tl_if_empty:NF \@subject
      {
        \bool_set_false:N \l__neo_elide_bool
        \legacy_if:nT { neo@french }
          {
            \tl_set:Nx \l__neo_subject_tl { \text_lowercase:n { \exp_not:V \@subject } }
            \regex_match:nVT { \A [aeiouhàâäéèêëîïôöùûü] } \l__neo_subject_tl
              { \bool_set_true:N \l__neo_elide_bool }
          }
        \bool_if:NTF \l__neo_elide_bool
          { ÉPREUVE~D' } { \neo@examoftxt{}~ }
        \MakeUppercase { \@subject }
      }
  }
\ExplSyntaxOff

%% Mock exam style
\newcounter{mockexampages}
\newcommand{\neo@mockexamcontent}{%
  \vspace*{1cm}%
  \begin{center}
    {\textsc{\neo@examinfo{\neo@header@school}}}
    \vspace*{1cm}%
    {\ifx\neo@header@academy\@empty\else\textsc{\neo@examinfo{\neo@academytxt{} \neo@header@academy}}\fi}
    \vspace*{\stretch{2.5}}%

    {\LARGE\bfseries\csname\neoschool@headfamily\endcsname
      \csname\neoschool@headweight\endcsname
      \csname\neoschool@headshape\endcsname
      \neo@examtitle{\neo@header@type}}
    \vspace*{0.8cm}%
    {\color{titleColor!75!\neoschool@globalcolor}\itshape \neo@sessiontxt{} \@date}
    \vspace*{1.5cm}%

    {\Large\csname\neoschool@headfamily\endcsname
      \csname\neoschool@headweight\endcsname
      \csname\neoschool@headshape\endcsname
      \neo@examsubtitle{\neo@examof}}
    \vspace*{1cm}%
    {\neo@examinfo{\neo@header@level}}
    \vspace*{\stretch{2}}%

    {\textit{\neo@durationtxt{} \neo@header@duration}}
    \vspace*{1.2cm}%

    \begin{minipage}{0.8\textwidth}
      \begin{center}
        \setlength{\baselineskip}{1.6\baselineskip}%
        \neo@calculator
        \vspace*{0.8cm}%
        \neo@examqualitytxt{}
        \vspace*{0.8cm}
        \neo@examattempttxt{}
      \end{center}
    \end{minipage}
    \vspace*{\stretch{1.5}}%

    {\color{titleColor!65!\neoschool@globalcolor}%
      \neo@pagestxt{} \pageref*{LastPage}~\neo@pagesfromtxt{} 1/\pageref*{LastPage} \neo@pagestotxt{} \pageref*{LastPage}/\pageref*{LastPage}.}
    \vspace*{1.5cm}%
  \end{center}
  \thispagestyle{pagenum}%
  \clearpage\newpage
}

\newcommand{\neo@shortexamcontent}{%
  \thispagestyle{customfirstpage}
  \vspace*{-1cm}
  \begin{center}

    {\neo@header@school}

    \vspace{3mm}
    {\Large \csname\neoschool@headfamily\endcsname
      \csname\neoschool@headweight\endcsname
      \csname\neoschool@headshape\endcsname
      \neo@examtitle{\neo@header@type}}

    \vspace{3mm}
    {\small \textit{\neo@sessiontxt{} \@date}}

    \vspace{5mm}
    {\large \csname\neoschool@headfamily\endcsname
      \csname\neoschool@headweight\endcsname
      \csname\neoschool@headshape\endcsname
      \neo@examsubtitle{\neo@examof}}

    \vspace{3mm}
    {\small \neo@examinfo{\neo@header@level}}

    \vspace{5mm}
    {\small \textit{\neo@durationtxt{} \neo@header@duration}}

    \vspace{5mm}
    \neo@calculator

    \vspace{8mm}
    {\color{\neoschool@headfootcolor}%
      \rule{0.5\linewidth}{0.5pt}}

  \end{center}
  \neo@short@exam@gap
}

%% Short Eval Header Style
%% ----------------------------------
\newlength{\neo@sideWidth}
\setlength{\neo@sideWidth}{4.5cm}

\newcommand{\neo@shortevalcontent}{%
  \thispagestyle{customfirstpage}
  \begin{tikzpicture}[remember picture,overlay]
    \draw[line width=\neo@decorativerule, \neoschool@headfootcolor!50!backgroundColor]
    ([yshift=-21mm]current page.north west) --
    ([yshift=-21mm]current page.north east);
    \path let \p1=(current page.east) in node[
    anchor=west,
    align=left,
    text width=\neo@sideWidth,
    font=\small\sffamily,
    text=\neoschool@headfootcolor
    ] at ([xshift=0.75cm,yshift=-11mm]current page.north west)
    {\neo@nametxt{} \\[1mm]
      \neo@header@type};
    \path let \p1=(current page.east) in node[
    anchor=center,
    align=center,
    text width={\dimexpr\paperwidth-2\neo@sideWidth-0.25cm},
    ] at ([yshift=-11mm]current page.north)
    {\color{titleColor}%
      \csname\neoschool@titlefamily\endcsname%
      \csname\neoschool@titleweight\endcsname%
      \csname\neoschool@titleshape\endcsname%
      \usekomafont{title}\@title};
    \path let \p1=(current page.east) in node[
    anchor=east,
    align=right,
    text width=\neo@sideWidth,
    font=\small\sffamily,
    text=\neoschool@headfootcolor
    ] at ([xshift=-0.75cm,yshift=-11mm]current page.north east)
    {\neo@header@school\\[1mm]
      \neo@header@level};
  \end{tikzpicture}%
  \neo@vspace@short
}

%% Short Title Header Style
%% ----------------------------------
\newcommand{\neo@shorttitlecontent}{%
  \thispagestyle{customfirstpage}
  \begin{tikzpicture}[remember picture,overlay]
    \draw[line width=\neo@decorativerule, \neoschool@headfootcolor!50!backgroundColor]
    ([yshift=-21mm]current page.north west) --
    ([yshift=-21mm]current page.north east);

    \def\neo@node@anchor{center}
    \def\neo@node@align{center}
    \def\neo@node@pos{current page.north}
    \def\neo@node@xshift{0cm}

    \ifx\neoschool@titlealign\neo@left
      \def\neo@node@anchor{west}
      \def\neo@node@align{left}
      \def\neo@node@pos{current page.north west}
      \def\neo@node@xshift{1cm}
    \fi

    \ifx\neoschool@titlealign\neo@right
      \def\neo@node@anchor{east}
      \def\neo@node@align{right}
      \def\neo@node@pos{current page.north east}
      \def\neo@node@xshift{-1cm}
    \fi

    \node[
    anchor=\neo@node@anchor,
    align=\neo@node@align,
    text width={\dimexpr\paperwidth-2cm},
    ] at ([xshift=\neo@node@xshift, yshift=-11mm]\neo@node@pos)
    {%
      \color{titleColor}%
      \csname\neoschool@titlefamily\endcsname%
      \csname\neoschool@titleweight\endcsname%
      \csname\neoschool@titleshape\endcsname%
      \usekomafont{title}{\@title}%
    };
  \end{tikzpicture}%
  \neo@vspace@short
}

%% Short Lesson Header Style
%% ----------------------------------
\newcommand{\neo@shortlessoncontent}{%
  \thispagestyle{customfirstpage}
  \begin{tikzpicture}[remember picture,overlay]
    \draw[line width=\neo@decorativerule, \neoschool@headfootcolor!50!backgroundColor]
    ([yshift=-21mm]current page.north west) --
    ([yshift=-21mm]current page.north east);

    \path let \p1=(current page.east) in node[
    anchor=west,
    align=left,
    text width=\neo@sideWidth,
    font=\small\sffamily,
    text=\neoschool@headfootcolor
    ] at ([xshift=0.75cm,yshift=-11mm]current page.north west)
    {\neo@header@type};

    \path let \p1=(current page.east) in node[
    anchor=center,
    align=center,
    text width={\dimexpr\paperwidth-2\neo@sideWidth-0.25cm},
    font=\Large
    ] at ([yshift=-11mm]current page.north)
    {\color{titleColor}%
      \csname\neoschool@titlefamily\endcsname%
      \csname\neoschool@titleweight\endcsname%
      \csname\neoschool@titleshape\endcsname%
      \@title};

    \path let \p1=(current page.east) in node[
    anchor=east,
    align=right,
    text width=\neo@sideWidth,
    font=\small\sffamily,
    text=\neoschool@headfootcolor
    ] at ([xshift=-0.75cm,yshift=-11mm]current page.north east)
    {\neo@header@level};
  \end{tikzpicture}%
  \neo@vspace@short
}

%% Wave Header
%% ----------------------------------
\newsavebox{\neo@wave@headercontent}
\newsavebox{\neo@wave@subject}

\newcommand{\neo@wavecontent}{%
  \thispagestyle{customfirstpage}

  \ifx\@subject\empty
    \sbox{\neo@wave@subject}{}
  \else
    \sbox{\neo@wave@subject}{%
      \tcbox[
        on line,
        colback=subjectColor!10!backgroundColor,
        colframe=subjectColor!10!backgroundColor,
        coltext=subjectColor,
        boxrule=0pt, boxsep=0pt,
        left=6pt, right=6pt, top=3pt, bottom=3pt,
        arc=4pt, auto outer arc,
        nobeforeafter
        ]
        {\usekomafont{subject}\textls[50]{\MakeUppercase{\@subject}}}}
  \fi

  \sbox{\neo@wave@headercontent}{%
     \begin{minipage}{\dimexpr\textwidth-20pt}
        \centering

        \ifx\@subject\empty\else
          \usebox{\neo@wave@subject}\par\vspace{\neo@title@sep@subjectbox}
        \fi

        \neo@printtitle\par\vspace{\neo@title@sep@subtitle}

        \ifx\@subtitle\empty\else
          {\usekomafont{subtitle}\@subtitle}
        \fi
     \end{minipage}%
  }

  \begin{tikzpicture}[remember picture, overlay]

    \node[
        anchor=north,
        inner ysep=0pt,
        inner xsep=0pt
    ] (headerbox) at ([yshift=-1.5cm]current page.north) {
        \usebox{\neo@wave@headercontent}
    };

    \coordinate (HeaderBottom) at ([yshift=-2.5cm]headerbox.south);

    \begin{scope}[on background layer]
        
        \fill[backgroundColor] (current page.north west) rectangle (current page.east |- HeaderBottom);
        
        \fill[top color=primaryColor!8!backgroundColor, bottom color=backgroundColor]
             (current page.north west) rectangle (current page.east |- HeaderBottom);

        \begin{scope}
            \clip (current page.north west) rectangle (current page.east |- HeaderBottom);

            \begin{scope}[opacity=0.15, line width=1.5pt, draw=primaryColor]
                
                \draw plot [smooth, tension=1] coordinates {
                    ([yshift=-2.25cm]current page.north west)
                    ([xshift=\neo@pagex{500}, yshift=-3.75cm]current page.north west)
                    ([xshift=\neo@pagex{1200}, yshift=-1.25cm]current page.north west)
                    ([xshift=\paperwidth, yshift=-2.75cm]current page.north west)
                };
                
                \draw plot [smooth, tension=1.2] coordinates {
                    ([yshift=-3cm]current page.north west)
                    ([xshift=\neo@pagex{600}, yshift=-4.5cm]current page.north west)
                    ([xshift=\neo@pagex{1500}, yshift=-1.75cm]current page.north west)
                    ([xshift=\paperwidth, yshift=-4.25cm]current page.north west)
                };
                
                \draw[secondaryColor, line width=1pt] plot [smooth, tension=1] coordinates {
                    ([yshift=-1.25cm]current page.north west)
                    ([xshift=\neo@pagex{400}, yshift=-2.75cm]current page.north west)
                    ([xshift=\neo@pagex{1000}, yshift=-0.75cm]current page.north west)
                    ([xshift=\paperwidth, yshift=-1.75cm]current page.north west)
                };
            \end{scope}
        \end{scope}

        \draw[backgroundColor, line width=3pt]
             (current page.west |- HeaderBottom) --
             (current page.east |- HeaderBottom);

    \end{scope}

  \end{tikzpicture}

  \neo@top@compensate

  \vspace*{\dimexpr \ht\neo@wave@headercontent + \dp\neo@wave@headercontent + \if@twocolumn 2cm \else 1cm\fi  \relax}
}

