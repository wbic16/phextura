                     Scale=\NotoDev@scale,
    %                 \Noto@color,
        			 ItalicFont = {NotoSansDevanagari-VariableFont_wdth,wght.ttf},
	                 FontFace = {b}{n}{Font = {NotoSansDevanagari-VariableFont_wdth,wght.ttf},Weight=600},
                     FontFace = {b}{it}{Font = {NotoSansDevanagari-VariableFont_wdth,wght.ttf},Weight=600}
                 ]{NotoSansDevanagari-VariableFont_wdth,wght.ttf}
	                \babelfont [#1]{tt}[%
    %		 		 %Renderer=OpenType,% % Marathi and Hindi may respond differently...
                     Scale=\NotoDev@scale,
    %                 \Noto@color,
        			 ItalicFont = {NotoSansDevanagari-VariableFont_wdth,wght.ttf},
	                 FontFace = {b}{n}{Font = {NotoSansDevanagari-VariableFont_wdth,wght.ttf},Weight=600},
                     FontFace = {b}{it}{Font = {NotoSansDevanagari-VariableFont_wdth,wght.ttf},Weight=600}
                 ]{NotoSansDevanagari-VariableFont_wdth,wght.ttf}

    		}
