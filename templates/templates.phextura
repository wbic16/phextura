  \cleardoublepage
  \int_incr:N \l__nwejm_author_int
  \prop_gput_if_not_in:Nxn \g__nwejm_authors_prop {author_\int_use:c {l__nwejm_author_int}} {#2}
  \IfNoValueF {#1}
  {
    \keys_set:nn { nwejm/authors } { #1 }
