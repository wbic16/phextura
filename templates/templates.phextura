  \def\appendixname{附录}%
  \def\indexname{索引}%
  \def\contentsname{目\quad 录}%
  \def\listfigurename{插图索引}%
  \def\listtablename{表格索引}%
  \def\hit@list@figure@table@name{插图和附表索引}%
