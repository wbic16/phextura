      \neo_set_if_empty:Nn \neoschool@exboxopacity     {0}
      \neo_set_if_empty:Nn \neoschool@codeboxopacity   {5}
      \neo_set_if_empty:Nn \neoschool@adboxopacity     {10}
      \neo_set_if_empty:Nn \neoschool@boxshape         {soft}
