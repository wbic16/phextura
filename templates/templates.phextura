\newcommand*{\idx@@heading}{%
  \ifidx@leveldown
    \expandafter\section
  \else
    \expandafter\chapter
  \fi*%
}
\newcommand*{\idx@@forcemark}[1]{%
  \ifidx@leveldown
    \addsecmark{#1}%
  \else
    \@mkdouble{\MakeMarkcase{#1}}%
