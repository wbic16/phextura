  \bookcover@partheight{\coverheight}
  \bookcover@xpos{\marklength+\bleedwidth+\flapwidth}
  \bookcover@partwidth{2\coverwidth+\flapwidth+2\wrapwidth+2\hingewidth+\spinewidth}}

