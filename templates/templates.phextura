\newcommand*{\KOMA@kav@remove}[3]{%
  \@ifundefined{scr@kav@KOMA.#1}{%
    \KOMA@internal@error\KOMA@kav@remove{#1}%
  }{%
    \begingroup
      \def\reserved@a{\endgroup\@namedef{scr@kav@KOMA.#1}{}}%
      \edef\reserved@b{\detokenize{{#2}{#3}}}%
