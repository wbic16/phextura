            \__ecnu_fn_symbol_xits:n { #1 }
          }
        \c__ecnu_fn_style_libertinus_tl
          {
            \fontspec { LibertinusSerif-Regular.otf }
            \__ecnu_fn_symbol_libertinus:n { #1 }
          }
      }
      { \int_use:N #1 }
  }
