\newcounter{udiss@langbabel}
\stepcounter{udiss@langbabel}
\def\udiss@int@langbabel#1{%
  \expandafter\edef
    \csname
      udiss@langbabel@\alph{udiss@langbabel}%
    \endcsname{#1}%
  \stepcounter{udiss@langbabel}%
}
\NewDocumentCommand\udiss@lgbbl{ >{ \SplitList{,} } m }{%
  \ProcessList{#1}{\udiss@int@langbabel}%
}
