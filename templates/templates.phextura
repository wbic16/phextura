\NewDocumentCommand \makefront { }
  {
    \restoregeometry
    \int_compare:nNnTF { \g__nwafu_thesis_type_int } < { 3 }
      { \__nwafu_makefront_graduate: }
      { \__nwafu_makefront_bachelor: }
