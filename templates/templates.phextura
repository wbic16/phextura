% ============================================================
% PHILOSOPHY OF PHYSICS
% Journal Document Class (CLS)
% ============================================================

%% philphys.cls
%% LaTeX class for Philosophy of Physics articles
%% Created by Bryan W Roberts
%% With code support from ChatGPT
%% And initial testing support from Alex Niederklapfer and Jim Weatherall
%%
%% VERSION 1.0.1 (2026-10-14)
%% Copyright 2026 Bryan W Roberts.
%% Distributed and/or modified under LPPL 1.3c or any later version.
%% Maintained by Bryan W Roberts; contact: philphyssociety@gmail.com.
%% See LICENSE.txt for the licence and the files constituting this LPPL work.
%%
%% Maintenance: geometry/typography lengths control the fixed title page and
%% asymmetric body column; pop@ifblindreview gates identifying output; natbib
%% settings control citation punctuation; poplastpagefooter uses the kernel's
%% last-page hook (rerun after pagination changes). Reference entry formatting
%% belongs to philphys.bst. See philphys-documentation.tex.
%% Requires LaTeX 2022-11-01 or newer and the packages listed below.
%%
%% Usage:
%%   \documentclass[blindreview]{philphys} % For journal submissions
%%
%%   \title{Article title}
%%   \poprunningauthor{Author surname}
%%   \popdoi{10.xxxx/xxxxx}
%%
%%   \popauthor{Name}{Affiliation}{0000-0000-0000-0000}
%%   \popauthor{Name}{Affiliation}{} % ORCID may be empty
%%
%%   \popabstract{Abstract text}
%%
%%   \popcorrespondingauthor{Name}
%%   \popcorrespondingauthoraddress{Postal address}
%%   \popcorrespondingauthoremail{name@example.com}
%%
%%   \poptocite{Citation text}
%%   \popsubmitted{Day Month Year}
%%   \popaccepted{Day Month Year}
%%   \poppublished{Day Month Year}
%%   \popcopyrightyear{Year}
%%
%%   \popacknowledgements{Acknowledgements text} % Optional
%%   \popcompetinginterests{Competing interests text}
%%
%%   \begin{document}
%%   \maketitle
%%
%%   Article text...
%%
%%   \popbackmatter
%%   \bibliographystyle{philphys}
%%   \bibliography{yourbibfile}
%%   \poplastpagefooter % Defined below; keep immediately before \end{document}
%%   \end{document}

% ============================================================
% CLASS DECLARATION AND BASE CLASS
% ============================================================
\NeedsTeXFormat{LaTeX2e}[2022-11-01]
\ProvidesClass{philphys}[2026/10/14 v1.0.1 Philosophy of Physics article class]

% Modes: manuscript is the default; blindreview suppresses article identity in
% manuscript mode; published supplies journal metadata and publication history.
% published takes precedence over manuscript/blindreview if combined. This is
% a production option: do not combine it with blindreview for submission.
% Anonymity covers class-generated identity only, not prose, references, images,
% PDF attachments, user-added metadata, or the source files sent to an editor.
\newif\ifpopmanuscript
\popmanuscripttrue

\newif\ifpopblindreview
\popblindreviewfalse

\DeclareOption{manuscript}{\popmanuscripttrue}
\DeclareOption{published}{\popmanuscriptfalse}
\DeclareOption{blindreview}{\popblindreviewtrue}

% Pass any other class options on to article.
\DeclareOption*{\PassOptionsToClass{\CurrentOption}{article}}
\ProcessOptions\relax
\ifpopmanuscript\else
  \ifpopblindreview
    \ClassWarningNoLine{philphys}{published overrides blindreview; author identity will be visible}
  \fi
\fi
\LoadClass[10pt]{article}

% ============================================================
% PACKAGE LOADING
% ============================================================
\RequirePackage[paperwidth=175mm,paperheight=250mm]{geometry}
\RequirePackage{calc}
\RequirePackage{ifthen}
\RequirePackage{xcolor} 
\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage[authoryear,round]{natbib}
\RequirePackage{adjustbox}
\RequirePackage{changepage}
\RequirePackage{etoolbox}
\RequirePackage{setspace}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage[rightcaption,wide]{sidecap}
\RequirePackage{zref-savepos} % Locate margin captions after float placement.
\RequirePackage{zref-abspage}
\RequirePackage{xstring}  % For testing whether ORCID fields are empty.
\RequirePackage{url}
\RequirePackage{booktabs} % For tabular style
\RequirePackage{enumitem} % Journal spacing and label fonts for ordinary lists.
% Hyperref is loaded at the end of the preamble to respect package load order.

% ============================================================
% FONTS AND GLOBAL DOCUMENT DEFAULTS
% ============================================================
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{stix2} % Journal text and math fonts; includes AMS symbols.

\raggedbottom
\singlespacing

% ============================================================
% COLOURS
% ============================================================
\definecolor{lsered}{HTML}{ED1C2E}
