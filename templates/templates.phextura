\def\TBecircacute{\^e\llap{\raise 0.3ex\hbox{\'{}\kern-0.4ex}}}%

\let\TBecircacutebuilt=\TBecircacute
\ifx\DeclareUnicodeCharacter\undefined\else
  \DeclareUnicodeCharacter{1EBF}{\TBecircacute} % for the literal character
\fi

\ifTBunicodeengine
  \AtBeginDocument{% in case a different font gets loaded
    % \iffontchar is from e-TeX; safe to use under Unicode engines.
    \iffontchar\font"1EBF
      % Use the font's version by default; perhaps we're using newcm or
      % another font that has the acute offset to the right.
      \def\TBecircacute{\char"1EBF }%
    \fi
  }%
\fi % (end TBunicodeengine)

\def\Thanh{H\`an~Th\TBecircacute~Th\`anh}%

\ExplSyntaxOn
\IfPDFManagementActiveT{
\AddToHook{cmd/Thanh/before}
 {
   \mode_leave_vertical:
   \tag_mc_end_push:
   % We could use ^^ notation with the UTF-8 bytes (no ^^^^ since that
   % doesn't work under pdftex). Maybe later.
   \tag_struct_begin:n {tag=Span,actualtext=Hàn~ Thế~ Thành}
   \tag_mc_begin:n{}
 }
\AddToHook{cmd/Thanh/after}
 {
   \tag_mc_end:
   \tag_struct_end:
   \tag_mc_begin_pop:n{}
 }
} % (end PDFManagementactiveT)
\ExplSyntaxOff

