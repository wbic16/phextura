\newenvironment{boxtext}[1][]
{\par\addvspace{12pt}\global\@boxenvpresenttrue\urlstyle{rm}\refstepcounter{boxnumcnt}%
\def\@xfloat##1[{\@ifnextchar{H}{\@float@HH{##1}[}{\@float@Hx{##1}[}}%% reinstate float.sty macro (over floatpag)
