      \KOMA@kav@remove{\KOMAClassFileName}{bibliography}{totoc}%
      \KOMA@kav@remove{\KOMAClassFileName}{bibliography}{numbered}%
      \KOMA@kav@add{\KOMAClassFileName}{bibliography}{numbered}%
