\cs_new:Nn \__ugentdocs_runwordcount: {
  \ShellEscape{texcount~-1~-sum~-merge~-q~\jobname.tex~>~\jobname.wc}
  \file_if_exist:nTF { \jobname.wc } {
    \file_get:nnN { \jobname.wc } { } \l_tmpa_tl
    \tl_to_str:N \l_tmpa_tl
    \xdef\@wordcount{\l_tmpa_tl}
  }{
    \gdef\@wordcount{?}
  }
}
