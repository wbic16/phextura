\@capbreakfalse
\ExplSyntaxOn
\NewDocumentCommand { \setcapindent } { s m }
  {
    \IfBooleanTF {#1}
      {
        \cs_set:Npe \cap@indent { \dim_eval:n { #2 } }
        \@capbreaktrue
      }
      {
        \cs_set:Npe \cap@indent { \dim_eval:n { #2 } }
        \@capbreakfalse
      }
    \dofullc@pfalse
    \__scrkernel_at_caption_package:n
      {
        \exp_args:No \msg_warning:nnee { \KOMAClassName }
          { using-caption }
          { \token_to_str:N\setcapindent\IfBooleanT{#1}*{#2} }
          {
            \token_to_str:N \captionsetup
              { indent=\ifdim\cap@indent<\z@\z@\else\cap@indent\fi }
          }
        \captionsetup { indent=\ifdim\cap@indent<\z@\z@\else\cap@indent\fi }
      }
  }
\ExplSyntaxOff
