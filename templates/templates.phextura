    \__ecnu_heading:nVV
      {
        \tl_if_eq:NnTF \l__ecnu_env_lang_tl { zh }
          { \sffamily } { \rmfamily }
        \bfseries \centering \zihao {-3}
      }
      \l__ecnu_tmpa_tl \l__ecnu_heading_contents_tl
