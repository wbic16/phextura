\lstdefinelanguage[hgb]{PHP}{
	morekeywords={__halt_compiler,abstract,and,array,as,break,callable,case,catch,class,clone,const,
		continue,declare,default,die,do,echo,else,elseif,empty,enddeclare,endfor,endforeach,endif,endswitch,
		endwhile,enum,eval,exit,extends,false,final,finally,fn,for,foreach,function,global,goto,if,
		implements,include,include_once,instanceof,insteadof,interface,isset,list,match,namespace,new,null,
		or,parent,print,private,protected,public,readonly,require,require_once,return,self,static,switch,
		throw,trait,true,try,unset,use,var,while,xor,yield,FALSE,NULL,TRUE,__CLASS__,__DIR__,__FILE__,
		__FUNCTION__,__LINE__,__METHOD__,__NAMESPACE__,__PROPERTY__,__TRAIT__,$this},
	morekeywords=[2]{bool,float,int,iterable,mixed,never,object,string,void},
	otherkeywords={<?php,<?=,?>},
	sensitive,
	morecomment=[l]//,
	morecomment=[s]{/*}{*/},
	morecomment=[l]\#,
	moredelim=[s][]{\#[}{]},
	morestring=[b]",
	morestring=[b]',
}[keywords,comments,strings]

% Python 3, based on the Python 3 dialect of listings (print is a built-in function, not a keyword)
\lstdefinelanguage[hgb]{Python}[3]{Python}{
	morekeywords=[2]{print},
}

% R, stand-alone definition (the definition of listings treats about 800 function names as keywords)
\lstdefinelanguage[hgb]{R}{
	morekeywords={break,else,FALSE,for,function,if,in,Inf,NA,NA_character_,NA_complex_,NA_integer_,NA_real_,
		NaN,next,NULL,repeat,return,TRUE,while},
	morekeywords=[2]{apply,data.frame,factor,is.na,lapply,length,library,list,matrix,mean,paste,paste0,
		print,require,sapply,seq,stop,sum,vapply,vector,warning},
	sensitive,
	alsoletter={.},
	alsoother={$},
	morecomment=[l]\#,
	morestring=[b]",
	morestring=[b]',
}[keywords,comments,strings]

% Rust (edition 2024); no character literals, since ' also starts lifetimes
\lstdefinelanguage{Rust}{
	morekeywords={as,async,await,break,const,continue,crate,dyn,else,enum,extern,false,fn,for,if,impl,in,let,
		loop,macro_rules,match,mod,move,mut,pub,ref,return,self,Self,static,struct,super,trait,true,type,
		unsafe,use,where,while},
	morekeywords=[2]{Arc,Box,BTreeMap,Cell,Err,HashMap,HashSet,None,Ok,Option,Rc,RefCell,Result,Some,String,
		Vec,bool,char,f32,f64,i8,i16,i32,i64,i128,isize,str,u8,u16,u32,u64,u128,usize},
	sensitive,
	morecomment=[l]//,
	morecomment=[n]{/*}{*/},
	morestring=[b]",
}[keywords,comments,strings]

% Scala 3, based on the Scala 3 dialect of listings
\lstdefinelanguage[hgb]{Scala}[3.0]{Scala}{
	morekeywords={then,using},
}

% SQL, based on the SQL definition of listings (SQL-92), with keywords and types of current database systems
\lstdefinelanguage[hgb]{SQL}[]{SQL}{
	morekeywords={AUTO_INCREMENT,CALL,CONFLICT,DATABASE,DECLARE,DO,EXPLAIN,FETCH,FILTER,FOR,FUNCTION,IF,
		ILIKE,IS,LATERAL,MATCHED,MERGE,NOTHING,OF,OFFSET,OVER,PARTITION,PROCEDURE,REFERENCES,REPLACE,RETURNING,
		RETURNS,SCHEMA,SEQUENCE,TO,TRUNCATE,WINDOW,WITH},
	morekeywords=[2]{BIGINT,BIGSERIAL,BOOL,BOOLEAN,BYTEA,DATETIME,DOUBLE,JSON,JSONB,PRECISION,REAL,SERIAL,
		TEXT,TINYINT,UUID},
}

% Swift 6, stand-alone definition
\lstdefinelanguage[hgb]{Swift}{
	morekeywords={actor,any,Any,as,associatedtype,async,await,borrowing,break,case,catch,class,consuming,
		continue,convenience,default,defer,deinit,didSet,do,dynamic,else,enum,extension,fallthrough,false,
		fileprivate,final,for,func,get,guard,if,import,in,indirect,init,inout,internal,is,lazy,let,macro,
		mutating,nil,nonisolated,nonmutating,open,operator,optional,override,package,precedencegroup,private,
		protocol,public,repeat,required,rethrows,return,self,Self,set,some,static,struct,subscript,super,
		switch,throw,throws,true,try,typealias,unowned,var,weak,where,while,willSet},
	morekeywords=[2]{Array,Bool,Character,Dictionary,Double,Float,Int,Int8,Int16,Int32,Int64,Never,
		Optional,Result,Set,String,UInt,UInt8,UInt16,UInt32,UInt64,Void,@available,@Binding,
		@discardableResult,@Environment,@escaping,@main,@MainActor,@objc,@Observable,@Published,@Sendable,
		@State},
	sensitive,
	morecomment=[l]//,
	morecomment=[n]{/*}{*/},
	morestring=[s]{"""}{"""},
	morestring=[b]",
	moredelim=*[directive]\#,
	moredirectives={available,colorLiteral,else,elseif,endif,fileLiteral,if,imageLiteral,keyPath,selector,
		sourceLocation,unavailable},
}[keywords,comments,strings,directives]

% TypeScript 5, based on JavaScript
\lstdefinelanguage{TypeScript}[]{JavaScript}{
	morekeywords={abstract,accessor,asserts,declare,enum,implements,infer,interface,is,keyof,namespace,
		override,private,protected,public,readonly,satisfies,type,unique},
	morekeywords=[2]{any,bigint,boolean,never,number,object,string,symbol,unknown,Awaited,Exclude,Extract,
		NonNullable,Omit,Partial,Pick,Readonly,Record,Required,ReturnType},
}

% XML, based on the XML definition of listings; all element names are keywords (instead of only those that
% are also keywords of XML, e.g., version)
\lstdefinelanguage[hgb]{XML}[]{XML}{
	markfirstintag=true,
}

% YAML 1.2; only double-quoted strings, since listings continues unterminated strings on the next line and
% apostrophes are common in unquoted values (e.g., name: Don't fail)
\lstdefinelanguage{YAML}{
	morekeywords={false,null,true},
	sensitive=false,
	morecomment=[l]\#,
	morestring=[b]",
}

\lstset{
	defaultdialect=[hgb]bash,
	defaultdialect=[hgb]C,
	defaultdialect=[hgb]C++,
	defaultdialect=[hgb]Go,
	defaultdialect=[hgb]Java,
	defaultdialect=[hgb]Matlab,
	defaultdialect=[hgb]PHP,
	defaultdialect=[hgb]Python,
	defaultdialect=[hgb]R,
	defaultdialect=[hgb]Swift,
}
% Not possible for dialects based on a language without dialect (HTML, Scala, SQL, XML), since the empty base
% dialect would then refer to the default dialect itself; these are selected explicitly in the environments.

%% Code environments -----------------------------------------------------------

% \hgb@NewCodeEnvironment{<environment>}{<language>}: code environment for the given language, with
% LaTeX escapes between /+ and +/ (e.g., for labels of lines), options as optional argument
\newcommand{\hgb@NewCodeEnvironment}[2]{%
	\lstnewenvironment{#1}[1][]{\lstset{language={#2},escapeinside={/+}{+/},##1}}{}%
}

\hgb@NewCodeEnvironment{BashCode}{bash}			% Bash
\hgb@NewCodeEnvironment{CCode}{C}				% C (C23)
\hgb@NewCodeEnvironment{CppCode}{C++}			% C++ (C++23)
\hgb@NewCodeEnvironment{CsCode}{CSharp}			% C#
\hgb@NewCodeEnvironment{CssCode}{CSS}			% CSS
\hgb@NewCodeEnvironment{DartCode}{Dart}			% Dart
\hgb@NewCodeEnvironment{GlslCode}{GLSL}			% GLSL
\hgb@NewCodeEnvironment{GoCode}{Go}				% Go
\hgb@NewCodeEnvironment{HtmlCode}{[hgb]HTML}	% HTML5
\hgb@NewCodeEnvironment{JavaCode}{Java}			% Java
\hgb@NewCodeEnvironment{JsCode}{JavaScript}		% JavaScript
\hgb@NewCodeEnvironment{JsonCode}{JSON}			% JSON
\hgb@NewCodeEnvironment{KotlinCode}{Kotlin}		% Kotlin
\hgb@NewCodeEnvironment{LaTeXCode}{[hgb]TeX}	% LaTeX
\hgb@NewCodeEnvironment{MatlabCode}{Matlab}		% MATLAB
\hgb@NewCodeEnvironment{ObjCCode}{ObjectiveC}	% Objective-C
\hgb@NewCodeEnvironment{PhpCode}{PHP}			% PHP
\hgb@NewCodeEnvironment{PythonCode}{Python}		% Python 3
\hgb@NewCodeEnvironment{RCode}{R}				% R
\hgb@NewCodeEnvironment{RustCode}{Rust}			% Rust
\hgb@NewCodeEnvironment{ScalaCode}{[hgb]Scala}	% Scala 3
\hgb@NewCodeEnvironment{SqlCode}{[hgb]SQL}		% SQL
\hgb@NewCodeEnvironment{SwiftCode}{Swift}		% Swift
\hgb@NewCodeEnvironment{TsCode}{TypeScript}		% TypeScript
\hgb@NewCodeEnvironment{XmlCode}{[hgb]XML}		% XML
\hgb@NewCodeEnvironment{YamlCode}{YAML}			% YAML

% Code environment for generic code (no language, no escapes)
\lstnewenvironment{GenericCode}[1][]
{\lstset{%
	language={},
	keepspaces=true,
	commentstyle={},
	texcl=false,
	escapechar={},
	escapeinside={},
	#1}}
{}


% Disable the lstlisting environment (due to popular abuse)
\newcommand{\@WarnLstlisting}{
\GenericError{}{Package hgblistings Error: The 'lstlisting' environment is disabled}%
{See the error note inserted in the document output for details.}{}%
\begin{quote}
\color{red}\textbf{NOTE:} The \texttt{lstlisting} environment has been deliberately disabled in this setup.
Use \emph{inline code} (breakable and \emph{without} a caption) or create a \emph{float container} with
\texttt{{\textbackslash}begin\{program\} \ldots {\textbackslash}end\{program\}} instead!
See the \texttt{hgbthesis} tutorial for examples.
\end{quote}%
}
\renewenvironment{lstlisting}[0]%
{\@WarnLstlisting\expandafter\comment}%
{\expandafter\endcomment}%
%% hgbmath.sty
%% This file is part of the Hagenberg Thesis package for creating bachelors's and masters's theses
%% Author: Wilhelm Burger (wilbur@ieee.org)
%% GitHub: https://github.com/Digital-Media/HagenbergThesis
%% File encoding: ASCII

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hgbmath}[2026/10/22]%%AUTO

\RequirePackage{amsmath,amsfonts,amssymb,amsbsy}
\RequirePackage{subdepth}			% for positioning of sub and super scripts
\RequirePackage{exscale}			% correct scaling of math mode output in every environment

% Commands for real, complex, etc. numbers (AMS Blackboard)
\newcommand{\R}{\ensuremath{\mathbb{R}}}
\newcommand{\Z}{\ensuremath{\mathbb{Z}}}
\newcommand{\N}{\ensuremath{\mathbb{N}}}
%\newcommand{\C}{\mathbb{C}} % utf8-change (problem with T1 encoding)
\newcommand{\Cpx}{\ensuremath{\mathbb{C}}}	% utf8-change
\newcommand{\Q}{\ensuremath{\mathbb{Q}}}
%% hgbvars.sty
%% This file is part of the Hagenberg Thesis package for creating bachelors's and masters's theses,
%% defining a set of macros/variables available to other sub-packages.
%% Author: Wilhelm Burger (wilbur@ieee.org)
%% GitHub: https://github.com/Digital-Media/HagenbergThesis
%% File encoding: UTF-8

\ProvidesPackage{hgbvars}[2026/10/22]%%AUTO

\newcommand{\hgb@Author}{UNDEFINED}
\newcommand{\hgb@Title}{UNDEFINED}% derived from \title (initialized in \maketitle hook)
\newcommand{\hgb@SubTitle}{}
\newcommand{\hgb@FullTitle}{}

\newcommand{\hgb@Institution}{\@MissingArg{Name of institution not specified!}}
\newcommand{\hgb@ProgramType}{\@MissingArg{Type of degree program not specified!}}
\newcommand{\hgb@ProgramName}{\@MissingArg{Name of degree program not specified!}}
\newcommand{\hgb@AcademicDegree}{}%	optional, shown on the title page if not empty
\newcommand{\hgb@PlaceOfStudy}{\@MissingArg{Place of study not specified!}}

\newcommand{\hgb@ThesisType}{master}%	type of thesis (default: master)
\newcommand{\hgb@ThesisName}{}%
					
\newcommand{\hgb@MainLanguage}{english}%	the main language for this document:
\newcommand{\hgb@TitleLanguage}{}%	the language to be used for the front pages (empty = main language, set in hgb.sty)

\newcommand{\hgb@License}{cclicense}%	default license (see \license in hgbthesis.cls)

\newcommand{\hgb@CompanyName}{\@MissingArg{Company not specified!}}
\newcommand{\hgb@CompanyUrl}{\@MissingArg{Company URL not specified!}}

\newcommand{\hgb@LogoFile}{@unspecified} 

\newcommand{\hgb@TitlePageFont}{}

%% Booleans and class option helpers shared across cls/sty files.
%% Declared here (not in hgb.sty) so they are available before \LoadClass.
%% hgb.sty re-declares them with \providecommand / no re-declaration needed.
%% Note: hgb@UpdateCheck=true means the check IS performed (positive naming, like titlepage).
\RequirePackage{xifthen}
\newboolean{hgb@SmartQuotesOn}
\setboolean{hgb@SmartQuotesOn}{false}	% smart quotes are turned off by default
\newboolean{hgb@UpdateCheck}
\setboolean{hgb@UpdateCheck}{true}	% update check is performed by default

% Register a permissible key=value option pair.
% Usage: \@RegisterClassOption{type}{master}
\newcommand{\@RegisterClassOption}[2]{%
  \expandafter\def\csname hgb@keyvalueoption-#1-#2\endcsname{\relax}%
}

% Validate a key=value option pair; \ClassError shows the actual calling class name.
% Usage: \@ValidateClassOption{type}{master}
\newcommand{\@ValidateClassOption}[2]{%
  \ifcsname hgb@keyvalueoption-#1-#2\endcsname%
    {}%
  \else\ClassError{\@currname}{illegal key/value option: #1=#2}\relax%
  \fi%
}

% Warn about a deprecated class option; \ClassWarning shows the actual calling class name.
% Usage: \@WarnDeprecatedOption{english}{language=english}
\newcommand{\@WarnDeprecatedOption}[2]{%
  \ClassWarning{\@currname}{option '#1' is deprecated, use '#2' instead!}%
}
