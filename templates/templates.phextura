  {
    \clist_map_inline:nn
      {
        { supervisor  } { 指导教师   } { Supervisor },
        { anonid      } { ********** } { ********** },
        { anonname    } { ********** } { ********** },
        { anonhead    } { ********** } { ********** },
        { bib_en      } { 参考文献   } { Bibliography },
