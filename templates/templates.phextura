\NeedsTeXFormat{LaTeX2e}[1995/12/01]
\ProvidesClass{lps}[2011/01/01 v0.7%
                    LaTeX document class for the L&PS journal]
\LoadClass[11pt,twoside,onecolumn]{article}
\RequirePackage{mathptmx}
\RequirePackage{geometry}
