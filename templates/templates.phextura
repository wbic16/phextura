      .. controls (125.13,38.55) and (124.54,36.67) .. (124.54,34.66)
      -- (131.88,34.66)
      .. controls (131.98,36.44) and (132.66,37.82) .. (133.90,38.78)
      .. controls (135.14,39.74) and (136.79,40.23) .. (138.84,40.23)
      .. controls (140.89,40.23) and (142.34,39.85) .. (143.38,39.10)
      .. controls (144.42,38.34) and (144.93,37.35) .. (144.93,36.13)
      -- cycle;
  \end{scope}
\end{tikzpicture}%
}

% Article type label.
% Published articles say RESEARCH; manuscripts say UNPUBLISHED MANUSCRIPT; and blind review manuscripts say UNPUBLISHED MANUSCRIPT FOR REVIEW.
\newcommand{\popResearchLabel}{%
  \begingroup
    \normalfont
    \bfseries
    \fontsize{\popResearchFontSize}%
             {\popResearchBaselineSkip}\selectfont
    \pop@ifblindreview{%
      \shortstack[l]{UNPUBLISHED\\[1.5mm]MANUSCRIPT\\[1.5mm]FOR REVIEW}%
    }{%
      \ifpopmanuscript
        \shortstack[l]{UNPUBLISHED\\[1.5mm]MANUSCRIPT}%
      \else
        RESEARCH%
      \fi
    }%
  \endgroup
}

% ============================================================
% TITLE PAGE: MEASUREMENTS
% ============================================================
% Publisher page size: 175mm x 250mm (approximately 496 x 709 PDF points).
% Geometry follows the measured coloured blocks and asymmetric text column.
% Individual font sizes follow the publisher PDFs rather than a uniform scale.

\newlength{\popTitleBlockLeftMargin}
\newlength{\popTitleBoxWidth}
\newlength{\popTitleBoxHeight}

\newlength{\popTitlePadLeft}
\newlength{\popTitlePadRight}
\newlength{\popTitlePadTop}
\newlength{\popTitlePadBottom}

\newlength{\popTitleLockWidth}
\newlength{\popTitleLockTopPad}

\newlength{\popAbstractBoxLeft}
\newlength{\popAbstractBoxWidth}
\newlength{\popAbstractPadLeft}
\newlength{\popAbstractPadRight}
\newlength{\popAbstractPadTop}
\newlength{\popAbstractPadBottom}
\newlength{\popAbstractTextWidth}
\newlength{\popAbstractHeadingFontSize}
\newlength{\popAbstractHeadingBaselineSkip}
\newlength{\popAbstractBodyFontSize}
\newlength{\popAbstractBodyBaselineSkip}
\newlength{\popAbstractHeadingGap}
\newlength{\popTextRightIndent}

% Lengths for the Article Info column to the right of the abstract block.
\newlength{\popArticleInfoGap}
\newlength{\popArticleInfoWidth}
\newlength{\popArticleInfoTopPad}
\newlength{\popArticleInfoBottomPad}
\newlength{\popArticleInfoFontSize}
\newlength{\popArticleInfoBaselineSkip}
\newlength{\popArticleInfoNameGap}
\newlength{\popArticleInfoRuleGap}
\newlength{\popArticleInfoRuleThickness}

% Journal logo lengths.
\newlength{\popJournalLogoX}
\newlength{\popJournalLogoY}
\newlength{\popJournalLogoWidth}
\newlength{\popJournalLogoFontSize}
\newlength{\popJournalLogoBaselineSkip}
\newlength{\popJournalLogoBarGap}
\newcommand{\popJournalLogoBarScale}{1.1} % Command, not length, for insertion in TikZ.

% Article Type ('RESEARCH') lengths.
\newlength{\popResearchX}
\newlength{\popResearchY}
\newlength{\popResearchFontSize}
\newlength{\popResearchBaselineSkip}

\newlength{\popTitleFontSize}
\newlength{\popTitleBaselineSkip}

\newlength{\popAuthorX}
\newlength{\popAuthorGapBelowTitle}
\newlength{\popAuthorFontSize}
\newlength{\popAuthorLineGap}
\newlength{\popAuthorWordSpace}
\newlength{\popOrcidGap}
\newlength{\popAuthorBlockWidth}

% Lengths for the Title Block, i.e. the blue rectangle and associated structures.
\setlength{\popTitleBlockLeftMargin}{14.833333mm}
\setlength{\popTitleBoxWidth}{106.916667mm}      
\setlength{\popTitleBoxHeight}{87.833333mm}     

\setlength{\popTitlePadLeft}{6mm}         
\setlength{\popTitlePadRight}{9.25mm}        
\setlength{\popTitlePadTop}{10.25mm}         
\setlength{\popTitlePadBottom}{2.666667mm}       

\setlength{\popTitleLockWidth}{8.5mm}      
\setlength{\popTitleLockTopPad}{11.666667mm}

% Lengths for the Abstract Block, i.e. the grey rectangle below.
\setlength{\popTextRightIndent}{0cm}
\setlength{\popAbstractBoxLeft}{14.833333mm}
\setlength{\popAbstractBoxWidth}{106.916667mm}
\setlength{\popAbstractPadLeft}{5.666667mm}
\setlength{\popAbstractPadTop}{6.083333mm}
\setlength{\popAbstractPadRight}{5.666667mm}
\setlength{\popAbstractPadBottom}{14.833333mm}
\setlength{\popAbstractTextWidth}{%
  \dimexpr
    \popAbstractBoxWidth
    - \popAbstractPadLeft
    - \popAbstractPadRight
  \relax
}

% Lengths for the Article Info Column.
\setlength{\popArticleInfoGap}{7.409167mm}
\setlength{\popArticleInfoWidth}{31.048333mm}
\setlength{\popArticleInfoTopPad}{6mm}
\setlength{\popArticleInfoBottomPad}{14.833333mm}
\setlength{\popArticleInfoFontSize}{7pt}
\setlength{\popArticleInfoBaselineSkip}{10pt}
\setlength{\popArticleInfoNameGap}{1.25mm}
\setlength{\popArticleInfoRuleGap}{4mm}
\setlength{\popArticleInfoRuleThickness}{0.705833mm}

% PoP Journal Logo lengths: coloured bars and text.
\setlength{\popJournalLogoX}{129.166667mm}
\setlength{\popJournalLogoY}{4.166667mm}
\setlength{\popJournalLogoWidth}{30.833333mm}
\setlength{\popJournalLogoFontSize}{10pt}
\setlength{\popJournalLogoBaselineSkip}{0pt}
\setlength{\popJournalLogoBarGap}{0.833333mm}
\renewcommand{\popJournalLogoBarScale}{3.333333}

% Article Type ('RESEARCH') lengths.
\setlength{\popResearchX}{129.166667mm}
\setlength{\popResearchFontSize}{9.5pt}
\setlength{\popResearchBaselineSkip}{12.5pt}
\setlength{\popResearchY}{%
  \dimexpr
    \popTitleBoxHeight
    - 6mm % Research-label position is independent of title-text padding.
  \relax
}

% Abstract typography.
\setlength{\popAbstractHeadingFontSize}{12pt}
\setlength{\popAbstractHeadingBaselineSkip}{0pt}
\setlength{\popAbstractBodyFontSize}{8pt}
\setlength{\popAbstractBodyBaselineSkip}{12.5pt}
\setlength{\popAbstractHeadingGap}{2.5mm}

% Author position.
% Author position rescaled to the publisher page dimensions.
\setlength{\popAuthorX}{21.169167mm}
\setlength{\popAuthorGapBelowTitle}{7mm}

% Author typography.
\setlength{\popAuthorFontSize}{10pt}
\setlength{\popAuthorLineGap}{2.5mm}
\setlength{\popAuthorWordSpace}{1.5mm}
\setlength{\popOrcidGap}{1mm}
\setlength{\popAuthorBlockWidth}{91.666667mm}

% Title font and line height.
\setlength{\popTitleFontSize}{23pt}
\setlength{\popTitleBaselineSkip}{28pt}

% ============================================================
% TITLE PAGE: COMPONENTS
% ============================================================

% Author-list typesetting.
\newcommand{\pop@printauthor}[2]{%
  \begingroup
    % Author names use the same main font family as the title.
    % They are bold and uppercased to match the journal style.
    \fontsize{\popAuthorFontSize}{1.2\popAuthorFontSize}\selectfont
    \bfseries

    % Widen spacing between words in author names if needed.
    \spaceskip=\popAuthorWordSpace
    \xspaceskip=\popAuthorWordSpace

    % Keep the author name and its ORCID icon together on one line.
    % This prevents TeX from breaking the line between the name and
    % the icon inside the fixed-width title-page author block.
    \mbox{%
      \MakeUppercase{#1}%
      \IfStrEq{#2}{}{}{% 
        \hspace{\popOrcidGap}%
        \href{https://orcid.org/#2}{\popORCIDicon}%
      }%
    }%
  \endgroup
}

% Print the full author block.
% If \popauthor has been used, this prints all stored authors.
% Otherwise it falls back to standard \author (without an ORCID).
% Use \popauthor to obtain affiliations and published PDF author metadata.
\newcommand{\pop@authorblockcontents}{%
  \ifnum\value{popauthorcount}>0
    \@popauthorlist
    \ifnum\value{popauthorcount}>1
      % This affiliation note appears only for multi-author papers.
      % It is 7.5pt and normal weight, following the supplied examples.
      {\fontsize{7.5pt}{9.166667pt}\selectfont
       \normalfont
       \textsuperscript{*}Author affiliations can be found in the back matter of this article\par}%
    \fi
  \else
    % Backwards-compatible single-author fallback.
    \pop@printauthor{\@author}{\@poporcid}%
  \fi
}

% Print one author-affiliation entry for the backmatter.
% Author name is bold, but not uppercased. The ORCID icon and
% printed ORCID link are kept together with the name whenever possible.
\newcommand{\pop@printauthoraffiliation}[3]{%
  \begingroup
    \normalfont
    \fontsize{8pt}{\the\popBodyBaselineSkip}\selectfont
    \setlength{\parindent}{0pt}%
    \setlength{\parskip}{0pt}%

    \leavevmode
    \textbf{#1}%
    \IfStrEq{#3}{}{}{%
      \nobreak\hspace{\popOrcidGap}%
      \mbox{%
        \href{https://orcid.org/#3}{\popORCIDicon}%
        \hspace{0.4em}%
        \href{https://orcid.org/#3}{orcid.org/#3}%
      }%
    }%
    \par
    #2\par
  \endgroup
  \par\addvspace{\popAuthorAffiliationEntryGap}%
}

\newcommand{\popTitleBlock}{%
  % Draw at shipout in page-local coordinates, without saved TikZ positions.
  % This keeps the title page correct on the first run and after mode changes.
  \AddToHookNext{shipout/foreground}{%
    \put(0,0){%
    \begin{tikzpicture}[overlay]
      \node[anchor=north west,inner sep=0pt,outer sep=0pt,
            minimum width=\paperwidth,minimum height=\paperheight]
        (popTitlePage) at (0,0) {};

    % Main blue title box.
    \node[
      anchor=north west,
      minimum width=\popTitleBoxWidth,
      minimum height=\popTitleBoxHeight,
      draw=none,
      fill=popDark,
      inner sep=0pt
    ] (titlebox) at
      ([xshift=\popTitleBlockLeftMargin]popTitlePage.north west) {};

    % White Open Access icon in the title box.
    \node[
      anchor=north east,
      inner sep=0pt
    ] (oa) at
      ([xshift=-6.25mm,
        yshift=-\popTitleLockTopPad]titlebox.north east)
      {\popOAwhite{\popTitleLockWidth}};

    % Article title text.
    \node[
      anchor=south west,
      inner sep=0pt,
      align=left
    ] (titletext) at
      ([xshift=\popTitlePadLeft,
        yshift=\popTitlePadBottom]titlebox.south west)
      {%
        \parbox{\dimexpr
          \popTitleBoxWidth
          -\popTitlePadLeft
          -\popTitlePadRight
        \relax}{%
          \raggedright
          \fontsize{\the\popTitleFontSize}{\the\popTitleBaselineSkip}\selectfont
          % A fixed final-line depth keeps the baseline independent of whether
          % the final word contains a descender (e.g. Equivalence/Cosmology).
          \textcolor{white}{\@title\rule[-5pt]{0pt}{5pt}}\par
        }%
      };

    % Author name.
    % Hidden in blind-review manuscript mode.
    \pop@ifblindreview{}{%
      \node[
        anchor=north west,
        inner sep=0pt,
        text width=\popAuthorBlockWidth,
        align=left
      ] (author) at
        ([xshift=\popAuthorX,
          yshift={-\dimexpr\popTitleBoxHeight+\popAuthorGapBelowTitle\relax}]
         popTitlePage.north west)
        {\pop@authorblockcontents};
    }%

    % Philosophy of Physics journal logo.
    \node[
      anchor=north west,
      inner sep=0pt
    ] (journal-logo) at
      ([xshift=\popJournalLogoX,
        yshift=-\popJournalLogoY]
       popTitlePage.north west)
      {\popJournalLogo};

    % Article type label: RESEARCH.
    \node[
      anchor=base west,
      inner sep=0pt
    ] (research-label) at
      ([xshift=\popResearchX,
        yshift=-\popResearchY]
       popTitlePage.north west)
      {\popResearchLabel};

    % LSE Press logo.
    \node[
      anchor=north west,
      inner sep=0pt
    ] (lse-press-logo) at
      ([xshift=\popResearchX,
        yshift={-\dimexpr\popTitleBoxHeight+\popAuthorGapBelowTitle\relax}]
       popTitlePage.north west)
      {\LSEPressLogo[0.08]};
      
  \end{tikzpicture}%
    }%
  }%

  % The title page graphics are overlaid and therefore take up no
  % normal vertical space. This reserves space so that later material
  % begins below the title box.
  \vspace*{\dimexpr\popTitleBoxHeight-\popTopMargin\relax}%
}

% Abstract block + Article Info Column.
\newsavebox{\popAbstractContentBox}
\newsavebox{\popArticleInfoBox}
\newlength{\popAbstractContentHeight}
\newlength{\popArticleInfoHeight}
\newlength{\popAbstractFinalHeight}

\newcommand{\popAbstractBlock}{%
  % First build the abstract content in a box so we can measure it.
  \sbox{\popAbstractContentBox}{%
    \parbox{\popAbstractTextWidth}{%
      {\fontsize{\the\popAbstractHeadingFontSize}
        {\the\popAbstractHeadingBaselineSkip}
        \selectfont
        \bfseries
        ABSTRACT\par}%
      \vspace{\popAbstractHeadingGap}%
      {\fontsize{\the\popAbstractBodyFontSize}
        {\the\popAbstractBodyBaselineSkip}
        \selectfont
        \@popabstract\par}%
    }%
  }%

  % Build the Article Info Column in a box so its height can also
  % be measured. The abstract grey box will then grow if this column
  % is taller than the abstract text.
  \pop@ifblindreview{\sbox{\popArticleInfoBox}{}}{%
  \sbox{\popArticleInfoBox}{%
    \parbox{\popArticleInfoWidth}{%
      \fontsize{\popArticleInfoFontSize}{\popArticleInfoBaselineSkip}\selectfont
      \raggedright

      \textbf{CORRESPONDING AUTHOR:}\par

      \vspace{\popArticleInfoNameGap}%
      \textbf{\@popcorrespondingauthor}\par
      \vspace{\popArticleInfoNameGap}%

      \@popcorrespondingauthoraddress\par
      \vspace{\popArticleInfoNameGap}%

      \href{mailto:\@popcorrespondingauthoremail}{\@popcorrespondingauthoremail}\par

      \vspace{\popArticleInfoRuleGap}%
      \noindent\rule{\popArticleInfoWidth}{\popArticleInfoRuleThickness}\par
      \vspace{\popArticleInfoRuleGap}%

      \textbf{TO CITE THIS ARTICLE:}\par
      \@poptocite\par
    }%
  }%

  }% End non-blind article-info construction.

  % Measure total required heights.
  \setlength{\popAbstractContentHeight}{%
    \dimexpr
      \ht\popAbstractContentBox
      + \dp\popAbstractContentBox
      + \popAbstractPadTop
      + \popAbstractPadBottom
    \relax
  }%

  % Total height needed by the Article Info Column.
  % We include both top and bottom padding so that, when this column is taller than the abstract text, the grey block grows enough to leave visible space below the column as well.
  % The column in its entirety is hidden in blind-review mode.
  \pop@ifblindreview{%
    \setlength{\popArticleInfoHeight}{0pt}%
  }{%
    \setlength{\popArticleInfoHeight}{%
      \dimexpr
        \ht\popArticleInfoBox
        + \dp\popArticleInfoBox
        + \popArticleInfoTopPad
        + \popArticleInfoBottomPad
      \relax
    }%
  }%

  % Choose the larger height, so the grey abstract block grows
  % whenever the Article Info Column is taller than the abstract.
  \setlength{\popAbstractFinalHeight}{\popAbstractContentHeight}%
  \ifdim\popArticleInfoHeight>\popAbstractFinalHeight
    \setlength{\popAbstractFinalHeight}{\popArticleInfoHeight}%
  \fi

  % Draw at shipout in page-local coordinates, without saved TikZ positions.
  % This keeps the title page correct on the first run and after mode changes.
  \AddToHookNext{shipout/foreground}{%
    \put(0,0){%
    \begin{tikzpicture}[overlay]
      \node[anchor=north west,inner sep=0pt,outer sep=0pt,
            minimum width=\paperwidth,minimum height=\paperheight]
        (popTitlePage) at (0,0) {};

    % Grey abstract rectangle.
    % Its height is measured dynamically from the larger of:
    %   • abstract text + padding
    %   • Article Info Column + top and bottom padding
    \node[
      anchor=south west,
      inner sep=0pt,
      draw=none,
      fill=popAbstractGrey,
      minimum width=\popAbstractBoxWidth,
      minimum height=\popAbstractFinalHeight
    ] (abstractbox) at
      ([xshift=\popAbstractBoxLeft]popTitlePage.south west) {};

    % Abstract content inside the grey box.
    \node[
      anchor=north west,
      inner sep=0pt
    ] at
      ([xshift=\popAbstractPadLeft,
        yshift=-\popAbstractPadTop]abstractbox.north west)
      {\usebox{\popAbstractContentBox}};

    % Article Info Column.
    % Hidden in blind-review manuscript mode.
    \pop@ifblindreview{}{%
      \node[
        anchor=north west,
        inner sep=0pt
      ] at
        ([xshift=\popArticleInfoGap,
          yshift=-\popArticleInfoTopPad]abstractbox.north east)
        {\usebox{\popArticleInfoBox}};
    }%

  \end{tikzpicture}%
    }%
  }%
}

% ============================================================
% MAIN BODY STYLE
% ============================================================

% Body-text paragraph style.
% The article body uses the measured 8pt size, with explicit
% controls for line height and paragraph spacing.
\newlength{\popBodyBaselineSkip}
\newlength{\popBodyParagraphGap}
\setlength{\popBodyBaselineSkip}{12.5pt} % Adjustable body line height.
\setlength{\popBodyParagraphGap}{6.666667pt}  % Adjustable gap between paragraphs.
% Apply body paragraph settings. This is called after the title page, not at \AtBeginDocument, so it does not interfere with title-page typography.
\newcommand{\popApplyBodyTextStyle}{%
  \fontsize{8pt}{\the\popBodyBaselineSkip}\selectfont
  \setlength{\parindent}{0pt}%
  \setlength{\parskip}{\popBodyParagraphGap}%
}

% Itemised and enumerated lists: use the ordinary environments, without
% manual spacing or bold commands. Items and paragraphs within an item follow
% the current line spacing, with no extra vertical gap. The journal examples
% reviewed during development have about 9pt of extra space above and below
% each list. LaTeX already adds the surrounding paragraph's \parskip, so the
% outermost list adds only 2.333333pt to the 6.666667pt body paragraph gap.
% Zero partopsep makes this independent of blank lines in the author's source.
% Nested lists add no surrounding gap. Preserve the standard labels and
% indentation; these settings do not change descriptions or the bibliography.
\newlength{\popListTopSep}
\setlength{\popListTopSep}{2.333333pt} % Added to the surrounding paragraph gap.
\setlist[itemize,enumerate]{itemsep=0pt,parsep=0pt,topsep=0pt,partopsep=0pt}
\setlist[itemize,enumerate,1]{topsep=\popListTopSep}
% Only enumeration labels are bold; item text and \ref values keep their
% surrounding font. This also covers nested labels and explicit \item[label].
\setlist*[enumerate]{font=\bfseries}

% Section headings.
\titleformat{\section}
  {\Large\bfseries\uppercase}
  {\thesection \;}
  {0.25em}
  {}

\titleformat{\subsection}
  {\large\bfseries\uppercase}
  {\thesubsection \;}
  {0.25em}
  {}

\titlespacing*{\section}{0pt}{4.166667mm}{0mm}
\titlespacing*{\subsection}{0pt}{2.083333mm}{0mm}

% Footnote style.
\newlength{\popFootnoteFontSize}
\newlength{\popFootnoteBaselineSkip}
\newlength{\popFootnoteNumberGap}
\newlength{\popFootnoteItemGap}

\setlength{\popFootnoteFontSize}{7pt}       % Adjustable footnote font size.
\setlength{\popFootnoteBaselineSkip}{8.5pt}  % Adjustable footnote line height.
\setlength{\popFootnoteNumberGap}{2em}    % Gap after footnote number.
\setlength{\popFootnoteItemGap}{5pt}        % Gap between separate footnotes.

% Space between the main text and the footnote block.
\setlength{\skip\footins}{6.666667pt plus 1.666667pt minus 0.833333pt}

% Keep LaTeX's own inter-footnote mechanism neutral, and add the visible gap directly in \@makefntext below.
\setlength{\footnotesep}{0pt}

% Remove the default footnote rule and replace with a custom one that spans the page
\renewcommand{\footnoterule}{%
  \kern -1pt
  \hrule width \columnwidth height 0.5pt
  \kern 2.6pt
}

% Footnote marker in the body text.
\renewcommand{\@makefnmark}{%
  \textsuperscript{\@thefnmark}%
}

% Footnote text at the bottom of the page. The label uses the note-text size,
% not superscript, followed by an adjustable gap before the note text.
\renewcommand{\@makefntext}[1]{%
  \vspace{\popFootnoteItemGap}%
  \begingroup
    \fontsize{\the\popFootnoteFontSize}%
    {\the\popFootnoteBaselineSkip}\selectfont
    \raggedright
    \setlength{\parindent}{0pt}%
    \setlength{\parskip}{0pt}%
    \noindent
    \makebox[0pt][l]{\@thefnmark}%
    \hspace{\popFootnoteNumberGap}%
    #1%
    \par
  \endgroup
}

% Spacing between authors in affiliation list at the end of the article
\newlength{\popAuthorAffiliationEntryGap}
\setlength{\popAuthorAffiliationEntryGap}{5pt}

% Shared running-head contents: measure the same box used at shipout rather
% than assuming two lines. Published articles with a DOI have a third line.
\newcommand{\pop@runningheadcontents}{%
  \begingroup
    % Use explicit line boxes with local font and paragraph settings.
    % This prevents body-text spacing from affecting the running head.
    \normalfont
    \fontsize{\the\popRunningHeadFontSize}%
             {\the\popRunningHeadBaselineSkip}\selectfont
    \setlength{\parindent}{0pt}%
    \setlength{\parskip}{0pt}%

    \vtop{%
      \hsize=\popRunningHeadWidth
      % Normal TeX interline glue sets the configured baseline spacing.
      % Extra vertical skips here would increase it beyond that setting.
      \hbox{\@poprunningauthor}%
      \ifpopmanuscript
        \hbox{\emph{Unpublished Manuscript}}%
      \else
        \hbox{\textit{Philosophy of Physics}}%
        \IfStrEq{\@popdoi}{}{%
          % No DOI supplied: do not substitute manuscript text.
        }{%
          \hbox{\href{https://doi.org/\@popdoi}{DOI: \@popdoi}}%
        }%
      \fi
    }%
  \endgroup%
}

% ============================================================
% FIGURES AND CAPTIONS
% ============================================================

% To make figure captions appear to the right of the figure (rather than above or below) we use SCfigure / SCtable. But, we make a few adjustments to match the journal style.
% First, images/tables are automatically left-aligned in a full body-width area, even when their natural width is much smaller.
% Second, the caption starts at the running head's left edge, has exactly \popRunningHeadWidth of space, and normally aligns with the image/table top.
% There's a tricky thing though, that when the figure is at the top of the page, the caption would overlap the running header. So, near the page top only, the caption is lowered to clear the running head. Blind review has no head and needs no offset though.

% Usage (no manual padding, minipage, or \centering is required):
%   \begin{SCfigure}[1][tbp]
%     \includegraphics[width=0.5\textwidth]{your-figure}
%     \caption{Explain the figure.}\label{fig:example}
%   \end{SCfigure}
%   A TikZ picture or a tabular can replace the graphic.

\captionsetup{format=plain,font=footnotesize,labelfont=bf,labelsep=space,
  justification=raggedright,singlelinecheck=false}
\DeclareCaptionFont{popmargin}{%
  \fontsize{\popRunningHeadFontSize}{\popRunningHeadBaselineSkip}\selectfont}
\captionsetup[SCfigure]{font=popmargin}
\captionsetup[SCtable]{font=popmargin}
\renewcommand{\sidecaptionsep}{\popRunningHeadGap}
\renewcommand*{\SC@justify@body}{\raggedright}
\let\pop@originalSCcalcwidths\SC@calcwidths
\renewcommand*{\SC@calcwidths}[1]{%
  \isSC@WIDE{%
    \SC@BOXWD=\textwidth
    \SC@CAPWD=\popRunningHeadWidth
    \SC@tempdimb=\dimexpr
      \textwidth+\popRunningHeadGap+\popRunningHeadWidth\relax
  }{\pop@originalSCcalcwidths{#1}}%
}

% Save the unshifted caption top, not its text position after padding. This keeps the adjustment stable on later passes and leaves all image coordinates unchanged. The padding is inside the caption minipage, so even a very short image reserves enough float height for the lowered caption:
\newlength{\popMarginCaptionHeadGap}
\setlength{\popMarginCaptionHeadGap}{2\popRunningHeadBaselineSkip}
\newsavebox{\pop@runningheadmeasure}
\newdimen\pop@captionclearance
\zref@addprop{savepos}{abspage}
\newcommand{\pop@marginCaptionClearance}{%
  \isSC@WIDE{%
    \edef\pop@captionposition{pop-caption-\SC@IDENT}%
    \zsavepos{\pop@captionposition}%
    \pop@ifblindreview{}{%
      \zref@refused{\pop@captionposition}%
      \ifnum\zref@extractdefault{\pop@captionposition}{abspage}{0}>1\relax
        % Include TikZ's text-node paragraph box, just as in the actual head.
        \sbox{\pop@runningheadmeasure}{%
          \tikz{\node[inner sep=0pt,text width=\popRunningHeadWidth,align=left]
            {\pop@runningheadcontents};}}%
        % Positions are stored in scaled points measured up from the page
        % bottom. Subtract the maximum safe y from the unshifted caption y.
        \pop@captionclearance=\dimexpr
          \zposy{\pop@captionposition}sp-\paperheight+\popBodyTopMargin
          +\ht\pop@runningheadmeasure+\dp\pop@runningheadmeasure
          +\popMarginCaptionHeadGap\relax
        \ifdim\pop@captionclearance>0pt
          \vskip\pop@captionclearance
        \fi
      \fi
    }%
  }{}%
}
% Insert after the caption minipage's zero-height anchor rule (sidecap 1.6f).
% Leave SC@justify itself unchanged: caption uses it to choose justification:
\patchcmd{\endSC@FLOAT}{\SC@justify}%
  {\pop@marginCaptionClearance\SC@justify}{}{%
  \ClassError{philphys}{Cannot install margin caption clearance}%
    {The sidecap layout hooks have changed; update philphys.cls.}%
}

% Right-margin floats must be anchored left on both odd and even pages;
% sidecap's default wide alignment can otherwise alternate in twoside mode:
\renewcommand*{\isSC@ODD}[2]{#1}
\sidecaptionvpos{figure}{t}
\sidecaptionvpos{table}{t}

% ============================================================
% BIBLIOGRAPHY AND CITATIONS
% ============================================================

% Bibliography / references style.
\renewcommand{\refname}{References}

\setcitestyle{authoryear,round,aysep={ },notesep={, }}
% Published reference lists use 12pt leading, a 6.15mm hanging indent,
% and no extra blank gap between entries (measured across all four PDFs).
% Prefer breaks between entries. LaTeX's list machinery resets clubpenalty
% from @clubpenalty at each item; protect that first line as well as natbib's
% last-line penalty so a short entry moves intact when footer space is reserved.
\renewcommand{\bibfont}{\fontsize{8pt}{12pt}\selectfont
  \@clubpenalty10000\interlinepenalty6000}
\setlength{\bibhang}{6.15mm}
\setlength{\bibsep}{0pt}

% Natbib uses \bibsection for the bibliography heading. We format it manually rather than relying on \section*, since bibliography headings can otherwise bypass the class section style.
\renewcommand{\bibsection}{%
  % References should behave like an ordinary unnumbered section.
  % Do not insert negative space here; let \section* use the same
  % spacing as the other backmatter headings.
  \section*{References}%
}

% ============================================================
% HEADERS AND FOOTERS
% ============================================================

\pagestyle{empty}
% Title-page style: set to blank.
\fancypagestyle{poptitlepage}{%
  \fancyhead{}%
  \fancyfoot{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% Absolute running-head and page-number placement.
% Printed only from page 2 onward. The title page counts as page 1
% but remains visually unnumbered.

\AddToHook{shipout/foreground}{%
  \ifnum\value{page}>1\relax
    \begin{tikzpicture}[remember picture,overlay]

      % Running head.
      % This is typeset in its own local group so it does not inherit
      % the body-text baseline skip or paragraph spacing.
      % Hidden in blind-review mode.
      \pop@ifblindreview{}{%
      \node[
        anchor=north west,
        inner sep=0pt,
        text width=\popRunningHeadWidth,
        align=left
      ] at
        ([xshift={-\dimexpr\popBodyRightMargin-\popRunningHeadGap\relax},
          yshift=-\popBodyTopMargin]current page.north east)
                  {%
          \pop@runningheadcontents
        };
        }%

      % Page number.
      \node[
        anchor=north east,
        inner sep=0pt
      ] at
        ([xshift=-\popPageNumberRight,
          yshift=-\popBodyTopMargin]current page.north east)
        {\normalfont\bfseries\thepage};

    \end{tikzpicture}%
  \fi
}

% ============================================================
% BACKMATTER STYLE
% ============================================================
\newcommand{\popbackmatter}{%
  \pop@ifblindreview{}{%

    \IfStrEq{\@popacknowledgements}{}{%
    }{%
      \section*{Acknowledgements}
      \@popacknowledgements
    }%

    \section*{Competing Interests}
    \@popcompetinginterests

    \ifnum\value{popauthorcount}>0
      \section*{Author Affiliations}
      \vspace{5.833333pt}%
      \@popauthoraffiliationlist
    \fi
  }%
}

% ============================================================
% LAST PAGE STYLE
% ============================================================

% Last-page Article Info Column:
% Printed only on the final page, using the same typography as the title-page Article Info Column.
% Default notice for journal article content; the package licence is in LICENSE.txt.
\newcommand{\popArticleCopyrightNotice}{%
    \copyright \@popcopyrightyear\ The Author(s). This is an
    open-access article distributed under the terms of the
    Creative Commons Attribution 4.0 International Licence
    (CC-BY 4.0), which permits unrestricted use, distribution,
    and reproduction in any medium, provided the original author
    and source are credited. See
    \url{https://creativecommons.org/licenses/by/4.0/}.%
}

\newcommand{\popLastPageArticleInfoColumn}{%
  \begingroup
    \normalfont
    \fontsize{\popArticleInfoFontSize}
             {\popArticleInfoBaselineSkip}\selectfont
    \raggedright
    \setlength{\parindent}{0pt}
    \setlength{\parskip}{0pt}

    % Citation
    % ------------------------------------------------------------

    \textbf{TO CITE THIS ARTICLE:}\par
    \@poptocite\par

    \ifpopmanuscript
      \vspace{\popLastPageArticleInfoPartGap}
    \else
      \vspace{\popLastPageArticleInfoPartGap}

      % Publication history
      % ------------------------------------------------------------
      % Horizontally compressed slightly so full month names fit.
      \begingroup
      \def\popDateLine##1##2{%
        \noindent\scalebox{0.94}[1]{%
          \textbf{##1:} ##2%
        }\par
      }%
      \popDateLine{Submitted}{\@popsubmitted}%
      \popDateLine{Accepted}{\@popaccepted}%
      \popDateLine{Published}{\@poppublished}%
      \endgroup

      \vspace{\popLastPageArticleInfoPartGap}
    \fi

    % Copyright
    % ------------------------------------------------------------

    \textbf{COPYRIGHT:}\par

    \popArticleCopyrightNotice

    \par

    \emph{Philosophy of Physics} is a peer-reviewed open access
    journal published by LSE Press.

  \endgroup
}

% LAST PAGE FOOTER
% Generates all the material for the special footer on the final page.
%
% Strategy:
%   1. Do not reserve logo space using an invisible rule in the main text.
%      That does not protect against footnotes, because LaTeX places
%      footnotes in a separate bottom insertion area.
%
%   2. Reserve the logo strip when end matter starts (popbackmatter or the
%      bibliography), before references and footnotes are committed to a page.
%      Reduce both the current page goal and LaTeX's column heights; a late
%      enlargethispage cannot reconsider the page builder's earlier choices.
%
%   3. Keep the larger bottom margin throughout end matter, including any
%      following pages. This gives a stable break when reserving the strip
%      causes references to move onto another page. Earlier body pages retain
%      their normal margins. Never insert an empty page solely for the logos.
%
%   4. Anchor the footer in local physical-page coordinates, not remembered
%      TikZ positions. Adding/moving a TikZ figure changes picture IDs; stale
%      auxiliary positions must never move logos over that figure.
%
%   5. The LSE Press and OA logos are always printed, including in
%      blind-review mode. Only the article-info column is suppressed in
%      blind-review mode.
%
% shipout/lastpage receives an ordinary box at the engine's output origin,
% unlike shipout/foreground, whose picture origin is the page's upper left.
% Undo that origin here before drawing. pdfTeX/LuaTeX expose their origins;
% XeTeX uses the standard 1in origin. No PGF position labels are needed.
\newcommand{\pop@lastpageoverlay}[1]{%
  \begingroup
    \ifdefined\pdfvariable
      \dimen@=\pdfvariable horigin\relax
      \@tempdima=\pdfvariable vorigin\relax
    \else
      \dimen@=1in
      \@tempdima=1in
      \ifdefined\pdfhorigin \dimen@=\pdfhorigin\relax \fi
      \ifdefined\pdfvorigin \@tempdima=\pdfvorigin\relax \fi
    \fi
    \kern-\dimen@
    \raise\@tempdima\hbox{%
      \begin{tikzpicture}[overlay]
        \node[anchor=north west,inner sep=0pt,outer sep=0pt,
              minimum width=\paperwidth,minimum height=\paperheight]
          (popFooterPage) at (0,0) {};
        #1%
      \end{tikzpicture}%
    }%
  \endgroup
}

% Reserve the footer strip at the start of end matter, while page breaking
% can still account for the references and footnote insertion. Keep the shorter
% height on subsequent end-matter pages so the last-page choice cannot oscillate.
\newif\ifpop@footerzonereserved
\pop@footerzonereservedfalse
\newcommand{\pop@reservefooterzone}{%
  \ifpop@footerzonereserved\else
    \par
    \global\pop@footerzonereservedtrue
    \dimen@=\dimexpr\popLastPageBottomMargin-\popBodyBottomMargin\relax
    \ifdim\dimen@>0pt
      % \textheight governs later pages; the other registers govern the
      % current column, including space already reserved for top floats/notes.
      \global\advance\textheight-\dimen@
      \global\advance\@colht-\dimen@
      \global\advance\@colroom-\dimen@
      \global\advance\vsize-\dimen@
      \ifdim\pagegoal<\maxdimen
        \global\pagegoal=\dimexpr\pagegoal-\dimen@\relax
      \fi
    \fi
  \fi
}
% Optional for an article without back matter or a bibliography: call
% \popreservefooter before its final section (while that page still has room).
% The standard template needs no extra command; reservation starts automatically.
% Keep \poplastpagefooter at the end to install the actual last-page graphics.
\newcommand{\popreservefooter}{\pop@reservefooterzone}
\pretocmd{\popbackmatter}{\pop@reservefooterzone}{}{%
  \ClassError{philphys}{Cannot install footer reservation}{Update philphys.cls.}%
}
\BeforeBeginEnvironment{thebibliography}{\pop@reservefooterzone}

\newcommand{\pop@lastpagefooter}{%
  \pop@reservefooterzone

  % Use the kernel's actual last-page hook so deferred floats cannot strand
  % the footer on an earlier page. Like cross-references this needs a rerun
  % whenever pagination changes. Footer coordinates themselves are independent
  % of earlier runs. Float-only pages centre their content; the
  % author should inspect any unusually tall final float for logo clearance.
  % Run the overlay before hyperxmp: its metadata hook can leave horizontal
  % glue in this box. Give class code its own label rather than appending it
  % to the document's top-level hook, which always runs last.
  \DeclareHookRule{shipout/lastpage}{philphys/footer}{before}{hyperxmp}%
  \AddToHook{shipout/lastpage}[philphys/footer]{%
    \pop@lastpageoverlay{%

      % LSE Press logo and Open Access icon.
      % These appear even in blind-review mode.
      \node[
        anchor=south west,
        inner sep=0pt
      ] at
        ([xshift=\popLastPageLogoLeft,
          yshift=\popLastPageLogoBottom]
         popFooterPage.south west)
        {%
          \LSEPressLogo[0.071667]%
          \hspace{\popLastPageLogoGap}%
          \raisebox{\popLastPageOARaise}{%
            \popOA{\popLastPageOAHeight}%
          }%
        };

      % Last-page Article Info Column.
      % Hidden in blind-review manuscript mode.
      \pop@ifblindreview{}{%
        \node[
          anchor=south west,
          inner sep=0pt,
          text width=\popLastPageArticleInfoWidth,
          align=left
        ] at
          ([xshift={
              -\dimexpr
              \popBodyRightMargin
              - \popLastPageArticleInfoGap
              \relax},
            yshift=\popLastPageArticleInfoBottom]
           popFooterPage.south east)
          {%
            \popLastPageArticleInfoColumn
          };
      }%

    }%
  }%

  % Do not add a null box or force a page break: the document already has
  % real page material, and the kernel hook targets its actual last shipout.
}

% Public final-page footer command.
% Users should place \poplastpagefooter after the bibliography and any backmatter, right before \end{document}.
% Required in all modes: installs the final-page logos. Their space has normally
% already been reserved by popbackmatter or the bibliography; calling this
% command supplies a fallback for a short document with neither.
% In blind-review mode, the identifying article-info column is suppressed.
% With thanks to Alex for pointing out that trying my previous hack that hooked it in at enddocument was less stable.
\newif\ifpop@endmatterprinted
\pop@endmatterprintedfalse

\newcommand{\poplastpagefooter}{%
  \ifpop@endmatterprinted
    % Do nothing: already printed.
  \else
    \global\pop@endmatterprintedtrue
    \pop@lastpagefooter
  \fi
}

% Backwards-compatible alias for older drafts.
\let\popendmatter\poplastpagefooter

% Warn if the user forgets the explicit final-page footer, when users inevitably accidentally delete it.
\AtEndDocument{%
  \ifpop@endmatterprinted
  \else
    \ClassWarningNoLine{philphys}
      {No \string\poplastpagefooter\space command was used; final-page footer was not printed}%
  \fi
}

% ============================================================
% MAKETITLE
% ============================================================
\renewcommand{\maketitle}{%
  \thispagestyle{poptitlepage}%
  \begin{adjustwidth}{0cm}{\popTextRightIndent}%
    \popTitleBlock
    \vfill
    \popAbstractBlock
    \clearpage
  \end{adjustwidth}%
  % Switch to the Philosophy of Physics body-page margins immediately after the unnumbered title page. Since the title page has already shipped out as page 1, the next page is numbered 2.
  \popBodyGeometry
  \popApplyBodyTextStyle
}

% ============================================================
% HYPERREF AND PDF METADATA SUPPORT
% ============================================================
% Load hyperref late. Only published mode loads hyperxmp: its automatic
% title/author inference otherwise adds metadata to anonymous manuscripts.
\AtEndPreamble{%
  \@ifpackageloaded{hyperref}{}{%
    \RequirePackage[breaklinks]{hyperref}%
  }%
  \ifpopmanuscript\else
    \@ifpackageloaded{hyperxmp}{}{\RequirePackage{hyperxmp}}%
  \fi
  \hypersetup{
    pdftoolbar=false,
    pdfmenubar=true,
    pdffitwindow=false,
    pdfstartview={FitH},
    unicode=true,
    pdfnewwindow=true,
    colorlinks=true,
    linkcolor=black,
    citecolor=black,
    filecolor=black,
    urlcolor=black
  }%
}

% ============================================================
% PDF METADATA
% ============================================================

% Adds descriptive PDF/XMP metadata only in published mode.
% Manuscripts clear title/author/subject/keywords; technical PDF metadata remains.
% Do not load hyperxmp or add identifying metadata yourself for blind review.
\newcommand{\pop@setpdfmetadata}{%
  \ifpopmanuscript
    % Clear descriptive identity fields, including author-supplied preamble
    % hypersetup values. Technical producer/date metadata may remain.
    \hypersetup{pdftitle={},pdfauthor={},pdfsubject={},pdfkeywords={}}%
  \else
    \hypersetup{
      pdftitle={\@title},
      pdfauthor={\@popmetaauthorlist},
      pdfsubject={Philosophy of Physics Research Article},
      pdfkeywords={\@popkeywords},
      pdfcreator={LaTeX with philphys.cls},
      pdfpublisher={LSE Press},
      pdfpublication={Philosophy of Physics},
      pdftrapped={False},
      pdfdoi={\@popdoi},
      pdfidentifier={doi:\@popdoi},
      pdfcopyright={Copyright \@popcopyrightyear\space The Author(s). Published by LSE Press.},
      pdflicenseurl={https://creativecommons.org/licenses/by/4.0/}
    }%
  \fi
}

\AtBeginDocument{%
  \pop@setpdfmetadata
}



% Return @ to its ordinary LaTeX meaning.
\makeatother

% ============================================================
% END OF CLASS
% ============================================================
