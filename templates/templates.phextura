%                     Scale=\NotoDev@scale,
%    %                 \Noto@color,
%                     Extension = .ttf,
%        			 UprightFont = *-Regular,
%        			 ItalicFont = *-Regular,% has no italic face
%        			 BoldFont = *-Bold, 
%                	 BoldItalicFont = *-Bold,% has no italic face
%    			 ]{NotoSansDevanagari}	
                \babelfont [#1]{rm}[%
    %		 		 %Renderer=OpenType,% % Marathi and Hindi may respond differently...
                     Scale=\NotoDev@scale,
    %                 \Noto@color,
        			 ItalicFont = {NotoSerifDevanagari-VariableFont_wdth,wght.ttf},
	                 FontFace = {b}{n}{Font = {NotoSerifDevanagari-VariableFont_wdth,wght.ttf},Weight=600},
                     FontFace = {b}{it}{Font = {NotoSerifDevanagari-VariableFont_wdth,wght.ttf},Weight=600}
                 ]{NotoSerifDevanagari-VariableFont_wdth,wght.ttf}
                \babelfont [#1]{sf}[%
