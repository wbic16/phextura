}{}
\@ifundefined{scr@fnt@headsepline}{%
  \newkomafont{headsepline}{}%
}{}
\@ifundefined{scr@fnt@footsepline}{%
  \newkomafont{footsepline}{}%
}{}
\@ifundefined{scr@fnt@footbotline}{%
  \newkomafont{footbotline}{}%
}{}
