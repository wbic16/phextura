\ProvidesExplClass {whatsnote} {\whatsnote@date}
  {\whatsnote@version} {\whatsnote@tldr}
\cs_new_protected:Npn \__whats_msg_new:nn #1#2
  { \msg_new:nnn { whatsnote } {#1} {#2} }
\cs_new_protected:Npn \__whats_msg_error:nn #1#2
