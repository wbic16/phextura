\if@uvt@draftmark

  \if@uvt@draftmarkfp
    \RequirePackage[firstpageonly]{draftwatermark}
  \else
    \RequirePackage{draftwatermark}
  \fi

  \DraftwatermarkOptions{%
    angle=0,
    vpos=10pt,
    anchor=ct,
    fontsize=14pt,
    text={\translate{draft} (\today)}
  }

\fi


