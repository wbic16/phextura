\renewenvironment{quote}
{\begin{flushright}
    \begin{minipage}{\textwidth - 4cm}
      \fontsize{10pt}{1em}
      \begin{SingleSpace}
        }{\end{SingleSpace}\end{minipage}{}
  \end{flushright}}

\renewenvironment{quotation}
{\begin{center}
    \begin{minipage}{\textwidth - 4cm}
