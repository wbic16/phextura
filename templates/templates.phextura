                          }{%
                          }%
                        }%
                      }%
                    }%
                  }%
                }{%
                  \Ifstr{#1}{section}{\@namedef{scr@tso@#1@indent}{1.5em}}{%
                    \Ifstr{#1}{subsection}{\@namedef{scr@tso@#1@indent}{3.8em}}{%
                      \Ifstr{#1}{subsubsection}{%
                        \@namedef{scr@tso@#1@indent}{7.0em}%
                      }{%
                        \Ifstr{#1}{paragraph}{%
