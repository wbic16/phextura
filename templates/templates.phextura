\cs_new:Nn \__scrkernel_seq_put_unique:Nn
  {
    \seq_if_in:NnF #1 { #2 }
      { \seq_put_left:Nn #1 { #2 } }
  }
\seq_new:N \g__scrkernel_section_command_seq

\cs_new:Nn \__scrkernel_put_section_command:n
  {
    \__scrkernel_seq_put_unique:Nn \g__scrkernel_section_command_seq { #1 }
  }

\cs_new:Npn \__scrkernel_sort_section_commands_by_numdepth:
  {
    \seq_sort:Nn \g__scrkernel_section_command_seq
      {
        \int_compare:nNnTF
          { \use:c { ##2numdepth } } < { \use:c { ##1numdepth } }
          { \sort_return_swapped: }
          { \sort_return_same: }
      }
  }

\cs_new:Npn \__scrkernel_sort_section_commands_by_tocdepth:
  {
    \seq_sort:Nn \g__scrkernel_section_command_seq
      {
        \int_compare:nNnTF
          { \use:c { ##2tocdepth } } < { \use:c { ##1tocdepth } }
          { \sort_return_swapped: }
          { \sort_return_same: }
      }
  }

\cs_new:Npn \__scrkernel_sort_section_commands_by_toclevel:
  {
    \seq_sort:Nn \g__scrkernel_section_command_seq
      {
        \cs_if_exist:cF { toclevel@##1 }
          { \cs_set_eq:cc { toclevel@##1 } { ##1tocdepth } }
        \cs_if_exist:cF { toclevel@##2 }
          { \cs_set_eq:cc { toclevel@##2 } { ##2tocdepth } }
        \int_compare:nNnTF
          { \use:c { ##2tocdepth } } < { \use:c { ##1tocdepth } }
          { \sort_return_swapped: }
          { \sort_return_same: }
      }
  }
\hook_gput_code:nnn { package / hyperref / after } { . }
  {
    \clist_map_inline:nn
      { part, chapter,
        section, subsection, subsubsection,
        paragraph, subparagraph }
      {
        \cs_if_exist:cT { #1tocdepth }
          {
            \int_compare:nNnF
              { \use:c { toclevel@#1 } } = { \use:c { #1tocdepth } }
              {
                \ClassWarningNoLine{ \KOMAClassName }
                  {
                    It~seems~hyperref~or~another~package~before~changed
                    \MessageBreak
                    \exp_args:NNc \string\use:c{toclevel@#1}~from~
                    \use:c{#1tocdepth}~to\use:c{toclevel@#1}.
                    \MessageBreak
                    Reverting%
                  }
                  \cs_set_eq:cc { toclevel@#1 } { #1tocdepth }
              }
          }
      }
  }
\hook_gput_code:nnn { begindocument }  { . }
  {
    \seq_map_inline:Nn \g__scrkernel_section_command_seq
      {
        \int_compare:nNnF
          { \use:c{ toclevel@#1 } } = { \use:c { #1tocdepth } }
          {
            \ClassWarningNoLine { \KOMAClassName }
              {
                Unexpected~change~of~hyperref~toclevel~of~#1.\MessageBreak
                \exp_args:NNc \string\use:c{toclevel@#1}=\use:c{toclevel@#1}
                !=
                \use:c{#1tocdepth}=\exp_args:NNc \string\use:c{#1tocdepth}.
                \MessageBreak
                Cross~your~fingers!
              }
          }
      }
  }
\hook_gput_code:nnn { begindocument / end } { . }
  {
    \IfPackageLoadedT { hyperref }
      {
        \IfPackageLoadedF { bookmark }
          {
            \__scrkernel_emergency_toclevel_cleanup:
            \BeforeStartingTOC[\ext@toc]{\__scrkernel_emergency_toclevel_cleanup:}
          }
      }
  }

\cs_new:Npn \__scrkernel_emergency_toclevel_cleanup:
  {
    \ClassInfo{\KOMAClassName}{running~emergency~toclevel~cleanup}
    \group_begin:
      \tl_clear:N \l_tmpa_tl
      \__scrkernel_sort_section_commands_by_toclevel:
      \seq_map_inline:Nn \g__scrkernel_section_command_seq
        {
          \tl_if_empty:NF \l_tmpa_tl
            {
              \int_compare:nNnT
                { \use:c { toclevel@##1 } } > { \l_tmpa_int + 1 }
                {
                  \ClassWarningNoLine { \KOMAClassName }
                    {
                      Trying~emergency~fix~for~bookmark~level~gap,
                      \MessageBreak
                      because~toclevel~of~##1~(\use:c{toclevel@##1})~
                      is~more~than~1
                      \MessageBreak
                      greater~than~toclevel~of~\l_tmpa_tl\space
                      (\int_use:N\l_tmpa_int).\MessageBreak
                      Note:~This~fix~can~fail~and~you~should~load
                      \MessageBreak
                      package~bookmark~to~avoid~issues~with~such~gaps%
                    }
                  \cs_gset:cpe { toclevel@##1 }
                    { \int_eval:n { \l_tmpa_int + 1 } }
                }
            }
          \tl_set:Nn \l_tmpa_tl { ##1 }
          \int_set:Nn \l_tmpa_int { \use:c { toclevel@##1 } }
        }
    \group_end:
  }
