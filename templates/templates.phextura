\def\anima@NameColor{#1}
\def\anima@browntextColor{browntext}
\def\anima@greenboardColor{greenboard}
\def\anima@blackboardColor{blackboard}
\def\anima@graytextColor{graytext}
\def\anima@nfColor{nf}
