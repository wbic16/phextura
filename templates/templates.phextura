% ============================================================
% INTERNAL COMMAND NAMES
% ============================================================
% The following internal commands use @; class files already permit it.
% The explicit makeatletter/makeatother pair also supports maintenance excerpts.

\makeatletter

% Journal sizes measured from the supplied PDFs (TeX pt; PDF points are 72/72.27
% times these values). STIX Two Text body: 8pt; notes/sidebar: 7pt; title: 23pt.
\let\pop@originalnormalsize\normalsize
\renewcommand{\normalsize}{\pop@originalnormalsize\fontsize{8pt}{12.5pt}\selectfont}
\let\pop@originalsmall\small
\renewcommand{\small}{\pop@originalsmall\fontsize{7.500000pt}{9.166667pt}\selectfont}
\let\pop@originalfootnotesize\footnotesize
\renewcommand{\footnotesize}{\pop@originalfootnotesize\fontsize{7pt}{8.5pt}\selectfont}
\let\pop@originalscriptsize\scriptsize
\renewcommand{\scriptsize}{\pop@originalscriptsize\fontsize{5.833333pt}{6.666667pt}\selectfont}
\let\pop@originaltiny\tiny
\renewcommand{\tiny}{\pop@originaltiny\fontsize{4.166667pt}{5.000000pt}\selectfont}
\let\pop@originallarge\large
\renewcommand{\large}{\pop@originallarge\fontsize{10.000000pt}{11.666667pt}\selectfont}
\let\pop@originalLarge\Large
\renewcommand{\Large}{\pop@originalLarge\fontsize{12.000000pt}{15.000000pt}\selectfont}
\let\pop@originalLARGE\LARGE
\renewcommand{\LARGE}{\pop@originalLARGE\fontsize{14.400000pt}{18.333333pt}\selectfont}
\let\pop@originalhuge\huge
\renewcommand{\huge}{\pop@originalhuge\fontsize{17.283333pt}{20.833333pt}\selectfont}
\let\pop@originalHuge\Huge
\renewcommand{\Huge}{\pop@originalHuge\fontsize{20.733333pt}{25.000000pt}\selectfont}
\normalsize

% We define a helper for blind review, which is active only in manuscript mode. In published mode, the blindreview option deliberately does nothing.
\newcommand{\pop@ifblindreview}[2]{%
  \ifpopmanuscript
    \ifpopblindreview
      #1%
    \else
      #2%
    \fi
  \else
    #2%
  \fi
}

% ============================================================
% USER INTERFACE: METADATA COMMANDS
% ============================================================
\newcommand{\poprunningauthor}[1]{\gdef\@poprunningauthor{#1}}
\newcommand{\popdoi}[1]{\gdef\@popdoi{#1}}
\newcommand{\popabstract}[1]{\gdef\@popabstract{#1}}
\newcommand{\keywords}[1]{\gdef\@popkeywords{#1}}
\newcommand{\popacknowledgements}[1]{\gdef\@popacknowledgements{#1}}
\newcommand{\popcompetinginterests}[1]{\gdef\@popcompetinginterests{#1}}

% Corresponding-author metadata.
% Split into separate fields so the title-page Article Info Column
% can style the name, address, and email differently.
\newcommand{\popcorrespondingauthor}[1]{\gdef\@popcorrespondingauthor{#1}}
\newcommand{\popcorrespondingauthoraddress}[1]{\gdef\@popcorrespondingauthoraddress{#1}}
\newcommand{\popcorrespondingauthoremail}[1]{\gdef\@popcorrespondingauthoremail{#1}}

\newcommand{\poptocite}[1]{\gdef\@poptocite{#1}}
% Publication dates.
\newcommand{\popsubmitted}[1]{\gdef\@popsubmitted{#1}}
\newcommand{\popaccepted}[1]{\gdef\@popaccepted{#1}}
\newcommand{\poppublished}[1]{\gdef\@poppublished{#1}}
\newcommand{\popcopyrightyear}[1]{\gdef\@popcopyrightyear{#1}}


% Multiple-author storage using \popauthor.
% Usage: \popauthor{Name}{Affiliation}{ORCID}
% The third argument may be empty, like so:
%   \popauthor{Name}{Affiliation}{}
%   In that case no ORCID icon or ORCID link will be printed.
\newcounter{popauthorcount}
\newcommand{\@popauthorlist}{}
\newcommand{\@popauthoraffiliationlist}{}
% Protected comma-separated author list for PDF/XMP metadata
\newcommand{\@popmetaauthorlist}{}

\newcommand{\popauthor}[3]{%
  \stepcounter{popauthorcount}%
  % Protected comma-separated author list for PDF/XMP metadata; braces keep
  % commas within an individual author's name from separating authors.
  \ifnum\value{popauthorcount}=1
    \gdef\@popmetaauthorlist{{#1}}%
  \else
    \gappto\@popmetaauthorlist{,{#1}}%
  \fi

  % Title-page author list.
  % Uses the existing title-page style: bold, uppercase, with ORCID icon.
  \gappto\@popauthorlist{%
    \pop@printauthor{#1}{#3}%
    \par\vspace{\popAuthorLineGap}%
  }%

  % Backmatter author-affiliation list.
  % Uses ordinary body typography: author name bold but not uppercased,
  % then ORCID icon and printed ORCID link if supplied, followed by
  % the affiliation on the next line.
  \gappto\@popauthoraffiliationlist{%
    \pop@printauthoraffiliation{#1}{#2}{#3}%
  }%
}

% ============================================================
% INTERNAL DEFAULTS
% ============================================================
% Empty metadata stays empty until supplied by the author or production editor.
\newcommand{\@poprunningauthor}{}
\newcommand{\@popdoi}{}
\newcommand{\@popabstract}{}
\newcommand{\@popkeywords}{}
\newcommand{\@popacknowledgements}{}
\newcommand{\@popcompetinginterests}{}
\newcommand{\@popcorrespondingauthor}{}
\newcommand{\@popcorrespondingauthoraddress}{}
\newcommand{\@popcorrespondingauthoremail}{}
\newcommand{\@poptocite}{}
\newcommand{\@popsubmitted}{}
\newcommand{\@popaccepted}{}
\newcommand{\@poppublished}{}
\newcommand{\@popcopyrightyear}{\the\year}
\newcommand{\@poporcid}{}

% ============================================================
% TITLE PAGE GEOMETRY
% ============================================================
\newlength{\popTopMargin}
\newlength{\popBottomMargin}
\newlength{\popInnerMargin}
\newlength{\popOuterMargin}
\newlength{\popMarginParWidth}
\newlength{\popMarginParSep}

\setlength{\popTopMargin}{3.333333cm}
\setlength{\popBottomMargin}{3.333333cm}
\setlength{\popInnerMargin}{1.666667cm}
\setlength{\popOuterMargin}{0.833333cm}
\setlength{\popMarginParWidth}{4.166667cm}
\setlength{\popMarginParSep}{-27ex}

\geometry{
  top=\popTopMargin,
  bottom=\popBottomMargin,
  left=\popInnerMargin,
  right=\popOuterMargin,
  marginparwidth=\popMarginParWidth,
  marginparsep=\popMarginParSep
}

% ============================================================
% BODY PAGE GEOMETRY
% ============================================================

%MARGINS
\newlength{\popBodyTopMargin}
\newlength{\popBodyBottomMargin}
\newlength{\popBodyLeftMargin}
\newlength{\popBodyRightMargin}
%PAGE NUMBER LOCATION
\newlength{\popPageNumberRight}
% RUNNING HEAD
\newlength{\popRunningHeadGap}
\newlength{\popRunningHeadWidth}
\newlength{\popRunningHeadFontSize}
\newlength{\popRunningHeadBaselineSkip}

%MARGINS
\setlength{\popBodyTopMargin}{14.833333mm}
\setlength{\popBodyBottomMargin}{14.083333mm}
\setlength{\popBodyLeftMargin}{14.833333mm}  
\setlength{\popBodyRightMargin}{53.25mm}
%PAGE NUMBER LOCATION
\setlength{\popPageNumberRight}{8.5mm}
% RUNNING HEAD
\setlength{\popRunningHeadGap}{8.083333mm}
\setlength{\popRunningHeadWidth}{33.5mm}    
\setlength{\popRunningHeadFontSize}{7pt}  
\setlength{\popRunningHeadBaselineSkip}{9pt}

% Applied after the title page, so title-page positioning remains
% governed by the title-page measurements above.
\newcommand{\popBodyGeometry}{%
  \newgeometry{
    top=\popBodyTopMargin,
    bottom=\popBodyBottomMargin,
    left=\popBodyLeftMargin,
    right=\popBodyRightMargin,
    marginparwidth=\popRunningHeadWidth,
    marginparsep=\popRunningHeadGap
  }
}

% ============================================================
% LAST PAGE GEOMETRY
% ============================================================

% Last-page bottom area.
\newlength{\popLastPageBottomMargin}
\newlength{\popLastPageLogoLeft}
\newlength{\popLastPageLogoBottom}
\newlength{\popLastPageLogoGap}
\newlength{\popLastPageOAHeight}
\newlength{\popLastPageOARaise}

\setlength{\popLastPageBottomMargin}{28.25mm} % Sets the page margin high enough that text won't hit the LSE press and orange lock logo
\setlength{\popLastPageLogoLeft}{14.833333mm} % LSE Press left alignment
\setlength{\popLastPageLogoBottom}{14.833333mm} % LSE Press and lock vertical alignment 
\setlength{\popLastPageLogoGap}{2.083333mm} % Distance between LSE press logo and orange OA icon
\setlength{\popLastPageOAHeight}{5.666667mm} % Adjustable size for orange OA icon
\setlength{\popLastPageOARaise}{2.5mm} % Bumps the orange lock logo up vertically

% Last-page Article Info Column.
\newlength{\popLastPageArticleInfoGap}
\newlength{\popLastPageArticleInfoWidth}
\newlength{\popLastPageArticleInfoBottom}
\newlength{\popLastPageArticleInfoPartGap}

\setlength{\popLastPageArticleInfoGap}{8.083333mm} % Same as for title page column
\setlength{\popLastPageArticleInfoWidth}{31.666667mm} % Same as for title page column
\setlength{\popLastPageArticleInfoBottom}{14.833333mm} % Bottom-aligned with logos
\setlength{\popLastPageArticleInfoPartGap}{7.5mm} % Vertical gap separating second `Submitted/Accepted/Published' text from other parts.

% ============================================================
% VISUAL ASSETS: LOGOS AND ICONS
% ============================================================

% Open Access icon.
\newlength{\popOAheight}

\newcommand{\popOA}[1]{%
  \setlength{\popOAheight}{#1}%
  \raisebox{-0.40\popOAheight}{\resizebox{\popOAheight}{!}{%
    \begin{tikzpicture}[x=1pt,y=1pt]
      \begin{scope}[draw=popOAOrange,line width=10pt]
        \draw (10,68) -- (10,72) arc (180:0:21) -- (52,46);
        \draw (31,31) circle (26);
      \end{scope}
      \path[fill=popOAOrange](31,31)circle(8.8);
    \end{tikzpicture}%
  }}%
}

% White Open Access icon for the title box.
\newcommand{\popOAwhite}[1]{%
  \setlength{\popOAheight}{#1}%
  \raisebox{-0.40\popOAheight}{\resizebox{\popOAheight}{!}{%
    \begin{tikzpicture}[x=1pt,y=1pt]
      \begin{scope}[draw=white,line width=10pt]
        \draw (10,68) -- (10,72) arc (180:0:21) -- (52,46);
        \draw (31,31) circle (26);
      \end{scope}
      \path[fill=white](31,31)circle(8.8);
    \end{tikzpicture}%
  }}%
}

% ORCID icon.
% This draws the green circular iD mark in TikZ.
\newlength{\popORCIDidunit}

\newcommand{\popORCIDicon}{%
  % Set an approximate visual height for the ORCID icon.
  % We no longer use \ratio here, because that caused an
  % undefined-control-sequence error in some LaTeX setups.
  \setlength{\popORCIDidunit}{0.012625mm}%

  % Raise the icon slightly so that it aligns visually with
  % the author name rather than sitting too low on the baseline.
  \raisebox{0.1ex}{%
    \begin{tikzpicture}[x=\popORCIDidunit, y=\popORCIDidunit, inner sep=0pt, outer sep=0pt]%
      \fill[popORCIDGreen] (128,128) circle (128);
      \fill[white] (70,177) rectangle (86,70);
      \fill[white] (78,200) circle (10);
      \fill[white] (109,177) -- (150,177)%
      .. controls (190,177) and (208,149)%
      .. (208,123)%
      .. controls (208,96) and (186,70)%
      .. (150,70)%
      -- (109,70)%
      -- (109,177) -- cycle%
      (124,84)%
      -- (150,84)%
      .. controls (186,84) and (192,110)%
      .. (192,123)%
      .. controls (192,145) and (178,163)%
      .. (150,163) -- (124,163)%
      -- (124,84) -- cycle;
    \end{tikzpicture}%
  }%
}

% Philosophy of Physics coloured bar mark.
\newcommand{\popColourBars}[1][4.8]{%
  \begin{tikzpicture}[scale=#1]
    \fill[popBarOne]   (0,0)          rectangle (0.91mm,6.60mm);
    \fill[popBarTwo]   (1.5mm,2.25mm) rectangle (2.41mm,6.60mm);
    \fill[popBarThree] (3.0mm,2.25mm) rectangle (3.91mm,6.60mm);
    \fill[popBarFour]  (4.5mm,2.25mm) rectangle (5.41mm,6.60mm);
    \fill[popBarFive]  (6.0mm,0)      rectangle (6.91mm,6.60mm);
    \fill[popBarSix]   (7.5mm,2.25mm) rectangle (8.41mm,6.60mm);
  \end{tikzpicture}%
}

% Philosophy of Physics combined journal logo.
% This combines the coloured Philosophy of Physics bar mark defined above
% with the journal name. The text is set in sans serif following the
% journal logo design rather than the main STIX text font.
\newcommand{\popJournalLogo}{%
  \begingroup
    \sffamily
    \fontsize{\popJournalLogoFontSize}{\popJournalLogoBaselineSkip}\selectfont
    \parbox{\popJournalLogoWidth}{%
      \centering
      \resizebox{\popJournalLogoWidth}{!}{Philosophy of Physics}\par
      \vspace{\popJournalLogoBarGap}%
      \popColourBars[\popJournalLogoBarScale]\par
    }%
  \endgroup
}

% LSE Press logo.
% This is a TikZ reconstruction of the LSE Press logo.
% Usage: \LSEPressLogo or \LSEPressLogo[0.35] for a scaled version.
\newcommand{\LSEPressLogo}[1][0.15]{%
\begin{tikzpicture}[x=#1mm,y=-#1mm,baseline=(current bounding box.south)]
  % Red square
  \fill[lsered] (0,0) rectangle (130.15,130.15);

  % White L
  \fill[white]
    (45.73,105.15) -- (24.45,105.15) -- (24.45,24.95)
    -- (33.01,24.95) -- (33.01,96.29)
    -- (45.73,96.29) -- cycle;

  % White S, transcribed from the SVG Bézier path
  \fill[white]
    (75.01,88.40)
    .. controls (73.16,100.09) and (64.19,105.27) .. (55.88,105.12)
    -- (53.20,105.12)
    -- (53.20,96.34)
    -- (55.88,96.34)
    .. controls (59.40,96.31) and (65.36,93.86) .. (66.24,88.31)
    .. controls (67.09,82.93) and (66.46,79.04) .. (59.55,67.24)
    -- (59.46,67.04)
    .. controls (54.65,59.20) and (50.09,52.35) .. (51.79,41.60)
    .. controls (53.64,29.92) and (62.78,24.77) .. (71.09,24.92)
    -- (73.77,24.92)
    -- (73.77,33.69)
    -- (71.09,33.69)
    .. controls (67.57,33.72) and (61.44,36.13) .. (60.56,41.68)
    .. controls (59.71,47.06) and (60.30,50.53) .. (67.03,62.18)
    -- (67.21,62.48)
    .. controls (72.21,70.53) and (76.71,77.64) .. (75.01,88.40)
    -- cycle;

  % White E
  \fill[white]
    (105.84,33.70) -- (92.76,33.70) -- (92.76,59.41)
    -- (104.98,59.41) -- (104.98,68.77)
    -- (92.76,68.77) -- (92.76,96.28)
    -- (105.84,96.28) -- (105.84,105.15)
    -- (84.19,105.15) -- (84.19,24.96)
    -- (105.84,24.96) -- cycle;

  % Press text
  \begin{scope}[shift={(155,45)},scale=0.75]
    \path[fill=lsered,even odd rule]
      (7.87,28.48) -- (7.87,45.27) -- (0,45.27) -- (0,0)
      -- (17.32,0)
      .. controls (22.38,0) and (26.39,1.32) .. (29.37,3.95)
