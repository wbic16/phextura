      { \exp_args:NV \tl_range:nnn \l__ugentdocs_embargodatetmp_tl {6} {7} }
      { \exp_args:NV \tl_range:nnn \l__ugentdocs_embargodatetmp_tl {9} {10} }
      {-1}
