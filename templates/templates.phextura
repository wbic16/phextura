 %   \fi
 %   \nametest{#1}{part}%
 %   \ifsamename
 %     \addtocontents{toc}{\changetocdepth{-1}}%
 %     \def\@chtocdok{1}%
 %   \fi
 %   \nametest{#1}{chapter}%
 %   \ifsamename
 %     \addtocontents{toc}{\changetocdepth{0}}%
 %     \def\@chtocdok{1}%
 %   \fi
 %   \nametest{#1}{section}%
 %   \ifsamename
 %     \addtocontents{toc}{\changetocdepth{1}}%
 %     \def\@chtocdok{1}%
 %   \fi
