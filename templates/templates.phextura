\newcommand*{\bibliography@heading}[1]{%
  \ifbib@leveldown
    \subsection*{#1}%
    \begingroup
      \c@secnumdepth=-\maxdimen
      \subsectionmark{#1}%
    \endgroup
  \else
    \section*{#1}%
    \@mkdouble{\MakeMarkcase{#1}}%
  \fi
}%
