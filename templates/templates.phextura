    \AddToHook{file/\@real@jobname.#3/before}[title/ifname/#3]
      {\cs_gset_eq:NN \eb@title@ifname@resume \CTEXifname}
    \AddToHook{file/\@real@jobname.#3/after}[title/ifname/#3]
      {\cs_gset_eq:NN \CTEXifname \eb@title@ifname@resume}
  }
