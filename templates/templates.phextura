  { \__dfg_gender_leaders_render:nnnn {#1}{#2}{4}{5} }
\cs_new_protected:Npn \__dfg_gender_leaders_render:nnnn #1#2#3#4
{
  \begin{tblr}[
    theme=main,
    note{a}={Reference~ date:~ proposal~ for~ \dfgFundingPeriodText\space funding~ period},
    expand=\l_tblr_body_tl,
    long
  ]{
