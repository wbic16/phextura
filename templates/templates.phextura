\prop_new:N \l__ctex_font_size_temp_prop
\seq_new:N  \l__ctex_font_size_temp_seq
\cs_new_protected:Npn \__ctex_save_font_size:nn #1#2
  {
    \prop_put:Nne \l__ctex_font_size_temp_prop {#1}
      {
        { \dim_to_decimal:n {#2} }
        { \dim_to_decimal:n { (#2) * 6 / 5 } }
      }
    \seq_put_right:Nn \l__ctex_font_size_temp_seq {#1}
  }
\cs_new_eq:NN \ctex_save_font_size:nn \__ctex_save_font_size:nn
\group_begin:
  \prop_clear:N \l__ctex_font_size_temp_prop
  \seq_clear:N  \l__ctex_font_size_temp_seq
  \str_case:onF { \g__ctex_font_size_system_tl }
    {
      { word }
      {
        \clist_map_inline:nn
          {
            {  8 } { 5    bp } ,
            {  7 } { 5.5  bp } ,
            { -6 } { 6.5  bp } ,
            {  6 } { 7.5  bp } ,
            { -5 } { 9    bp } ,
            {  5 } { 10.5 bp } ,
            { -4 } { 12   bp } ,
            {  4 } { 14   bp } ,
            { -3 } { 15   bp } ,
            {  3 } { 16   bp } ,
            { -2 } { 18   bp } ,
            {  2 } { 22   bp } ,
            { -1 } { 24   bp } ,
            {  1 } { 26   bp } ,
            { -0 } { 36   bp } ,
            {  0 } { 42   bp }
          }
          { \__ctex_save_font_size:nn #1 }
      }
      { letterpress }
      {
        \clist_map_inline:nn
          {
            {  8 } { 4    bp } ,
            {  7 } { 5.25 bp } ,
            { -6 } { 7.5  bp } ,
            {  6 } { 8    bp } ,
            { -5 } { 9    bp } ,
            {  5 } { 10.5 bp } ,
            { -4 } { 12   bp } ,
            {  4 } { 14   bp } ,
            { -3 } { 15   bp } ,
            {  3 } { 16   bp } ,
            { -2 } { 18   bp } ,
            {  2 } { 21   bp } ,
            { -1 } { 24   bp } ,
            {  1 } { 28   bp } ,
            { -0 } { 36   bp } ,
            {  0 } { 42   bp }
          }
          { \__ctex_save_font_size:nn #1 }
      }
    }
    {
      \file_if_exist:nTF { ctex-fontsize- \g__ctex_font_size_system_tl .def }
        {
          \ctex_file_input:n
            { ctex-fontsize- \g__ctex_font_size_system_tl .def }
        }
        {
          \msg_error:nne { ctex } { fontsize-system-not-found }
            { \g__ctex_font_size_system_tl }
          \clist_map_inline:nn
            {
              {  8 } { 5    bp } ,
              {  7 } { 5.5  bp } ,
              { -6 } { 6.5  bp } ,
              {  6 } { 7.5  bp } ,
              { -5 } { 9    bp } ,
              {  5 } { 10.5 bp } ,
              { -4 } { 12   bp } ,
              {  4 } { 14   bp } ,
              { -3 } { 15   bp } ,
              {  3 } { 16   bp } ,
              { -2 } { 18   bp } ,
              {  2 } { 22   bp } ,
              { -1 } { 24   bp } ,
              {  1 } { 26   bp } ,
              { -0 } { 36   bp } ,
              {  0 } { 42   bp }
            }
            { \__ctex_save_font_size:nn #1 }
        }
    }
  \exp_args:NNe \prop_const_from_keyval:Nn \c__ctex_font_size_prop
    { \prop_to_keyval:N \l__ctex_font_size_temp_prop }
  \exp_args:NNe \seq_const_from_clist:Nn \c__ctex_font_size_seq
    { \seq_use:Nn \l__ctex_font_size_temp_seq { , } }
\group_end:
\msg_new:nnnn { ctex } { fontsize-system-not-found }
  {
