      \bool_if:NTF \l__ecnu_heading_in_toc_bool
        { \tl_if_empty:nTF { #2 } { \chapter{#3} } { \chapter[#2]{#3} } }
        {
          \__ecnu_pdf_bookmark:nn { 0 }
