\newcommand{\storedEpigrafe}{}
\NewEnviron{Epigrafe}{\global\expandafter
\def\expandafter\storedEpigrafe\expandafter{\BODY}}
\newcommand{\imprimirepigrafe}{%
  \begin{epigrafe}
    \storedEpigrafe\par
  \end{epigrafe}
}
