    \AtBeginShipout{%
      \AtBeginShipoutUpperRight{%
        {\color{red}%
        \put(\dimexpr 1in+\oddsidemargin,
             -\dimexpr 1in+\topmargin+\headheight+\headsep+\topskip)%
