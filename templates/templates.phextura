    \xpatchfieldformat{title}{mkbibemph}{textbf}{}{}
    \xpretonameformat{author}{\color{__gzt_people_color}}{}{}
    \g__gzt_blx_given_first_inits_false_tl
    \noindent
    \parbox[][21.5mm][l]{\linewidth}{\fullcite{\g__gzt_bookreview_bibkey_tl}}
    \tcblower
}{
  \begin{flushright}
    % \g__gzt_reviewer_tl
    \bigskip
