%% Core packages

\PassOptionsToPackage{pdfusetitle}{hyperref}
\RequirePackage{iftex}
\RequirePackage{xkeyval}

\ifdefined\l@nohyphenation\else\newlanguage\l@nohyphenation\fi
\ExplSyntaxOn
\regex_const:Nn \c__neo_tt_break_regex { [/(_] | \c{_} }
\regex_const:Nn \c__neo_tt_dot_regex { \. ([A-Za-z]) }
\regex_const:Nn \c__neo_tt_hyphen_regex { \- }
\bool_new:N \l__neo_tt_hyphens_bool
\tl_new:N \l__neo_tt_tl
\cs_new_protected:Npn \neo_tt_breaks:n #1
  {
    \tl_set:Nn \l__neo_tt_tl {#1}
    \regex_replace_all:nnN { \cD\_ } { \c{neo@us} } \l__neo_tt_tl
    \regex_match:nnF { \c{[A-Za-z@]+} } {#1}
      {
        \regex_replace_all:NnN \c__neo_tt_break_regex { \0\c{allowbreak} } \l__neo_tt_tl
        \regex_replace_all:NnN \c__neo_tt_dot_regex { \c{allowbreak}.\1 } \l__neo_tt_tl
        \bool_if:NF \l__neo_tt_hyphens_bool
          { \regex_replace_all:NnN \c__neo_tt_hyphen_regex { \c{mbox}\cB\{-\cE\} } \l__neo_tt_tl }
        \sys_if_engine_pdftex:T
          {
            \regex_match:nnF { \cM. } {#1}
              {
                \regex_replace_all:nnN { ' } { \c{textquotesingle} } \l__neo_tt_tl
                \regex_replace_all:nnN { ` } { \c{textasciigrave} } \l__neo_tt_tl
              }
          }
      }
    \tl_use:N \l__neo_tt_tl
  }
\cs_set_eq:NN \neo@ttbreaks \neo_tt_breaks:n
\cs_new_protected:Npn \neo@tthyphenstrue { \bool_set_true:N \l__neo_tt_hyphens_bool }
\cs_new_protected:Npn \neo@tthyphensfalse { \bool_set_false:N \l__neo_tt_hyphens_bool }
\ExplSyntaxOff
