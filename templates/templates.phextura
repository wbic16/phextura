 \edef\@tempa{\mem@fb@botlist\@deferlist\@dbldeferlist}%
 \ifx\@tempa\@empty
 \else
    \ifx\@fltovf\relax % my indicator of recursion
       \if@firstcolumn
         \clearpage
       \else
         \null\newpage\FloatBlock
       \fi
    \else
