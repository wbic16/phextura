\usepackage[
	natbib=true,
	style=langsci-unified,
	%refsection=chapter,
	maxbibnames=99,
	uniquename=false,
	mincrossrefs=99,
	maxcitenames=2,
	isbn=false,
	autolang=hyphen,
	\ifbool{resetcapitals}{language=english,}{}
	backend=\lsBiblatexBackend,
	indexing=cite
]{biblatex}

\defbibheading{references}[\lsReferencesTitle]{%
  \addchap{#1}
  \markdouble{#1}
  \clubpenalty\@M
  \@clubpenalty\clubpenalty
  \widowpenalty\@M
  \emergencystretch=3em
}

