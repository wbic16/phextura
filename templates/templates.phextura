    }
  }

\else\ifneo@minted

    \ExplSyntaxOn
    \cs_new:Npn \neo@mintedlang #1 { \str_case:nnF {#1} { {assembly}{nasm} {csv}{text} } {#1} }
    \ExplSyntaxOff

    %% Environment Definitions
    %% ----------------------------------
    \newcounter{mintcode}

    \ifneo@print
      \ifneo@codenonum
        \setminted{
          style=bw,
          fontsize=\small,
          breaklines=true,
          autogobble,
          frame=none,
          numbersep=\neo@codenumbersep,
          tabsize=4,
        }
      \else
        \setminted{
          style=bw,
          fontsize=\small,
          breaklines=true,
          autogobble,
          frame=none,
          linenos=true,
          numbersep=\neo@codenumbersep,
          tabsize=4,
        }
      \fi
    \else
      \ifneo@darktheme
        \ifneo@codenonum
          \setminted{
            style=github-dark,
            backgroundcolor=backgroundColor!85,
            fontsize=\small,
            breaklines=true,
            autogobble,
            frame=none,
            numbersep=\neo@codenumbersep,
            tabsize=4,
          }
        \else
          \setminted{
            style=github-dark,
            backgroundcolor=backgroundColor!85,
            fontsize=\small,
            breaklines=true,
            autogobble,
            frame=none,
            linenos=true,
            numbersep=\neo@codenumbersep,
            tabsize=4,
          }
        \fi
      \else
        \ifneo@codenonum
          \setminted{
            style=sas,
            fontsize=\small,
            breaklines=true,
            autogobble,
            frame=none,
            numbersep=\neo@codenumbersep,
            tabsize=4,
          }
        \else
          \setminted{
            style=sas,
            fontsize=\small,
            breaklines=true,
            autogobble,
            frame=none,
            linenos=true,
            numbersep=\neo@codenumbersep,
            tabsize=4,
          }
        \fi
      \fi
    \fi

    % Code listing environment
    \NewTCBListing{code}{ O{} m !O{} !O{\neoschool@codestyle} !D<>{\neoschool@codewidth} !O{} }{%
      listing engine=minted,
      minted language=\neo@mintedlang{#2},
      listing only,
      enhanced,
      breakable,
      fontupper=\color{\neoschool@globalcolor},
      width=#5\linewidth,
      minted options={#1},
      code={%
        \neo@setcodenumbership{#4}%
        \IfEqCase{#4}{%
          {}{\tcbset{neo@code@plain}}%
          {plain}{\tcbset{neo@code@plain}}%
          {bar}{\tcbset{neo@code@bar}}%
          {frame}{\tcbset{neo@code@frame}}%
          {shadow}{\tcbset{neo@code@shadow}}%
          {line}{\tcbset{neo@code@line}}%
          {lines}{\tcbset{neo@code@lines}}%
        }[\ClassError{neoschool}{Unknown code style '#4'}{Use plain, bar, frame, shadow, line or lines}]%
        \ifx\relax#3\relax%
          \tcbset{title={}}\neo@codelang@underlay{#2}%
        \else%
          \refstepcounter{mintcode}%
          \tcbset{title={\neo@codename~\themintcode\neoschool@codeseparator~~\neo@safetitle{#3}\neo@codelang@intitle{#2}},\neoschool@boxtitle}%
        \fi%
      },
      \neo@codecenter,
      #6
    }

    \NewTCBListing{codenonum}{ O{} m !O{} !O{\neoschool@codestyle} !D<>{\neoschool@codewidth} !O{} }{
      listing engine=minted,
      minted language=\neo@mintedlang{#2},
      listing only,
      enhanced,
      breakable,
      fontupper=\color{\neoschool@globalcolor},
      width=#5\linewidth,
      minted options={#1},
      code={%
        \neo@setcodenumbership{#4}%
        \IfEqCase{#4}{%
          {}{\tcbset{neo@code@plain}}%
          {plain}{\tcbset{neo@code@plain}}%
          {bar}{\tcbset{neo@code@bar}}%
          {frame}{\tcbset{neo@code@frame}}%
          {shadow}{\tcbset{neo@code@shadow}}%
          {line}{\tcbset{neo@code@line}}%
          {lines}{\tcbset{neo@code@lines}}%
        }[\ClassError{neoschool}{Unknown code style '#4'}{Use plain, bar, frame, shadow, line or lines}]%
        \ifx\relax#3\relax%
          \tcbset{title={}}\neo@codelang@underlay{#2}%
        \else%
          \tcbset{title={#3}, \neoschool@boxtitle}%
        \fi%
      },
      \neo@codecenter,
      #6
    }

    \expandafter\let\csname code*\endcsname\codenonum
    \expandafter\let\csname endcode*\endcsname\endcodenonum

    % Inline code command
    \ifneo@print\neo@mintinlineplaintrue\fi
    \ifneo@darktheme\neo@mintinlineplaintrue\fi
    \newcommand{\codeinline}[1][text]{%
      \ifneo@mintinlineplain
        \def\neo@tempa{\mintinline[style=vs,fontsize=\small,breaklines,autogobble]{text}}%
      \else
        \def\neo@tempa{\mintinline[style=vs,fontsize=\small,breaklines,autogobble]{#1}}%
      \fi
      \neo@tempa
    }

    % Code input from file
    \NewTCBInputListing{\codeinputnum}{ O{} m m !O{} !O{\neoschool@codestyle} !D<>{\neoschool@codewidth} !O{} }{%
      listing engine=minted,
      minted language={#2},
      enhanced,
      breakable,
      fontupper=\color{\neoschool@globalcolor},
      width=#6\linewidth,
      listing file={#3},
      listing only,
      minted options={#1},
      frame hidden,
      colback=codeBackground,
      boxrule=0pt,
      code={%
        \neo@setcodenumbership{#5}%
        \IfEqCase{#5}{%
          {}{\tcbset{neo@code@plain}}%
          {plain}{\tcbset{neo@code@plain}}%
          {bar}{\tcbset{neo@code@bar}}%
          {frame}{\tcbset{neo@code@frame}}%
          {shadow}{\tcbset{neo@code@shadow}}%
          {line}{\tcbset{neo@code@line}}%
          {lines}{\tcbset{neo@code@lines}}%
        }[\ClassError{neoschool}{Unknown code style '#5'}{Use plain, bar, frame, shadow, line or lines}]%
        \ifx\relax#4\relax%
          \tcbset{title={}}\neo@codelang@underlay{#2}%
        \else%
          \refstepcounter{mintcode}%
          \tcbset{title={\neo@codename~\themintcode\neoschool@codeseparator~~\neo@safetitle{#4}\neo@codelang@intitle{#2}},\neoschool@boxtitle}%
        \fi%
      },
      \neo@codecenter,
      #7
    }

    \NewTCBInputListing{\codeinputnonum}{ O{} m m !O{} !O{\neoschool@codestyle} !D<>{\neoschool@codewidth} !O{} }{
      listing engine=minted,
      minted language={#2},
      enhanced,
      breakable,
      fontupper=\color{\neoschool@globalcolor},
      width=#5\linewidth,
      listing file={#3},
      listing only,
      minted options={#1},
      frame hidden,
      colback=codeBackground,
      boxrule=0pt,
      code={%
        \neo@setcodenumbership{#5}%
        \IfEqCase{#5}{%
          {}{\tcbset{neo@code@plain}}%
          {plain}{\tcbset{neo@code@plain}}%
          {bar}{\tcbset{neo@code@bar}}%
          {frame}{\tcbset{neo@code@frame}}%
          {shadow}{\tcbset{neo@code@shadow}}%
          {line}{\tcbset{neo@code@line}}%
          {lines}{\tcbset{neo@code@lines}}%
        }[\ClassError{neoschool}{Unknown code style '#5'}{Use plain, bar, frame, shadow, line or lines}]%
        \ifx\relax#4\relax%
          \tcbset{title={}}\neo@codelang@underlay{#2}%
        \else%
          \tcbset{title={#4}, \neoschool@boxtitle}%
        \fi%
      },
      \neo@codecenter,
      #7
    }

    \DeclareRobustCommand{\codeinput}{%
      \@ifstar
      {\codeinputnonum}%
      {\codeinputnum}%
    }

    % Side-by-Side Code Environment

    \newtcblisting{codeside}[2][]{%
      standard jigsaw,
      listing engine=minted,
      listing only,
      enhanced,
      breakable,
      fontupper=\color{\neoschool@globalcolor},
      opacityback=0,
      opacityframe=0,
      fonttitle=\sffamily\bfseries,
      minted language=\neo@mintedlang{#2},
      arc=1pt,
      colback=codeBackground,
      colframe=codeFrame,
      boxsep=0pt,
      left=10pt,
      right=0pt,
      top=0pt,
      bottom=0pt,
      lefttitle=1.7mm,
      width=\linewidth,
      minted options={#1}
    }

  \fi

\fi

%% ==============================================================================
%% Algorithm and Pseudocode Environments
%% ==============================================================================

\ifneo@french
\algrenewcommand\algorithmicwhile{\textbf{tant que}}
\algrenewcommand\algorithmicdo{\textbf{faire}}
\algrenewcommand\algorithmicfor{\textbf{pour}}
\algrenewcommand\algorithmicif{\textbf{si}}
\algrenewcommand\algorithmicthen{\textbf{alors}}
\algrenewcommand\algorithmicelse{\textbf{sinon}}
\algrenewcommand\algorithmicend{\textbf{fin}}
\algrenewcommand\algorithmicreturn{\textbf{retourner}}
\algrenewcommand\algorithmicfunction{\textbf{fonction}}
\algrenewcommand\algorithmicrequire{\textbf{entrée}}
\algrenewcommand\algorithmicensure{\textbf{sortie}}
\algrenewcommand\algorithmicprocedure{\textbf{procédure}}

\newcommand{\To}{\textbf{ à }}
\else\ifneo@german
\algrenewcommand\algorithmicwhile{\textbf{solange}}
\algrenewcommand\algorithmicdo{\textbf{tue}}
\algrenewcommand\algorithmicfor{\textbf{für}}
\algrenewcommand\algorithmicif{\textbf{falls}}
\algrenewcommand\algorithmicthen{\textbf{dann}}
\algrenewcommand\algorithmicelse{\textbf{sonst}}
\algrenewcommand\algorithmicend{\textbf{Ende}}
\algrenewcommand\algorithmicreturn{\textbf{gib zurück}}
\algrenewcommand\algorithmicfunction{\textbf{Funktion}}
\algrenewcommand\algorithmicrequire{\textbf{Eingabe}}
\algrenewcommand\algorithmicensure{\textbf{Ausgabe}}
\algrenewcommand\algorithmicprocedure{\textbf{Prozedur}}

\newcommand{\To}{\textbf{ bis }}
\else
\newcommand{\To}{\textbf{ to }}
\fi\fi
\newcommand{\Gets}{\ensuremath{\leftarrow}}

\tcbset{%
  pseudocode/.style={%
    enhanced,
    breakable,
    before upper={\begin{algorithmic}},
    after upper={\end{algorithmic}},
    colupper=\neoschool@globalcolor,
    fonttitle=\csname\neoschool@headweight\endcsname\csname\neoschool@headfamily\endcsname\csname\neoschool@headshape\endcsname,
    before skip=\neo@effective@beforeafterskip,
    after skip=\neo@effective@beforeafterskip,
  }
}

\newcounter{pseudocode}
\newtcolorbox[use counter=pseudocode]{pseudocode}[2][]{%
  pseudocode,
  code={%
    \IfEqCase{\neoschool@codestyle}{%
      {}{\tcbset{neo@code@plain}}%
      {plain}{\tcbset{neo@code@plain}}%
      {bar}{\tcbset{neo@code@bar}}%
      {frame}{\tcbset{neo@code@frame}}%
      {shadow}{\tcbset{neo@code@shadow}}%
      {line}{\tcbset{neo@code@line}}%
      {lines}{\tcbset{neo@code@lines}}%
    }%
  },
  title={\csname neo@algorithmname\endcsname~\thepseudocode\neoschool@codeseparator~~#2},
  #1
}

%% ==============================================================================
%% Base Definitions and Styles for Theorems and Exercises
%% ==============================================================================

% Common Styles
\tcbset{
  common@base/.style={
    enhanced,
    breakable,
    before skip=\baselineskip,
    after skip=\baselineskip,
    colupper=\neo@box@uppertext,
    colframe=primaryColor,
    colbacklower=\neo@box@lowerback,
    separator sign={},
  },
  common@title@base/.style={
    fonttitle={\normalshape\ifx\neo@boxhead@style\relax\neo@title@style\else\neo@boxhead@style\fi},
  },
}

%% ==============================================================================
%% Shared Box Styles for Theorems and Exercises
%% ==============================================================================
\ExplSyntaxOn
\tl_new:N \l__custom_tcb_title_tl
\tl_new:N \l__custom_tcb_label_tl
\tl_new:N \l__custom_tcb_options_tl
\tl_new:N \l__neo_safetitle_tl
\tl_new:N \l__neo_kv_key_tl
\tl_new:N \l__neo_kv_val_tl

\cs_new_protected:Npn \__neo_kv_split:w #1 = #2 \q_stop
  {
    \tl_set:Nx \l__neo_kv_key_tl { \tl_trim_spaces:n {#1} }
    \tl_set:Nx \l__neo_kv_val_tl { \tl_trim_spaces:n {#2} }
    \tl_if_single:NT \l__neo_kv_val_tl
      { \tl_set:Nx \l__neo_kv_val_tl { \tl_head:N \l__neo_kv_val_tl } }
  }
\cs_new_protected:Npn \neo_kv_map:nnn #1#2#3
  {
    \clist_map_inline:nn {#1}
      {
        \tl_if_in:nnTF {##1} { = }
          { \__neo_kv_split:w ##1 \q_stop #2 }
          { #3 {##1} }
      }
  }

\cs_new_protected:Npn \neo_thm_args:n #1
  { \neo_kv_map:nnn {#1} { \__neo_thm_pair: } { \__neo_thm_bare:n } }
\cs_new_protected:Npn \__neo_thm_title:n #1
  {
    \tl_if_empty:NTF \l__custom_tcb_title_tl
      { \tl_set:Nn \l__custom_tcb_title_tl {#1} }
      { \tl_put_right:Nn \l__custom_tcb_title_tl { ,~ #1 } }
  }
\cs_new_protected:Npn \__neo_thm_option:
  { \tl_put_right:Nx \l__custom_tcb_options_tl { \exp_not:V \l__neo_kv_key_tl = { \exp_not:V \l__neo_kv_val_tl } , } }
\cs_new_protected:Npn \__neo_thm_pair:
  {
    \str_case_e:nnF { \tl_to_str:N \l__neo_kv_key_tl }
      {
        { title } { \tl_set_eq:NN \l__custom_tcb_title_tl \l__neo_kv_val_tl }
        { label } { \tl_set_eq:NN \l__custom_tcb_label_tl \l__neo_kv_val_tl }
      }
      {
        \cs_if_exist:cTF { pgfk@/tcb/ \tl_to_str:N \l__neo_kv_key_tl /.@cmd }
          { \__neo_thm_option: }
          {
            \tl_if_in:NnTF \l__neo_kv_key_tl { $ }
              { \exp_args:Nx \__neo_thm_title:n { \exp_not:V \l__neo_kv_key_tl = \exp_not:V \l__neo_kv_val_tl } }
              { \__neo_thm_option: }
          }
      }
  }
\cs_new_protected:Npn \__neo_thm_bare:n #1
  {
    \str_case:nnF {#1}
      { { title } { } { label } { } }
      {
        \cs_if_exist:cTF { pgfk@/tcb/ \tl_to_str:n {#1} /.@cmd }
          { \tl_put_right:Nn \l__custom_tcb_options_tl { #1 , } }
          { \__neo_thm_title:n {#1} }
      }
  }

\cs_new_protected:Npn \neo@ad@args #1
  { \neo_kv_map:nnn {#1} { \__neo_ad_pair: } { \__neo_ad_bare:n } }
\cs_new_protected:Npn \__neo_ad_title:n #1
  {
    \tl_if_empty:NTF \neo@ad@title
      { \tl_set:Nn \neo@ad@title {#1} }
      { \tl_put_right:Nn \neo@ad@title { ,~ #1 } }
  }
\cs_new_protected:Npn \__neo_ad_pair:
  {
    \str_case_e:nnF { \tl_to_str:N \l__neo_kv_key_tl }
      {
        { style }    { \tl_set_eq:NN \neo@ad@style \l__neo_kv_val_tl }
        { title }    { \tl_set_eq:NN \neo@ad@title \l__neo_kv_val_tl }
        { subtitle } { \tl_set_eq:NN \neo@ad@subtitle \l__neo_kv_val_tl }
        { icon }     { \tl_set_eq:NN \neo@ad@icon \l__neo_kv_val_tl }
      }
      {
        \tl_if_in:NnTF \l__neo_kv_key_tl { $ }
          { \exp_args:Nx \__neo_ad_title:n { \exp_not:V \l__neo_kv_key_tl = \exp_not:V \l__neo_kv_val_tl } }
          { \ClassWarning{neoschool}{Unknown~admonition~key:~\tl_to_str:N \l__neo_kv_key_tl} }
      }
  }
\cs_new_protected:Npn \__neo_ad_bare:n #1
  {
    \str_case:nnF {#1}
      { { style } { } { title } { } { subtitle } { } { icon } { } }
      { \__neo_ad_title:n {#1} }
  }
\cs_new_protected:Npn \neo@us { \mode_if_math:TF { \sb } { \_ \allowbreak } }
\NewDocumentCommand \neo@safetitle { m }
  {
    \tl_set:Nn \l__neo_safetitle_tl {#1}
    \regex_replace_all:nnN { \cD\_ } { \c{neo@us} } \l__neo_safetitle_tl
    \l__neo_safetitle_tl
  }

\newcommand{\neo@getCustomSlantedTitle}{%
  \tl_if_empty:NTF \l__custom_tcb_title_tl
  {}
  {\tl_use:N \hspace{0.4em}(\l__custom_tcb_title_tl)\!}
}

\newcommand{\neo@getCustomBoxedTitle}{%
  \tl_if_empty:NTF \l__custom_tcb_title_tl
  {}
  {\tl_use:N \hspace{0.4em}(\l__custom_tcb_title_tl)}
}
\ExplSyntaxOff

\def\neo@getcodeframestyle{%
  \ifneo@codenoframe
    frame hidden%
  \else\fi
}

\def\neo@getcodebackstyle{%
  \ifneo@codenoframe
    \ifneo@codenoback
      interior hidden%
    \fi
  \fi
}

\def\neo@getcodeshadowstyle{%
  \ifneo@codenoframe
    \ifneo@codenoback\else
      neo@codeshadowplate%
    \fi
  \else
    neo@codeshadowplate%
  \fi
}

\def\neo@getcodebarshadowstyle{%
  \ifneo@codenoframe
    \ifneo@codenoback\else
      neo@codebarshadowplate%
    \fi
  \else
    neo@codebarshadowplate%
  \fi
}

\def\neo@getexframestyle{%
  \ifneo@exnoframe
    frame hidden%
  \else\fi
}

\def\neo@getthmframestyle{%
  \ifneo@thmnoframe
    frame hidden%
  \else\fi
}

\ExplSyntaxOn

\cs_new_protected:Nn \neoschool_apply_arcs_ex:
{
  \dim_set:Nn \l_tmpa_dim { \neoschool@exboxarc }

  \dim_compare:nNnTF { \l_tmpa_dim } = { 0pt }
  {
    \tcbset{
      sharp~corners,
      arc = 0pt,
      outer~arc = 0pt
    }
  }
  {
    \tcbset{
      arc = \l_tmpa_dim,
      auto~outer~arc
    }
  }
}

\cs_new_protected:Nn \neoschool_apply_arcs_thm:
{
  \dim_set:Nn \l_tmpa_dim { \neoschool@thmboxarc }

  \dim_compare:nNnTF { \l_tmpa_dim } = { 0pt }
  {
    \tcbset{ sharp~corners, arc=0pt, outer~arc=0pt }
  }
  {
    \tcbset{
      arc = \l_tmpa_dim,
      auto~outer~arc
    }
  }
}

\NewDocumentCommand{\neo@ApplyNeoArcsThm}{}{ \neoschool_apply_arcs_thm: }
\NewDocumentCommand{\neo@ApplyNeoArcsEx}{}{ \neoschool_apply_arcs_ex: }

\ExplSyntaxOff

\tcbset{
  neo thm arcs/.code={ \neo@ApplyNeoArcsThm },
  neo ex arcs/.code={ \neo@ApplyNeoArcsEx }
}

\tcbset{%
  neo@shared@base/.style args={#1}{%
    /utils/exec={\let\neo@boxhead@style\neo@thmfont@style},
    common@base,
    colframe=#1!\neoschool@thmframeopacity!backgroundColor,
    /utils/exec={\StrSubstitute{#1}{Color}{BgColor}[\correctedBgColor]},
    colback=\ifneo@print black!\neoschool@thmboxopacity\else\correctedBgColor\fi,
    colupper=\neoschool@globalcolor,
    boxrule=\neo@thmborder,
    left=\neo@hpadding,
    right=\neo@hpadding,
    top=\neo@vpadding,
    bottom=\neo@vpadding,
    after skip=\neo@effective@beforeafterskip,
    before skip=\neo@effective@beforeafterskip,
    neo thm arcs,
    thmboxshape=\neoschool@thmboxshape,
    \neo@getthmframestyle,
    parbox=false,
  },
  neo@thm@block/.style args={#1}{%
    neo@shared@base={#1},
    common@title@base, left=0.85em, right=0.85em,
    skin=bicolor, detach title,
    borderline west={4pt}{0pt}{#1!\neoschool@thmframeopacity!backgroundColor},
    before upper={\tcbtitle\enskip},
    left=1em, right=1em,
    terminator sign={\neoschool@thmterminator}, separator sign={\neoschool@thmseparator},
  },
  neo@thm@bar/.style args={#1}{%
    neo@shared@base={#1},
    common@title@base, skin=bicolor, detach title, boxrule=0pt, sharp corners=west,
    borderline west={3.5pt}{0pt}{#1!\neoschool@thmframeopacity!backgroundColor},
    before upper={\tcbtitle\enskip},
    left=1em, right=1em,
    terminator sign={\neoschool@thmterminator}, separator sign={\neoschool@thmseparator},
  },
  neo@thm@tile/.style 2 args={%
    neo@shared@base={#1},
    common@title@base, rounded corners, arc=\neoschool@thmboxarc, outer arc=\dimexpr\neoschool@thmboxarc*5/4\relax,
    neo@fit@boxedtitle,
    attach boxed title to top left,
    boxed title style={empty, left=\neo@title@hpadding, right=\neo@title@hpadding, top=4pt, bottom=-5pt, left=1.35ex},
    detach title,
    underlay boxed title={%
      \path[fill=tcbcolback]
      ([xshift=\neo@thmborder/2]frame.west) [rounded corners] |- ([xshift=-2.5mm]title.north east) [sharp corners]
      to[out=0, in=180] ([xshift=5mm, yshift=-\neo@thmborder/2]title.south east) -- ++(0,-\neo@thmborder-1pt) -- cycle;
      \path[draw=\ifneo@thmnoframe none\else tcbcolframe\fi, line width=\neo@thmborder]
      ([xshift=\neo@thmborder/2]frame.west) [rounded corners] |- ([xshift=-2.5mm]title.north east) [sharp corners]
      to[out=0, in=180] ([xshift=5mm, yshift=-\neo@thmborder/2]title.south east) -- ++(1mm,0);
    },
  },
  neo@thm@fold/.style args={#1}{%
    neo@shared@base={#1},
    common@title@base, skin=bicolor, coltitle=\ifdim\neoschool@thmframeopacity pt<60pt #1\else backgroundColor\fi, detach title
  },
  neo@thm@plain/.style args={#1}{%
    neo@shared@base={#1}, colframe=#1!\neoschool@thmframeopacity!backgroundColor,
    common@title@base, skin=bicolor, detach title,
    terminator sign={\neoschool@thmterminator}, separator sign={\neoschool@thmseparator},
  },
  neo@thm@frame/.style args={#1}{%
    neo@shared@base={#1}, colframe=#1!\neoschool@thmframeopacity!backgroundColor,
    common@title@base, skin=bicolor, coltitle=\ifdim\neoschool@thmframeopacity pt<60pt #1\else backgroundColor\fi, colbacktitle=tcbcolframe,
    toptitle=\neo@title@vpadding, bottomtitle=\neo@title@vpadding
  },
  neo@thm@curve/.style args={#1}{%
    neo@shared@base={#1},
    common@title@base, skin=bicolor,
    neo@fit@boxedtitle,
    attach boxed title to top left={yshift*=-\tcboxedtitleheight},
    coltitle=\ifdim\neoschool@thmframeopacity pt<60pt #1\else backgroundColor\fi,
    boxed title style={sharp corners, rounded corners=northwest, colback=tcbcolframe, boxrule=0pt},
    underlay boxed title={%
      \path[fill=tcbcolframe] (title.south west)--(title.south east)
      to[out=0, in=180] ([xshift=5mm]title.east)--
      (title.center-|frame.east) [rounded corners=\kvtcb@arc] |- (frame.north) -| cycle;
    }
  },
  neo@thm@sticker/.style args={#1}{%
    neo@shared@base={#1},
    common@title@base, enhanced, detach title, colframe=#1!\neoschool@thmframeopacity!backgroundColor, boxrule=\neo@verythickrule,
    neo thm arcs, thmboxshape=\neoschool@thmboxshape,
    neo@fit@boxedtitle,
    attach boxed title to top left={xshift=1em, yshift*=-\tcboxedtitleheight/2},
    boxed title style={colback=#1!\neoschool@thmframeopacity!backgroundColor, colframe=#1!\neoschool@thmframeopacity!backgroundColor, arc=\neoschool@thmtitlearc, thmtitleshape=\neoschool@thmtitleshape, boxrule=\neo@normalrule, bottom=1pt, top=1pt, left=2pt ,right=2pt},
    coltitle=\ifdim\neoschool@thmframeopacity pt<60pt #1\else backgroundColor\fi,
  },
  neo@thm@pastel/.style args={#1}{%
    neo@shared@base={#1},
    common@title@base, enhanced, detach title, colframe=#1!\neoschool@thmframeopacity!backgroundColor, colback=backgroundColor, boxrule=\neo@thickrule, neo thm arcs,
    neo@fit@boxedtitle,
    attach boxed title to top left={xshift=1em, yshift*=-\tcboxedtitleheight/2},
    boxed title style={colback=#1!12!backgroundColor, colframe=#1!\neoschool@thmframeopacity!backgroundColor, arc=\neoschool@thmtitlearc, thmtitleshape=\neoschool@thmtitleshape, boxrule=\neo@thickrule, bottom=1pt, top=1pt, left=2pt ,right=2pt},
    coltitle=#1,
  },
  neo@thm@tag/.style 2 args={%
    neo@shared@base={#1},
    common@title@base, arc=\neoschool@thmboxarc, neo thm arcs, \neo@framehidden,
    coltitle=\ifdim\neoschool@thmframeopacity pt<60pt #1\else backgroundColor\fi, detach title, thmboxshape=\neoschool@thmboxshape,
    before upper*={%
      \noindent\tcbox[enhanced, on line, colupper=backgroundColor, colback=#1, colframe=#1,
      fontupper=\neo@thmfont@style, boxrule=0pt,
      top=0.5pt, bottom=0.5pt, left=1pt, right=1pt,
      nobeforeafter,
      arc=\neoschool@thmtitlearc, thmtitleshape=\neoschool@thmtitleshape,
    ]{#2~\thetcbcounter}%
    }
    {\normalshape\neo@thmfont@style\color{#1}\neo@getCustomBoxedTitle}\space
  }
}

\tcbset{%
  neo@ex@base/.style args={#1}{%
    /utils/exec={\let\neo@boxhead@style\neo@exfont@style},
