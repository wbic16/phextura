  \ifnum\TV@reviewercount=\z@
    \TV@reviewertoks={#1}%
  \else
    \TV@reviewertoks=\expandafter{\the\TV@reviewertoks\\[1mm]#1}%
  \fi
  \advance\TV@reviewercount\@ne}

\newcount\TV@committeecount
\newtoks\TV@committeetoks
