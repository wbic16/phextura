  \begingroup
    \tl_if_in:nnTF {#1} {=} {
      \keys_set:nn {ptxcd/subtask} {#1}
    } {
     \keys_set:nn {ptxcd/subtask} {title={#1}}
    }
    \bool_if:NTF \l__ptxcd_subtask_fallback_bool {
      \@subtask{\IfNoValueF{#1}{#1}}
    }{
      \@subtask{\l__ptxcd_title_tl}
