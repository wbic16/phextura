\newcommand{\@spit}[2][]{%
  \@bsphack
  \@ifempty{#2}%
   {\let\@specialissuetitle\relax}%
   {\@ifempty{#1}%
     {\def\@specialissuetitle{\@specialissuetitleprefix#2}}%
     {\def\@specialissuetitle{#1\space#2}}}%
  \@esphack}%
\newcommand{\@sspit}[2][]{%
  \@bsphack
  \@ifempty{#2}%
   {\let\@specialissuetitle\relax}%
   {\def\@specialissuetitle{#2}}%
