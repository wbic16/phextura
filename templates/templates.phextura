\AddToHookWithArguments{label}{\mem@addto@label@hook{#1}}
\let\mem@addto@label@hook\@gobble
\newcommand\memsub@addto@label@hook[1]{%
  \begingroup%
  \protected@edef\@currentlabelname{%
    Sub\@captype\space%
    \@nameuse{p@sub\@captype}%
    \@nameuse{thesub\@captype}%
  }%
  \protected@edef\@currentlabel{\@nameuse{@@thesub\@captype}}%
  \protected@write\@auxout{}%
  {%
    \string\newlabel{sub@#1}{%
      {\@currentlabel}%
      {\thepage}%
      {\@currentlabelname}%x
      {\@currentHref}%
      {\@kernel@reserved@label@data}%
    }%
  }%
  \endgroup%
}
\newcommand{\subcaption}{%
  \par
  \bgroup
    % \let\label=\memsub@label
    \let\mem@addto@label@hook\memsub@addto@label@hook
    \ifdonemaincaption\else
      \advance\csname c@\@captype\endcsname\@ne
    \fi
    \mem@step@subcounter%
    \@ifnextchar [%
      {\@memsubcap{sub\@captype}}%
      {\@memsubcap{sub\@captype}[\@empty]}}
\long\def\@memsubcap#1[#2]#3{%
  \@tempdima=\hsize
  \vskip\subfloatcapskip
  \ifx \@empty #2
    \@memsubcaption{#1}{#3}{#3}%
  \else
    \@memsubcaption{#1}{#2}{#3}%
  \fi
  \vskip\subfloatcapskip
  \egroup}
\newcommand{\@memsubcaption}[3]{%
  \ifx \relax#2\relax \else
    \bgroup
      \let\label\@gobble
      \let\protect\string
      \def\@memsubcaplabel{\@nameuse{@@the#1}}%
      \xdef\@memsubfigcaptionlist{%
        \@memsubfigcaptionlist,%
  {\protect\numberline{\@memsubcaplabel}\noexpand{\ignorespaces #2}}}%
    \egroup
  \fi
  \@makesubfloatcaption{\@nameuse{@the#1}}{#3}}

