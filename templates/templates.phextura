%% hgbaiusage.sty
%% This file is part of the Hagenberg Thesis package for creating bachelors's and masters's theses
%% Author: Wolfgang Hochleitner
%% GitHub: https://github.com/Digital-Media/HagenbergThesis
%% File encoding: UTF-8

%% This package provides the documentation of the usage of generative AI tools in a thesis in two forms:
%%   - environment 'aiusage': short form, composed of text modules, printed as part of the affidavit,
%%   - environment 'aiusagedetails': detailed form with confirmations and a table of activities, printed
%%     automatically as an unnumbered chapter before the bibliography.
%% Both forms can be maintained in a document at the same time; the option 'aiusage=detailed|short' (usually
%% given as class option of hgbthesis) selects the one that is printed (default: detailed). The short form
%% supplements the affidavit; the detailed form is a separate part at the back of the document (like the
%% bibliography) and is not mentioned in the affidavit. Both environments only collect their entries, so they
%% must be given before \maketitle.
%% Both forms are printed in the main language of the document (like the affidavit).
%%
%% The texts of the detailed form are in the separate file hgbaiusage-cognisance.sty, which is licensed under
%% CC BY-SA 4.0 (adapted from Gimpel et al., 2023). This file itself is licensed like the package (CC BY 4.0).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hgbaiusage}[2026/10/22]%%AUTO

\RequirePackage{xifthen}
\RequirePackage{hgbdict}
\RequirePackage{etoolbox}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{amssymb}	% check boxes (\square, \boxtimes)
\RequirePackage{hgbaiusage-cognisance}	% texts of the detailed form (CC BY-SA 4.0)

% aiusage=detailed|short: form of the documentation that is printed (default: detailed).
\newcommand{\hgb@AIUsageForm}{detailed}
\DeclareKeys[hgbaiusage]{
	aiusage.code = {%
		\ifthenelse{\equal{#1}{short} \OR \equal{#1}{detailed}}%
			{\renewcommand{\hgb@AIUsageForm}{#1}}%
			{\PackageError{hgbaiusage}{Unknown value '#1' for option 'aiusage'}%
				{Allowed values are detailed (default) and short.}}},
}
\ProcessKeyOptions[hgbaiusage]

\newcommand{\hgb@AIUsageIfDetailed}[2]{\ifthenelse{\equal{\hgb@AIUsageForm}{detailed}}{#1}{#2}}

% Texts of both forms (main language of the document, like the affidavit):
\newcommand{\hgb@AIUsageGet}[1]{\hgbDictionaryGet{#1}{\hgb@MainLanguage}}

% Messages of the warnings of this package: every line is shorter than 79 characters (TeX wraps longer lines in
% the log), and no line but the last one ends with a period (TeXstudio, for example, ends a warning at such a
% line, so that the following lines would be missing).

\newif\ifhgb@AIUsageShortUsed			% environment 'aiusage' used
\newif\ifhgb@AIUsageDetailsUsed			% environment 'aiusagedetails' used
\newif\ifhgb@AIUsageDeclarationDone		% affidavit (with the short form, if selected) printed
\newif\ifhgb@AIUsageDetailsDone			% detailed form printed

%% ----------------------------------------------------------------------------
%% Short form (text modules)
%% ----------------------------------------------------------------------------

% Title of the chapter in documents without affidavit (proposals):
\hgbDictionarySet{aiusage-title}{english}{Documentation of AI Tools Usage}
\hgbDictionarySet{aiusage-title}{german}{Dokumentation der Nutzung von KI-Tools}

\hgbDictionarySet{aiusage-intro}{english}{%
Regarding the use of generative artificial intelligence tools such as chatbots, image generators,
programming applications and paraphrasing or translation tools, I hereby document that}
\hgbDictionarySet{aiusage-intro}{german}{%
Über den Einsatz von Hilfsmitteln der generativen Künstlichen Intelligenz wie Chatbots, Bildgeneratoren,
Programmieranwendungen, Paraphrasier- oder Übersetzungstools dokumentiere ich, dass}

\hgbDictionarySet{aiusage-none}{english}{%
I did not use any generative artificial intelligence tools in writing this document.}
\hgbDictionarySet{aiusage-none}{german}{%
ich keinerlei Hilfsmittel der generativen Künstlichen Intelligenz beim Verfassen dieser Arbeit benutzt habe.}

\hgbDictionarySet{aiusage-used}{english}{I used generative artificial intelligence tools, to}
\hgbDictionarySet{aiusage-used}{german}{ich Hilfsmittel der generativen Künstlichen Intelligenz verwendet habe,}

% Purposes for \aiusedfor{<key>}:
\hgbDictionarySet{aiusage-purpose-ideas}{english}{%
gather initial ideas for potential research questions and relevant theories.}
\hgbDictionarySet{aiusage-purpose-ideas}{german}{%
um erste Ideen für mögliche Forschungsfragen und relevante Theorien zu sammeln.}

\hgbDictionarySet{aiusage-purpose-literature-search}{english}{search for literature.}
\hgbDictionarySet{aiusage-purpose-literature-search}{german}{um Literatur zu finden.}

\hgbDictionarySet{aiusage-purpose-literature-understanding}{english}{%
better understand academic literature (e.g., summaries).}
\hgbDictionarySet{aiusage-purpose-literature-understanding}{german}{%
um Literatur besser nachvollziehen zu können (Zusammenfassungen etc.).}

\hgbDictionarySet{aiusage-purpose-proofreading}{english}{%
proofread parts of the thesis and improve the linguistic style.}
\hgbDictionarySet{aiusage-purpose-proofreading}{german}{%
um Teile der Arbeit Korrektur zu lesen und den sprachlichen Stil zu verbessern.}

\newcommand{\hgb@AIUsagePurposes}{ideas, literature-search, literature-understanding, proofreading}

\newcount\hgb@AIUsageItems
\newif\ifhgb@AIUsageNone
\newcommand{\hgb@AIUsageItemList}{}

% Usage (before \maketitle; the environment only collects the entries, they are printed in the affidavit):
%   \begin{aiusage}
%     \aiusednone                        % no AI tools used, or any number of:
%     \aiusedfor{<key>}                  % predefined purpose (see \hgb@AIUsagePurposes)
%     \aiusedforother{<text>}            % other purpose, continuing the sentence like the predefined ones
%   \end{aiusage}
\newenvironment{aiusage}{%
	\ifhgb@AIUsageDeclarationDone
		\PackageWarning{hgbaiusage}{Environment 'aiusage' is used after \string\maketitle\MessageBreak
			and therefore ignored. Place it before\MessageBreak
			\string\maketitle}%
	\fi
	\global\hgb@AIUsageShortUsedtrue
	\global\hgb@AIUsageItems=\z@
	\global\hgb@AIUsageNonefalse
	\gdef\hgb@AIUsageItemList{}%
	\setbox\z@\vbox\bgroup	% discard anything else than the commands above
}{%
	\egroup
}

\newcommand{\aiusednone}{%
	\ifnum\hgb@AIUsageItems>\z@
		\PackageError{hgbaiusage}{\string\aiusednone\space cannot be combined with \string\aiusedfor}%
			{Remove either \string\aiusednone\space or all \string\aiusedfor/\string\aiusedforother\space entries.}%
	\else
		\global\hgb@AIUsageNonetrue
	\fi
}

% The text of a predefined purpose is stored as \hgb@AIUsageGet{...}, i.e., it is taken from the dictionary
% when the short form is printed.
\newcommand{\aiusedfor}[1]{%
	\ifcsname hgb@dict-aiusage-purpose-#1-english\endcsname
		\hgb@AIUsageItem{\hgb@AIUsageGet{aiusage-purpose-#1}}%
	\else
		\PackageError{hgbaiusage}{Unknown purpose '#1' in \string\aiusedfor}%
			{Use one of: \hgb@AIUsagePurposes, or \string\aiusedforother{...} for other purposes.}%
	\fi
}

\newcommand{\aiusedforother}[1]{\hgb@AIUsageItem{#1}}

\newcommand{\hgb@AIUsageItem}[1]{%
	\ifhgb@AIUsageNone
		\PackageError{hgbaiusage}{\string\aiusedfor\space cannot be combined with \string\aiusednone}%
			{Remove either \string\aiusednone\space or all \string\aiusedfor/\string\aiusedforother\space entries.}%
	\else
		\global\advance\hgb@AIUsageItems by \@ne
		\gappto\hgb@AIUsageItemList{\item #1}%
	\fi
}

% Text of the short form, without spacing:
\newcommand{\hgb@AIUsageShortText}{%
	\noindent\hgb@AIUsageGet{aiusage-intro}\space
	\ifnum\hgb@AIUsageItems>\z@
		\hgb@AIUsageGet{aiusage-used}%
		\begin{itemize}\hgb@AIUsageItemList\end{itemize}%
	\else
		\hgb@AIUsageGet{aiusage-none}%
	\fi
	\par
}

% Prints the short form with the given spacing or heading (#1) if aiusage=short. The short form must have
% entries; otherwise a warning is issued and nothing is printed. With aiusage=detailed, nothing is printed.
\newcommand{\hgb@AIUsagePrintShort}[1]{%
	\global\hgb@AIUsageDeclarationDonetrue
	\hgb@AIUsageIfDetailed{}{%
		\ifnum\hgb@AIUsageItems=\z@
			\ifhgb@AIUsageNone
				#1\hgb@AIUsageShortText
			\else
				\PackageWarning{hgbaiusage}{No usage of AI tools documented. Use\MessageBreak
					\string\aiusednone, \string\aiusedfor{...} or\MessageBreak
					\string\aiusedforother{...} in environment 'aiusage'\MessageBreak
					before \string\maketitle}%
			\fi
		\else
			#1\hgb@AIUsageShortText
		\fi}%
}

% Inserts the short form into the affidavit (with aiusage=short). This command is called by the declaration
% page of the theme (\hgb@MakeDeclarationPage), between the text of the affidavit and the date.
\newcommand{\hgb@AIUsageDeclaration}{\hgb@AIUsagePrintShort{\par\bigskip}}

% Separate chapter for documents without affidavit (proposals), called by \maketitle of hgbthesis.
\newcommand{\hgb@MakeAIUsageChapter}{\hgb@AIUsagePrintShort{\chapter{\hgb@AIUsageGet{aiusage-title}}}}

%% ----------------------------------------------------------------------------
%% Detailed form (texts in hgbaiusage-cognisance.sty, CC BY-SA 4.0)
%% ----------------------------------------------------------------------------

% Bullet point in the description of an activity (used by the texts):
\newcommand{\hgb@AIUsagePoint}[1]{%
	\par\noindent\hangindent=1em\hangafter=1\makebox[1em][l]{\textbullet}\hspace{0pt}#1\par}

\newcommand{\hgb@AIUsageActivities}{ideas,literature,methodology,coding,data,interpretation,structure,generation,translation,editing,references}

\newcommand{\hgb@AIUsageChecked}{\ensuremath{\boxtimes}}
\newcommand{\hgb@AIUsageUnchecked}{\ensuremath{\square}}

% Mark of an activity without entries and of missing further use (own text of this package): the dash used for
% empty table cells in the respective language, i.e., an en dash in German and an em dash in English.
\hgbDictionarySet{aiusagedetails-empty}{english}{\textemdash}
\hgbDictionarySet{aiusagedetails-empty}{german}{\textendash}

% Usage (before \maketitle; the environment only collects the entries, the form is printed before the
% bibliography):
%   \begin{aiusagedetails}
%     \aiconfirm{accuracy}                               % confirm statements (check boxes)
%     \aiconfirm{responsibility}
%     \aiactivity{<key>}{<tools>}{<description>}         % any number, keys see \hgb@AIUsageActivities
%     \aifurtheruse{<text>}                              % optional, one per further use
%   \end{aiusagedetails}
% The table lists all activities, as the FH OÖ template does; activities without entries are marked with a dash.
\newenvironment{aiusagedetails}{%
	\ifhgb@AIUsageDetailsDone
		\PackageWarning{hgbaiusage}{Environment 'aiusagedetails' is used after the\MessageBreak
			detailed form has been printed and therefore\MessageBreak
			ignored. Place it before \string\maketitle}%
	\fi
	\global\hgb@AIUsageDetailsUsedtrue
	\hgb@AIUsageDetailsReset
	\setbox\z@\vbox\bgroup	% discard anything else than the commands above
}{%
	\egroup
}

\newcommand{\hgb@AIUsageDetailsReset}{%
	\csgdef{hgb@AIUsageConfirm@accuracy}{\hgb@AIUsageUnchecked}%
	\csgdef{hgb@AIUsageConfirm@responsibility}{\hgb@AIUsageUnchecked}%
	\@for\hgb@tmpkey:=\hgb@AIUsageActivities\do{%
		\csgdef{hgb@AIUsageTools@\hgb@tmpkey}{}%
		\csgdef{hgb@AIUsageUse@\hgb@tmpkey}{}%
	}%
	\global\hgb@AIUsageFurtherCount=\z@
	\gdef\hgb@AIUsageFurther{}%
	\gdef\hgb@AIUsageFurtherFirst{}%
}

\newcommand{\aiconfirm}[1]{%
	\ifcsname hgb@dict-aiusagedetails-statement-#1-english\endcsname
		\csgdef{hgb@AIUsageConfirm@#1}{\hgb@AIUsageChecked}%
	\else
		\PackageError{hgbaiusage}{Unknown statement '#1' in \string\aiconfirm}%
			{Use 'accuracy' or 'responsibility'.}%
	\fi
}

% Repeated entries for the same activity are appended.
\newcommand{\aiactivity}[3]{%
	\ifcsname hgb@dict-aiusage-activity-#1-english\endcsname
		\ifcsempty{hgb@AIUsageTools@#1}%
			{\csgdef{hgb@AIUsageTools@#1}{#2}}%
			{\csgappto{hgb@AIUsageTools@#1}{\par #2}}%
		\ifcsempty{hgb@AIUsageUse@#1}%
			{\csgdef{hgb@AIUsageUse@#1}{#3}}%
			{\csgappto{hgb@AIUsageUse@#1}{\par #3}}%
	\else
		\PackageError{hgbaiusage}{Unknown activity '#1' in \string\aiactivity}%
			{Use one of: \hgb@AIUsageActivities.}%
	\fi
}

% One \aifurtheruse per further use: a single entry is printed as a paragraph, several entries as a
% bulleted list (like the descriptions of the activities).
\newcount\hgb@AIUsageFurtherCount
\newcommand{\aifurtheruse}[1]{%
	\global\advance\hgb@AIUsageFurtherCount by \@ne
	\ifnum\hgb@AIUsageFurtherCount=\@ne
		\gdef\hgb@AIUsageFurtherFirst{#1}%
	\fi
	\gappto\hgb@AIUsageFurther{\hgb@AIUsagePoint{#1}}%
}

\newcommand{\hgb@AIUsageStatementRow}[1]{%
	\hgb@AIUsageGet{aiusagedetails-statement-#1} & {\large\csuse{hgb@AIUsageConfirm@#1}} \\}

\newcommand{\hgb@AIUsageHead}{%
	\textbf{\hgb@AIUsageGet{aiusagedetails-activity}} &
	\textbf{\hgb@AIUsageGet{aiusagedetails-description}} &
	\textbf{\hgb@AIUsageGet{aiusagedetails-tools}} &
	\textbf{\hgb@AIUsageGet{aiusagedetails-usage}}\newline\hgb@AIUsageGet{aiusagedetails-usage-note} \\}

% Content of a cell (macro name #1), or the dash if it is empty:
\newcommand{\hgb@AIUsageCell}[1]{%
	\ifcsempty{#1}{\hgb@AIUsageGet{aiusagedetails-empty}}{\csuse{#1}}}

\newcommand{\hgb@AIUsageRow}[1]{%
	\textbf{\hgb@AIUsageGet{aiusage-activity-#1}} &
	\hgb@AIUsageGet{aiusage-activity-#1-desc} &
	\hgb@AIUsageCell{hgb@AIUsageTools@#1} &
	\hgb@AIUsageCell{hgb@AIUsageUse@#1} \\}

% Rows of the table of activities (separated by \midrule):
\newcommand{\hgb@AIUsageCollectRows}{%
	\gdef\hgb@AIUsageRowList{}%
	\@for\hgb@tmpkey:=\hgb@AIUsageActivities\do{%
		\ifdefempty{\hgb@AIUsageRowList}{}{\gappto\hgb@AIUsageRowList{\midrule}}%
		\xappto\hgb@AIUsageRowList{\noexpand\hgb@AIUsageRow{\hgb@tmpkey}}%
	}%
}

% Table of activities (may break across pages):
\newcommand{\hgb@AIUsageTable}{%
	\begingroup
	\footnotesize
	\setlength{\tabcolsep}{4pt}%
	\setlength{\LTleft}{\z@}%
	\setlength{\LTright}{\fill}%
	\setlength{\LTpost}{\smallskipamount}%
	% \hspace{0pt} allows hyphenation of the first word in a cell (not in column 2, which starts with \par)
	\begin{longtable}{@{}>{\raggedright\arraybackslash\hspace{0pt}}p{\dimexpr0.19\linewidth-\tabcolsep\relax}%
		>{\raggedright\arraybackslash}p{\dimexpr0.37\linewidth-2\tabcolsep\relax}%
		>{\raggedright\arraybackslash\hspace{0pt}}p{\dimexpr0.16\linewidth-2\tabcolsep\relax}%
		>{\raggedright\arraybackslash\hspace{0pt}}p{\dimexpr0.28\linewidth-\tabcolsep\relax}@{}}
		\toprule
		\hgb@AIUsageHead
		\midrule
		\endfirsthead
		\toprule
		\hgb@AIUsageHead
		\midrule
		\endhead
		\bottomrule
		\endfoot
		\bottomrule
		\endlastfoot
		\hgb@AIUsageRowList
	\end{longtable}%
	\endgroup
}

% Heading of the detailed form: an unnumbered chapter in the table of contents, created like the heading of the
% bibliography (biblatex heading 'bibintoc', see \MakeBibliography in hgbbib.sty):
\newcommand{\hgb@AIUsageDetailsHeading}[1]{%
	\ifdefined\printbibheading
		\printbibheading[heading=bibintoc,title={#1}]%
	\else
		\chapter*{#1}\addcontentsline{toc}{chapter}{#1}\markboth{#1}{#1}%
	\fi
}

% The detailed form as an unnumbered chapter (see below):
\newcommand{\hgb@MakeAIUsageDetails}{%
	\ifhgb@AIUsageDetailsUsed\else
		\hgb@AIUsageDetailsReset
		\PackageWarning{hgbaiusage}{No usage of AI tools documented with option\MessageBreak
			aiusage=detailed. Use environment\MessageBreak
			'aiusagedetails' before \string\maketitle}%
	\fi
	\ifcsstring{hgb@AIUsageConfirm@accuracy}{\hgb@AIUsageUnchecked}%
		{\PackageWarning{hgbaiusage}{Statement 'accuracy' not confirmed in\MessageBreak
			environment 'aiusagedetails'. Use\MessageBreak
			\string\aiconfirm{accuracy}}}{}%
	\ifcsstring{hgb@AIUsageConfirm@responsibility}{\hgb@AIUsageUnchecked}%
		{\PackageWarning{hgbaiusage}{Statement 'responsibility' not confirmed in\MessageBreak
			environment 'aiusagedetails'. Use\MessageBreak
			\string\aiconfirm{responsibility}}}{}%
	\hgb@AIUsageDetailsHeading{\hgb@AIUsageGet{aiusagedetails-title}}%
	%
	% The instructions of the template to the authors (to confirm the statements, to indicate the tools used,
	% the footnote with names of tools) are not printed; the sample documents give them as comments.
	\section*{\hgb@AIUsageGet{aiusagedetails-responsible}}%
	\noindent
	\begin{tabular}{@{}>{\raggedright\arraybackslash}p{\dimexpr\linewidth-36mm-2\tabcolsep\relax}%
		>{\centering\arraybackslash}p{36mm}@{}}
		\toprule
		\textbf{\hgb@AIUsageGet{aiusagedetails-statements}} &
			\textbf{\hgb@AIUsageGet{aiusagedetails-confirmation}} \\
		\midrule
		\hgb@AIUsageStatementRow{accuracy}
		\addlinespace
		\hgb@AIUsageStatementRow{responsibility}
		\bottomrule
	\end{tabular}\par
	%
	\section*{\hgb@AIUsageGet{aiusagedetails-activities}}%
	\hgb@AIUsageCollectRows
	\hgb@AIUsageTable
	%
	\bigskip
	\noindent\textbf{\hgb@AIUsageGet{aiusagedetails-further}}\par
	\ifcase\hgb@AIUsageFurtherCount
		\noindent\hgb@AIUsageGet{aiusagedetails-empty}\par
	\or
		\noindent\hgb@AIUsageFurtherFirst\par
	\else
		\hgb@AIUsageFurther
	\fi
	\bigskip
	{\footnotesize\noindent\hgb@AIUsageGet{aiusagedetails-source}\par}%
}

%% ----------------------------------------------------------------------------
%% Placement of the detailed form before the bibliography
%% ----------------------------------------------------------------------------

% With aiusage=detailed, the detailed form is printed as an unnumbered chapter (listed in the table of contents)
% directly before the bibliography created by \MakeBibliography (hgbbib.sty), with the same kind of heading.
% Documents without \MakeBibliography get it at the end of the document.
\newcommand{\hgb@AIUsagePrintDetails}{%
	\hgb@AIUsageIfDetailed{%
		\ifhgb@AIUsageDetailsDone\else
			\global\hgb@AIUsageDetailsDonetrue
			\hgb@MakeAIUsageDetails
		\fi
	}{}%
}

\AddToHook{cmd/MakeBibliography/before}{\hgb@AIUsagePrintDetails}

\AddToHook{enddocument}{%
	\hgb@AIUsagePrintDetails
	\ifhgb@AIUsageDeclarationDone\else
		\PackageWarning{hgbaiusage}{The documentation of AI tools usage was not printed.\MessageBreak
			Use \string\maketitle, or call \string\hgb@AIUsageDeclaration\MessageBreak
			in the declaration page of a custom theme}%
	\fi
}
%% hgbalgo.sty

%% Toward better looking algorithms ...
%% This package imports and pre-configures the 'algorithmicx'/'algpseudocodex' packages
%% (see https://ctan.org/pkg/algpseudocodex), fixes some problems and adds new functionality
%% and colors. It relies on the 'algorithm' package for typesetting float-type algorithms
%% with captions.

%% This file is part of the Hagenberg Thesis package for creating bachelors's and masters's theses
%% Author: Wilhelm Burger (wilbur@ieee.org)
%% GitHub: https://github.com/Digital-Media/HagenbergThesis
%% File encoding: ASCII

\ProvidesPackage{hgbalgo}[2026/10/22]%%AUTO

\RequirePackage[noEnd=true,indLines=true,italicComments=false]{algpseudocodex}	% https://ctan.org/pkg/algpseudocodex
\RequirePackage{calc}				% for numeric calculations
\RequirePackage{xcolor}

% Colors to be used in algorithms (can be redefined locally if desired)
\definecolor{AlgKeywordColor}{rgb}{0.00, 0.00, 0.666}	% = Dark Blue
\definecolor{AlgProcedureColor}{rgb}{0.00, 0.5, 0.20}	% = Dark Green
%\definecolor{AlgCommentColor}{gray}{0.40} 				% = Gray (40% black)

\algrenewcommand\algorithmicend{\textbf{\color{AlgKeywordColor}end}}
\algrenewcommand\algorithmicdo{\textbf{\color{AlgKeywordColor}do}}
\algrenewcommand\algorithmicwhile{\textbf{\color{AlgKeywordColor}while}}
\algrenewcommand\algorithmicfor{\textbf{\color{AlgKeywordColor}for}}
\algrenewcommand\algorithmicforall{\textbf{\color{AlgKeywordColor}for all}}
\algrenewcommand\algorithmicloop{\textbf{\color{AlgKeywordColor}loop}}
\algrenewcommand\algorithmicrepeat{\textbf{\color{AlgKeywordColor}repeat}}
\algrenewcommand\algorithmicuntil{\textbf{\color{AlgKeywordColor}until}}
\algrenewcommand\algorithmicprocedure{\textbf{\color{AlgKeywordColor}procedure}}
\algrenewcommand\algorithmicfunction{\textbf{\color{AlgKeywordColor}function}}
\algrenewcommand\algorithmicif{\textbf{\color{AlgKeywordColor}if}}
\algrenewcommand\algorithmicthen{\textbf{\color{AlgKeywordColor}then}}
\algrenewcommand\algorithmicelse{\textbf{\color{AlgKeywordColor}else}}
\algrenewcommand\algorithmicrequire{\textbf{\color{AlgKeywordColor}Require:}}
\algrenewcommand\algorithmicensure{\textbf{\color{AlgKeywordColor}Ensure:}}
\algrenewcommand\algorithmicreturn{\textbf{\color{AlgKeywordColor}return}}

% Use SF font and color for procedure and function names:
\newcommand{\@AlgTextProc}[1]{\textcolor{AlgProcedureColor}{\textsf{#1}}}
\algrenewcommand\textproc{\@AlgTextProc}			
\algrenewcommand\Call[2]{\textproc{#1}\hskip0.75pt(#2)}%

%% -----------------------------------------------------------------

\newlength{\@AlgTmpIndent}

%% Additional public macros:

% This macro is obsolete and will eventually dissappear:
\algnewcommand{\StateL}[1]{\State #1%
	\PackageWarning{hgbalgo}{Macro \protect\StateL\space is obsolete, use \protect\State\space instead}}%

% \StateNN[<nesting>]{<text>} creates non-numbered statements like algorithmicx's \Statex 
% command but provides consistent indentation inside nested constructs and over multiple lines.
% The optional integer argument [<nesting>] can be used to specify the nesting depth
% to counteract a bug in algorithmicx (nesting level is not set properly before the first \State
% command inside a nested construct.
\algnewcommand{\StateNN}[2][\numexpr\theALG@nested-1]{% default indentation = nesting - 1
  \setlength\@AlgTmpIndent{\algorithmicindent*#1}% requires calc package
	\Statex\hskip\@AlgTmpIndent\parbox[t]{\linewidth-\@AlgTmpIndent}{#2\strut}%
}%

% Macros for describing input and output of procedures and functions:
\algnewcommand\Input[1]{\StateNN[1]{\textbf{Input:} #1}}%			use to describe input parameters: \Input{<description>}
\algrenewcommand\Output[1]{\StateNN[1]{\textbf{Output:} #1}}%		use to describe output values: \Output{<description>} (already defined in algpseudocodex.sty) 
\algnewcommand\Returns[1]{\StateNN[1]{\textbf{Returns} #1}}%	use to describe what a procedure/function returns: \Returns{<description}

% The following macros insert additional vertical space after a statement.
% They only work in horizontal mode and are supposed
% to be used inside (at the end of) statements, e.g.,
%     \State $x \gets x + 1$ \algsmallskip
\algnewcommand{\algsmallskip}[0]{\raisebox{-3pt}{\strut}}
\algnewcommand{\algmedskip}[0]{\raisebox{-6pt}{\strut}}
\algnewcommand{\algbigskip}[0]{\raisebox{-12pt}{\strut}}

% 'algorithm' creates a floating environment for algorithms: \begin{algorithm}...\end{algorithm}
\@ifundefined{chapter}%
  {\RequirePackage[ruled]{algorithm}}%
	{\RequirePackage[ruled,chapter]{algorithm}}

\ifthenelse{\equal{\bbl@main@language}{german} \or \equal{\bbl@main@language}{ngerman}}%
	{\floatname{algorithm}{Algorithmus}}{}%
	
\ifthenelse{\equal{\bbl@main@language}{english}}%
	{\floatname{algorithm}{Algorithm}}{}%
%% hgbbib.sty
%% Bibliography Setup
%% This file is part of the Hagenberg Thesis package for creating bachelors's and masters's theses
%% Author: Wilhelm Burger (wilbur@ieee.org)
%% GitHub: https://github.com/Digital-Media/HagenbergThesis
%% File encoding: ASCII

\ProvidesPackage{hgbbib}[2026/10/22]%%AUTO

\newcommand{\@bibstyle}{numeric-comp}	%% default bibliography style is 'numeric-comp'
\DeclareOption{apa}{\renewcommand{\@bibstyle}{apa}}
\ProcessOptions\relax

\RequirePackage{xifthen}

%\usepackage[style=numeric-comp,backend=biber,bibencoding=auto]{biblatex}
\usepackage[style=\@bibstyle,backend=biber]{biblatex}
\ExecuteBibliographyOptions{
	bibencoding=auto,
	bibwarn=true,
	sortcites=true,
	defernumbers=true,
	isbn=false,
	doi=true,
	backref=true,
	backrefstyle=three}
	
\RequirePackage{csquotes}				% recommended for biblatex

%% set up dictionary terms

\RequirePackage{hgbdict}

\hgbDictionarySet{bibtitle}{english}{References}
\hgbDictionarySet{bibtitle}{german}{Quellenverzeichnis}

\hgbDictionarySet{bibtitleLiterature}{english}{Literature}
\hgbDictionarySet{bibtitleLiterature}{german}{Literatur}

\hgbDictionarySet{bibtitleMedia}{english}{Media}
\hgbDictionarySet{bibtitleMedia}{german}{Medien}

\hgbDictionarySet{bibtitleOnline}{english}{Online sources}
\hgbDictionarySet{bibtitleOnline}{german}{Online-Quellen}

\hgbDictionarySet{bibtitleSoftware}{english}{Software}
\hgbDictionarySet{bibtitleSoftware}{german}{Software}

%% titles of reference section + 3 categories of references:

\newcommand{\@bibtitle}{\hgbDictionaryGet{bibtitle}{\hgb@MainLanguage}}
\newcommand{\@bibtitleLiterature}{\hgbDictionaryGet{bibtitleLiterature}{\hgb@MainLanguage}}
\newcommand{\@bibtitleMedia}{\hgbDictionaryGet{bibtitleMedia}{\hgb@MainLanguage}}
\newcommand{\@bibtitleOnline}{\hgbDictionaryGet{bibtitleOnline}{\hgb@MainLanguage}}
\newcommand{\@bibtitleSoftware}{\hgbDictionaryGet{bibtitleSoftware}{\hgb@MainLanguage}}

%% categories for a split bibliography (order of declaration is important!)
\DeclareBibliographyCategory{literature}
\DeclareBibliographyCategory{media}
\DeclareBibliographyCategory{software}
\DeclareBibliographyCategory{online}

%% headings for the bibliography categories
\defbibheading{literature}{%
	\phantomsection%
	\section*{\@bibtitleLiterature}%
	\addcontentsline{toc}{section}{\@bibtitleLiterature}%
}

\defbibheading{media}{%
	\pagebreak[3]%
	\phantomsection%
	\section*{\@bibtitleMedia}%
	\addcontentsline{toc}{section}{\@bibtitleMedia}%
}

\defbibheading{online}{%
	\pagebreak[3]%
	\phantomsection%
	\section*{\@bibtitleOnline}%
	\addcontentsline{toc}{section}{\@bibtitleOnline}%
}

\defbibheading{software}{%
	\pagebreak[3]%
	\phantomsection%
	\section*{\@bibtitleSoftware}%
	\addcontentsline{toc}{section}{\@bibtitleSoftware}%
}

\defbibheading{noheader}[]{}		% 'none' should be defined but isn't

%Assign a given bibliography entry to one of the defined categories.
\newcommand{\@AssignToBibCategory}[1]% argument 1: entry key 
{\ifthenelse{%
		\ifentrytype{online}\OR
		\ifentrytype{www}\OR
		\ifentrytype{electronic}}
	{\addtocategory{online}{#1}}%
{\ifthenelse{%
		\ifentrytype{movie}\OR
		\ifentrytype{video}\OR
		\ifentrytype{music}\OR
		\ifentrytype{audio}\OR
		\ifentrytype{image}}
	{\addtocategory{media}{#1}}%
{\ifthenelse{%
		\ifentrytype{software}}
	{\addtocategory{software}{#1}}%
	{\addtocategory{literature}{#1}}% else (default)
}}}

%Hook provided by biblatex.
\AtEveryCitekey{\@AssignToBibCategory{\thefield{entrykey}}}

%This is only a wrapper to \addbibresource to allow the use
%of the classic bibtex-workflow in the future.
\newcommand{\AddBibFile}[1]{
	\addbibresource{#1}%
}

% Declare a source map so the sorting in \cite commands works across the bib
% categories. % The maps need to correspond to the entry types in the bib
% categories (which unfortunately can't be used directly). The source map adds
% the presort field with values from A to D that is responsible for sorting in
% the four categories.
\DeclareSourcemap{
	\maps[datatype=bibtex]{
		\map{ % All entry types except for media, software and online
			\pernottype{movie}
			\pernottype{video}
			\pernottype{music}
			\pernottype{audio}
			\pernottype{image}
			\pernottype{software}
			\pernottype{electronic}
			\pernottype{online}
			\pernottype{www}
			\step[fieldset=presort, fieldvalue = {A}]
		}
		\map{ % media entry types
			\pertype{movie}
			\pertype{video}
			\pertype{music}
			\pertype{audio}
			\pertype{image}
			\step[fieldset=presort, fieldvalue = {B}]
		}
		\map{ % software entry types
			\pertype{software}
			\step[fieldset=presort, fieldvalue = {C}]
		}
		\map{ % online entry types (electronic and www are aliases of online in biblatex)
			\pertype{online}
			\pertype{www}
			\pertype{electronic}
			\step[fieldset=presort, fieldvalue = {D}]
		}
	}
}

% Defines a sorting template for the nosplit option.
% This is based on Biblatex's nty sorting template but disregards the presort
% field which is generated by the source map and used to sort the bibliography
% into the four categories. See Biblatex manual section 4.5.6.
\DeclareSortingTemplate{nosplit}{
	\sort[final]{
		\field{sortkey}
	}
	\sort{
		\field{sortname}
		\field{author}
		\field{editor}
		\field{translator}
		\field{sorttitle}
		\field{title}
	}
	\sort{
		\field{sorttitle}
		\field{title}
	}
	\sort{
		\field{sortyear}
		\field{year}
	}
}

%See http://www.jr-x.de/publikationen/latex/tipps/zeilenumbruch.html
\newenvironment{bibhyphenation}% 
	{\hyphenpenalty=2%		(default 50)
	 \tolerance=9999%			(default 200)
	 \exhyphenpenalty=2%	(default 50)
	 \linepenalty=1%			(default 10)
	 \setlength{\emergencystretch}{3em}%
	 % allow URL hyphenation at any character (definitions in biblatex.def)
	 \setcounter{biburlnumpenalty}{1}%
	 \setcounter{biburlucpenalty}{1}%
	 \setcounter{biburllcpenalty}{1}%
	 \biburlsetup}%
	{}

% Currently the only public macro:
% \MakeBibliography ... creates a reference section split subsections (default)
% \MakeBibliography[nosplit] ... creates a one-piece reference section
\newcommand{\MakeBibliography}[1][]{
	% opt. arg (#1): optional argument "nosplit" to get a 1-piece bibliography
	%\clearpage
	\ifthenelse{\equal{#1}{nosplit}}%
		{% create a single bibliography with all entries:
			\printbibheading[heading=bibintoc,title={\@bibtitle}]
			\begin{bibhyphenation}	
				\begin{refcontext}[sorting=nosplit]
					\printbibliography[heading=noheader]
				\end{refcontext}
			\end{bibhyphenation}
		}%
		{% split the bibliography using the predefined categories:
			\printbibheading[heading=bibintoc,title={\@bibtitle}]
			\begin{bibhyphenation}
				\bibbycategory
			\end{bibhyphenation}
		}%
}

% Suppress unusual "In:" within journal article references. 
% see http://tex.stackexchange.com/questions/10682/suppress-in-biblatex
\renewbibmacro{in:}{%
	\ifentrytype{article}{}{%
	\printtext{\bibstring{in}\intitlepunct}}}


% To suppress warnings related to missing biblatex "drivers":
\DeclareBibliographyAlias{video}{misc}
\DeclareBibliographyAlias{movie}{misc}
\DeclareBibliographyAlias{audio}{misc}
\DeclareBibliographyAlias{software}{misc}
\DeclareBibliographyAlias{electronic}{online}	% alias of online (as in biblatex), not misc
\DeclareBibliographyAlias{image}{misc}
\DeclareBibliographyAlias{standard}{misc}
\DeclareBibliographyAlias{legislation}{misc}


% Remove the contents of the url field if a doi field is present
% To avoid duplicate DOI URLs
\AtEveryBibitem{
    \iffieldundef{doi}{}{\clearfield{url}}
}


% Use a semicolon between multiple entries in \cites
%\renewcommand*{\multicitedelim}{\addsemicolon\space}		%% abandoned, affects regular \cite{a,b,c,..} entries too

% New command for multiple citations with supplementary texts
% usage: \mcite[text1]{key1}[text2]{key2}...[textN]{keyN}
% see https://tex.stackexchange.com/a/132981
\DeclareMultiCiteCommand{\mcite}[\mkbibbrackets]{\cite}{\addsemicolon\space}


% Macro to produce cites with no backref entries
% NOTE: \citenobr is DEPRECATED, use ... {\backtrackerfalse\cite{...}} instead!
\ifthenelse{\equal{\@bibstyle}{apa}}
{
	\DeclareCiteCommand{\citenobr}% version for APA
		{\PackageWarning{hgb}{Macro \protect\citenobr\space is deprecated, use \protect\backtrackerfalse\space instead!}
		 \backtrackerfalse%
		 \usebibmacro{prenote}}
		{\usebibmacro{citeindex}%
		 \usebibmacro{cite}}%
		{\multicitedelim}
		{\usebibmacro{postnote}}
}
{
	\DeclareCiteCommand{\citenobr}%	version for numeric-comp et al.
		{\PackageWarning{hgb}{Macro \protect\citenobr\space is deprecated, use \protect\backtrackerfalse\space instead!}
		 \usebibmacro{cite:init}%
		 \bibopenbracket%
		 \backtrackerfalse%
		 \usebibmacro{prenote}%
		}
		{\usebibmacro{citeindex}%
		 \usebibmacro{cite:comp}}
		{}
		{\usebibmacro{cite:dump}%
		 \usebibmacro{postnote}%
		 \bibclosebracket}
}
	
	
	
%% hgbdict.sty
%% This file is part of the Hagenberg Thesis package for creating bachelors's and masters's theses
%% Author: Wilhelm Burger (wilbur@ieee.org)
%% GitHub: https://github.com/Digital-Media/HagenbergThesis
%% File encoding: UTF-8

%% This package defines a simple dictionary mechanism for terms used in title pages.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hgbdict}[2026/10/22]%%AUTO

\newcommand{\hgbDictionaryUndefined}{undefined}%

% Usage: \hgbDictionarySet{bachelor-thesis}{english}{Bachelor Thesis}
% Note: previously existing entry for the same key are replaced!
\newcommand{\hgbDictionarySet}[3]{%  #1=key, #2=lang, #3=term
  \expandafter\def\csname hgb@dict-#1-#2\endcsname{#3}
}

% Usage: \hgbDictionaryGet{bachelor-thesis}{english}
\newcommand{\hgbDictionaryGet}[2]{%  #1=key, #2=lang
\ifcsname hgb@dict-#1-#2\endcsname% \ifdefined, \@ifundefined
  \csname hgb@dict-#1-#2\endcsname%
  \else \hgbDictionaryUndefined% Term '#1' is undefined for language '#2'!%
  \fi
}

%% ----------------------------------------------------------------------------
%% Language-related entries:
%% ----------------------------------------------------------------------------

\hgbDictionarySet{iso-language-code}{english}{en}
\hgbDictionarySet{iso-language-code}{german}{de}
\hgbDictionarySet{iso-language-code}{ngerman}{de}
\hgbDictionarySet{iso-language-code}{french}{fr}

%% used as PDF document language tags (see https://www.rfc-editor.org/info/rfc4647):
\hgbDictionarySet{language-range-tag}{english}{en-GB}
\hgbDictionarySet{language-range-tag}{german}{de-DE}
\hgbDictionarySet{language-range-tag}{ngerman}{de-DE}
\hgbDictionarySet{language-range-tag}{french}{fr-FR}

%% ----------------------------------------------------------------------------
%% Add thesis-relevant dictionary items
%% ----------------------------------------------------------------------------
%% Note: don't rely on smart quotes being turned on!

% Front page terms:

\hgbDictionarySet{bachelor-docname}{english}{Bachelor Thesis}
\hgbDictionarySet{bachelor-docname}{german}{Bachelorarbeit}

\hgbDictionarySet{master-docname}{english}{Master's Thesis}
\hgbDictionarySet{master-docname}{german}{Masterarbeit}

\hgbDictionarySet{diploma-docname}{english}{Diploma Thesis}
\hgbDictionarySet{diploma-docname}{german}{Diplomarbeit}

\hgbDictionarySet{phd-docname}{english}{Doctoral Thesis}
\hgbDictionarySet{phd-docname}{german}{Dissertation}

\hgbDictionarySet{proposal-name}{english}{Proposal}
\hgbDictionarySet{proposal-name}{german}{Exposé}

\hgbDictionarySet{advisorheader}{english}{Supervisor}
\hgbDictionarySet{advisorheader}{german}{Betreuer*in}

\hgbDictionarySet{program-env-name}{english}{Program}
\hgbDictionarySet{program-env-name}{german}{Programm}

% ... etc.


% Internship-related terms:

\hgbDictionarySet{internship-docname}{english}{Internship Report}
\hgbDictionarySet{internship-docname}{german}{Praktikumsbericht}

\hgbDictionarySet{internship}{english}{Internship}
\hgbDictionarySet{internship}{german}{Praktikumsstelle}

\hgbDictionarySet{internship-contact-single}{english}{Contact}
\hgbDictionarySet{internship-contact-single}{german}{Kontaktperson}

\hgbDictionarySet{internship-contact-multiple}{english}{Contacts}
\hgbDictionarySet{internship-contact-multiple}{german}{Kontaktpersonen}

% Types of degree programs (default of \programtype, derived from the class option 'type'):

\hgbDictionarySet{bachelor-programtype}{english}{Bachelor's degree program}
\hgbDictionarySet{bachelor-programtype}{german}{Bachelorstudiengang}

\hgbDictionarySet{master-programtype}{english}{Master's degree program}
\hgbDictionarySet{master-programtype}{german}{Masterstudiengang}

\hgbDictionarySet{diploma-programtype}{english}{Diploma degree program}
\hgbDictionarySet{diploma-programtype}{german}{Diplomstudiengang}

\hgbDictionarySet{phd-programtype}{english}{Doctoral program}
\hgbDictionarySet{phd-programtype}{german}{Doktoratsstudium}

\hgbDictionarySet{internship-programtype}{english}{Bachelor's degree program}
\hgbDictionarySet{internship-programtype}{german}{Bachelorstudiengang}

% Academic degrees (class option 'degree=<key>'; the level is taken from the class option 'type').
% Usage: \hgbDefineDegree{<key>}{<bachelor degree>}{<master degree>}
% An empty argument means that the degree does not exist at this level.
% Degree names are the same in all languages.
\newcommand{\hgbDefineDegree}[3]{%
	\if\relax\detokenize{#2}\relax\else
		\hgbDictionarySet{degree-bachelor-#1}{english}{#2}%
		\hgbDictionarySet{degree-bachelor-#1}{german}{#2}%
	\fi
	\if\relax\detokenize{#3}\relax\else
		\hgbDictionarySet{degree-master-#1}{english}{#3}%
		\hgbDictionarySet{degree-master-#1}{german}{#3}%
	\fi
}

% Degrees of Austrian FH degree programs as defined by AQ Austria (board decision of 2021-07-07,
% approved by the ministry on 2021-08-18), abbreviations without dots:
\hgbDefineDegree{arts-design}{Bachelor of Arts in Arts and Design (BA)}{Master of Arts in Arts and Design (MA)}
\hgbDefineDegree{engineering}{Bachelor of Science in Engineering (BSc)}{Master of Science in Engineering (MSc)}
\hgbDefineDegree{social-sciences}{Bachelor of Arts in Social Sciences (BA)}{Master of Arts in Social Sciences (MA)}
\hgbDefineDegree{business}{Bachelor of Arts in Business (BA)}{Master of Arts in Business (MA)}
\hgbDefineDegree{military-leadership}{Bachelor of Arts in Military Leadership (BA)}{Master of Arts in Military Leadership (MA)}
\hgbDefineDegree{police-leadership}{Bachelor of Arts in Police Leadership (BA)}{}
\hgbDefineDegree{security-management}{}{Master of Arts in Security Management (MA)}
\hgbDefineDegree{cultural-studies}{Bachelor of Arts in Cultural Studies (BA)}{Master of Arts in Cultural Studies (MA)}
\hgbDefineDegree{natural-sciences}{Bachelor of Science in Natural Sciences (BSc)}{Master of Science in Natural Sciences (MSc)}
\hgbDefineDegree{health-studies}{Bachelor of Science in Health Studies (BSc)}{Master of Science in Health Studies (MSc)}
\hgbDefineDegree{law}{Bachelor of Laws (LLB)}{Master of Laws (LLM)}

% License texts: 

\hgbDictionarySet{strictlicense}{english}{All Rights Reserved}
\hgbDictionarySet{strictlicense}{german}{Alle Rechte vorbehalten}

\hgbDictionarySet{cclicense}{english}{%
\begin{english}
	This work is published under the conditions of the \textsf{Creative Commons License} 
	\emph{Attribution-NonCommercial-NoDerivatives 4.0 International} (CC BY-NC-ND 4.0)%
	---see \url{https://creativecommons.org/licenses/by-nc-nd/4.0/}.%
\end{english}
}

\hgbDictionarySet{cclicense}{german}{%
\begin{german}
	Diese Arbeit wird unter den Bedingungen der \textsf{Creative Commons Lizenz} 
	\emph{Attribution-NonCommercial-NoDerivatives 4.0 International} (CC BY-NC-ND 4.0) 
	veröffentlicht -- siehe \url{https://creativecommons.org/licenses/by-nc-nd/4.0/}.%
\end{german}
}

% Affidavit (text of the FH OÖ template of 2026-03-13):

\hgbDictionarySet{declaration-title}{english}{Affidavit}
\hgbDictionarySet{declaration-title}{german}{Eidesstattliche Erklärung}

\hgbDictionarySet{declaration-text}{english}{%
\begin{english}
I hereby declare that I have written the presented thesis independently and have used only the references
and aids indicated. All passages taken verbatim or paraphrased from the references are clearly identified as
such. This thesis has not been submitted, in whole or in part, in the same or a similar form, to any other
examination authority, and is identical to the electronically submitted text document.
\end{english}
}

\hgbDictionarySet{declaration-text}{german}{%
\begin{german}
Ich erkläre eidesstattlich, dass ich die vorliegende Arbeit selbständig verfasst und nur die angegebenen
Quellen und Hilfsmittel verwendet habe. Alle Stellen, die wörtlich oder inhaltlich den angegebenen Quellen
entnommen wurden, sind als solche kenntlich gemacht. Die Arbeit wurde bisher in gleicher oder ähnlicher Form
keiner anderen Prüfungsbehörde vorgelegt und ist mit dem elektronisch eingereichten Textdokument identisch.
\end{german}
}
%% hgbheadings.sty
%% Headings setup
%% This file is part of the Hagenberg Thesis package for creating bachelors's and masters's theses
%% Author: Wilhelm Burger (wilbur@ieee.org)
%% GitHub: https://github.com/Digital-Media/HagenbergThesis
%% File encoding: ASCII

\ProvidesPackage{hgbheadings}[2026/10/22]%%AUTO

\RequirePackage{fancyhdr}
\RequirePackage{extramarks} % http://mirrors.ctan.org/macros/latex/contrib/fancyhdr/fancyhdr.pdf (p. 20)
\pagestyle{fancy}

\RequirePackage[sf,raggedright]{titlesec}	% use sans serif for chapter/section headings

% Specify the CONTENT to be shown in page headers:
% See also http://mirrors.ctan.org/macros/latex/contrib/fancyhdr/fancyhdr.pdf (p. 18)
\@ifundefined{chapter}%
	{% documents without 'chapter' (article etc.)
		\renewcommand{\sectionmark}[1]{%
			\markboth{\thesection\ #1}{}}%
		\renewcommand{\subsectionmark}[1]{%
			\markright{\thesubsection\ #1}}%
	}%
	{% documents with 'chapter' (book etc.)
		\renewcommand{\chaptermark}[1]{%
			\ifthenelse{\value{chapter} < 1}%
				{\markboth{#1}{}}%
				{\markboth{\thechapter\ #1}{}}}%
		\renewcommand{\sectionmark}[1]{%
			\markright{\thesection\ #1}}%
	}%

% Specify the FORMAT of page headers:
\addtolength{\headheight}{\baselineskip}
\renewcommand{\headrulewidth}{0pt}	% no line under header
\renewcommand{\footrulewidth}{0pt}	% no line above footer

\fancyhf{}% clear all header/footer fields

\ifthenelse{\boolean{@twoside}}% @twoside is defined in LaTeX kernel
	{% twopside:
		\fancyhead[RO,LE]{\sffamily\thepage}%
		\fancyhead[LO]{\sffamily\nouppercase{\rightmark}}%
		\fancyhead[RE]{\sffamily\nouppercase{\firstleftmark}}%
	}%
	{% oneside:
		\fancyhead[R]{\sffamily\thepage}%
		\fancyhead[L]{\sffamily\nouppercase{\firstleftmark}}%
	}%

\fancypagestyle{plain}{%
	\fancyhf{}% clear all header/footer fields except the center
	\fancyfoot[C]{\sffamily\thepage}
	\renewcommand{\headrulewidth}{0pt}
	\renewcommand{\footrulewidth}{0pt}
}
%% hgblistings.sty
%% This file is part of the Hagenberg Thesis package for creating bachelors's and masters's theses
%% Author: Wilhelm Burger (wilbur@ieee.org)
%% GitHub: https://github.com/Digital-Media/HagenbergThesis
%% File encoding: UTF-8

\ProvidesPackage{hgblistings}[2026/10/22]%%AUTO

\RequirePackage{xifthen}
\RequirePackage{textcomp}	%% required for upquote option
\RequirePackage{xcolor}

%% Package options -------------------------------------------------------------

% codestyle=color|mono|classic: style of the code listings (default: color). Usually given as class option
% of hgbthesis, hgbreport or hgbarticle, which pass it on to this package.
\newcommand{\hgb@CodeStyle}{color}
\DeclareKeys[hgblistings]{
	codestyle.code = {%
		\ifthenelse{\equal{#1}{color} \OR \equal{#1}{mono} \OR \equal{#1}{classic}}%
			{\renewcommand{\hgb@CodeStyle}{#1}}%
			{\PackageError{hgblistings}{Unknown value '#1' for option 'codestyle'}%
				{Allowed values are color (default), mono and classic.}}},
}
\ProcessKeyOptions[hgblistings]

%% Colors ----------------------------------------------------------------------

% Syntax colors close to the "Light+" theme of Visual Studio Code (keywords in the color of the algorithms
% in hgbalgo.sty), each with a contrast ratio of at least 4.5:1 against white (WCAG AA). Comments are also set
% in italics, so they do not depend on color alone. Defined in RGB (PDF/A); they can be redefined with
% \definecolor in the preamble of a document.
\definecolor{ListingsKeywordColor}{rgb}{0.00,0.00,0.666}	% keywords (dark blue, same as AlgKeywordColor)
\definecolor{ListingsTypeColor}{HTML}{267F99}				% built-in types and functions (teal)
\definecolor{ListingsStringColor}{HTML}{A31515}				% strings (dark red)
\definecolor{ListingsCommentColor}{HTML}{008000}			% comments (green)
\definecolor{ListingsLineNumberColor}{gray}{0.45}			% line numbers (styles 'color' and 'mono')
\definecolor{ListingsRuleColor}{gray}{0.75}					% rule left of the code (styles 'color' and 'mono')
\definecolor{ListingsBackgroundColor}{gray}{0.95}			% background (style 'classic')

%% Basic settings (all styles) -------------------------------------------------

\RequirePackage{listingsutf8}
\lst@RequireAspects{directives,tex}	% keys 'directivestyle' and 'texcsstyle' are used in the styles below
\lstset{
	inputencoding=utf8,
	extendedchars=true,
	basicstyle=\ttfamily\footnotesize,
	showstringspaces=false,
	columns=flexible,
	breaklines=true,
	tabsize=2,
	numbers=left,
	numbersep=5pt,
	stepnumber=1,
	numberfirstline=true,
	numberblanklines=true,
	texcl=false,		% program comments are not read as LaTeX content
	mathescape=false,	% no math escape by default
	upquote=true,
	keepspaces=true,
}

%% Styles ----------------------------------------------------------------------

% 'classic': previous look (gray box, no syntax highlighting)
\lstdefinestyle{hgbclassic}{
	backgroundcolor=\color{ListingsBackgroundColor},
	frame=none,
	framerule=0.4pt,		% defaults of listings, reset when switching from another style
	framesep=3pt,
	xleftmargin=6mm,
	framexleftmargin=6mm,
	numbersep=5pt,
	numberstyle=\normalfont\scriptsize,
	keywordstyle={},
	keywordstyle={[2]},
	identifierstyle={},
	commentstyle=\normalfont\itshape,
	stringstyle=\ttfamily,
	directivestyle={},
	texcsstyle={},
}

% 'mono': white background with a thin rule left of the code (between line numbers and code), no colors
\lstdefinestyle{hgbmono}{
	backgroundcolor={},
	frame=l,
	framerule=0.8pt,
	rulecolor=\color{ListingsRuleColor},
	xleftmargin=8mm,		% code
	framesep=2mm,			% rule 2mm left of the code
	framexleftmargin=0mm,
	numbersep=4mm,			% line numbers 2mm left of the rule
	numberstyle=\normalfont\scriptsize\color{ListingsLineNumberColor},
	keywordstyle={},
	keywordstyle={[2]},
	identifierstyle={},
	commentstyle=\ttfamily\itshape,
	stringstyle=\ttfamily,
	directivestyle={},
	texcsstyle={},
}

% 'color': like 'mono', with syntax colors
\lstdefinestyle{hgbcolor}{
	style=hgbmono,
	keywordstyle=\color{ListingsKeywordColor},
	keywordstyle={[2]\color{ListingsTypeColor}},
	commentstyle=\color{ListingsCommentColor}\ttfamily\itshape,
	stringstyle=\color{ListingsStringColor}\ttfamily,
	directivestyle=\color{ListingsKeywordColor},
	texcsstyle=*\color{ListingsKeywordColor},
}

% Apply the selected style (can be changed per listing, e.g., \begin{JavaCode}[style=hgbmono]):
\edef\@tempa{\noexpand\lstset{style=hgb\hgb@CodeStyle}}\@tempa

\RequirePackage[utf8]{inputenc}
\lstset{literate=% to allow Umlauts etc. in listed code % utf8-change
{Ö}{{\"O}}1
{Ä}{{\"A}}1
{Ü}{{\"U}}1
{ü}{{\"u}}1
{ä}{{\"a}}1
{ö}{{\"o}}1
{ß}{{\ss}}2
}

%% Language definitions --------------------------------------------------------
%% Keywords of current language versions. Languages that are also defined by listings are extended or replaced
%% by the dialect [hgb]; where possible, it is set as default dialect, so that e.g. language=Java (also in
%% \lstinputlisting) selects [hgb]Java. Keyword classes: 1 = keywords (ListingsKeywordColor),
%% 2 = built-in types, functions and annotations (ListingsTypeColor).

% Bash, stand-alone definition (the definition of listings mixes keywords and common commands such as cat, ps
% and sed); reserved words are keywords, builtins are keywords of class 2; $# and ${#...} start no comments
\lstdefinelanguage[hgb]{bash}{
	morekeywords={break,case,continue,coproc,do,done,elif,else,esac,exit,fi,for,function,if,in,return,select,
		then,time,until,while},
	morekeywords=[2]{alias,bg,bind,builtin,caller,cd,command,compgen,complete,declare,dirs,disown,echo,
		enable,eval,exec,export,false,fc,fg,getopts,hash,help,history,jobs,kill,let,local,logout,mapfile,popd,
		printf,pushd,pwd,read,readarray,readonly,set,shift,shopt,source,test,times,trap,true,type,typeset,
		ulimit,umask,unalias,unset,wait},
	otherkeywords={$\#},
	sensitive,
	morecomment=[l]\#,
	moredelim=[s][]{$\{}{\}},
	morestring=[b]",
	morestring=[d]',
}[keywords,comments,strings]

