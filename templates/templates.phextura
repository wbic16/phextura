  \sbox{\neo@stream@headercontent}{%
     \begin{minipage}{\dimexpr\textwidth-20pt}
        \centering
        \ifx\@subject\empty\else \usebox{\neo@stream@subject}\par\vspace{\neo@title@sep@subjectbox} \fi
