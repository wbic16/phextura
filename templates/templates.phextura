\newcommand*{\idx@@heading}{%
  \ifidx@leveldown
    \expandafter\section
  \else
    \expandafter\chapter
  \fi*%
}
\newcommand*{\idx@@forcemark}[1]{%
  \ifidx@leveldown
    \addsecmark{#1}%
  \else
    \@mkdouble{\MakeMarkcase{#1}}%
  \fi
}
\newcommand*{\idx@@forcemarknumbered}[1]{%
  \ifidx@leveldown
    \sectionmark{#1}%
  \else
    \chaptermark{#1}%
  \fi
}
