    \KOMA@kav@replacebool
    {typearea.\scr@pkgextension}%
    {twocolumn}{@twocolumn}%
    \csname recalctypearea\endcsname
  \fi
}
\KOMA@kav@xadd{typearea.\scr@pkgextension}{twocolumn}{%
