        \noexpand\TUDoption{\tud@res@b}{\tud@res@a}%
        \global\noexpand\csletcs{tud@\tud@res@b @dim}{tud@\tud@res@b @dim}%
      }%
    \tud@res@a%
    \global\setlength#1{\maxdimen}%
  \fi%
}
