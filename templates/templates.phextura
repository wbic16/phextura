\tl_set:Nn \l__gzt_title_box_tl
{
  \bool_if:NF {\g__gzt_invisible_titles_bool} {
    \noindent
    % \bool_show:N \g__gzt_title_not_in_article_bool
    \hspace*{18mm}
    \begin{adjustbox}{minipage=\linewidth-18mm,valign=t}
