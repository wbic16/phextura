}

\DeclareDocumentEnvironment{SDbox}{ G{} s O{0.5} }{%------OPENING
\NumberFloattrue
\ifempty{#1}%
   {\NumberFloatfalse}%
   {\def\@captype{#1}}%
\IfBooleanTF{#2}%
  {\SDlinewidth=\dimexpr\textwidth+0.8\marginparwidth}%
  {\SDlinewidth=\textwidth}%
