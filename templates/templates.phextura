      \char_set_catcode_letter:N \_
      \char_set_catcode_letter:N \:
      \kssd@cs
  }
\ExplSyntaxOff
\newcommand*\kssd@cs[1]{%
  \kssd@cs@saved{#1}%
  \endgroup
}
