  %   ^^A     \@emptify\gmu@tempb
  %   ^^A     \gmd@nlperc\cs}%
  % ^^A   {
  % \UnDef
  \@emptify\gmu@tempa
  \def\gmu@tempb{\gmboxedspace}%
  \gmd@nlperc\cs
  % ^^A}
}

