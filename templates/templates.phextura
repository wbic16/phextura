 \def\RCSfile{cas-sc}%
 \def\RCSversion{2.4}%
 \def\RCSdate{2024/05/04}%
\NeedsTeXFormat{LaTeX2e}[1995/12/01]
\ProvidesClass{\RCSfile}[\RCSdate, \RCSversion: Formatting class
   for CAS single column articles]
