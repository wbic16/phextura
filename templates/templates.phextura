      -- cycle
      (7.87,22.14) -- (17.32,22.14)
      .. controls (20.12,22.14) and (22.25,21.48) .. (23.72,20.17)
      .. controls (25.19,18.86) and (25.93,16.95) .. (25.93,14.46)
      .. controls (25.93,11.97) and (25.18,10.06) .. (23.69,8.60)
      .. controls (22.20,7.14) and (20.15,6.39) .. (17.53,6.35)
      -- (7.87,6.35) -- cycle;

    \path[fill=lsered]
      (56.75,18.53)
      .. controls (55.75,18.36) and (54.73,18.28) .. (53.67,18.28)
      .. controls (50.21,18.28) and (47.88,19.61) .. (46.67,22.26)
      -- (46.67,45.27) -- (39.12,45.27) -- (39.12,11.63)
      -- (46.33,11.63) -- (46.52,15.39)
      .. controls (48.34,12.47) and (50.87,11.01) .. (54.11,11.01)
      .. controls (55.19,11.01) and (56.08,11.16) .. (56.78,11.45)
