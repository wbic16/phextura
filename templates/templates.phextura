        \tcbset{title={\neo@codename~\thelstcode\neoschool@codeseparator~~\neo@safetitle{#4}\neo@codelang@intitle{#2}},\neoschool@boxtitle}%
      \fi%
    },
    \neo@codecenter,
    #7
  }

  \NewTCBInputListing{\codeinputnonum}{ O{} m m !O{} !O{\neoschool@codestyle} !D<>{\neoschool@codewidth} !O{} }{
