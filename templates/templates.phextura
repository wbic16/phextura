  {
    \prop_if_in:NnTF \c__dfg_custom_getters_prop {#1}
      { \exp_args:Ne \use:n { \prop_item:Nn \c__dfg_custom_getters_prop {#1} } }
      { \msg_expandable_error:nnn {dfg} {unknown-customization-value} {#1} }
  }
