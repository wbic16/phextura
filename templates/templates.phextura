\else
  \def\GrEmphFont{outgr}
  \def\GrEmphHanjaFont{outgt}
\fi
\else
\if@bfem
  \def\GrEmphFont{nanummj}
  \def\GrEmphHanjaFont{uhcmj}
\else
  \def\GrEmphFont{nanumgt}
  \def\GrEmphHanjaFont{nanumgt}
\fi
\fi
