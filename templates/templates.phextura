\newcommand{\neo@magazinecontent}{%
  \thispagestyle{customfirstpage}

  \sbox{\neo@magazine@headercontent}{%
     \begin{minipage}{\dimexpr\textwidth-1cm}
        \raggedright

        \ifx\@subject\empty\else
            {\tcbox[
                on line,
                colback=neo@onprimary!20!primaryColor,
                colframe=neo@onprimary!20!primaryColor,
                boxrule=0pt, boxsep=0pt,
                left=4pt, right=4pt, top=2pt, bottom=2pt,
                sharp corners,
                nobeforeafter
            ]{\usekomafont{subject}\color{neo@onprimary}\@subject}}\par\vspace{\neo@title@sep@subjectbox}
        \fi

        {\neo@fit{\hsize}{2}{\raggedright}{\fontfamily{\sfdefault}\fontsize{32}{38}\selectfont\bfseries\color{neo@onprimary}}{\@title}}\par\vspace{\neo@title@sep@subtitle}

        \ifx\@subtitle\empty\else
          {\neo@fit{\hsize}{\neo@fitsublines}{\raggedright}{\usekomafont{subtitle}\color{neo@onprimary}}{\@subtitle}}\\[0.8em]
        \fi
     \end{minipage}%
  }

  \begin{tikzpicture}[remember picture, overlay]

    \coordinate (NW) at (current page.north west);
    \coordinate (NE) at (current page.north east);

    \fill[primaryColor]
        (NW) --
        (NE) --
        ([yshift=-3.5cm]NE) --
        ([yshift=-7.5cm]NW) --
        cycle;

    \fill[secondaryColor]
        ([yshift=-7.5cm]NW) --
        ([yshift=-3.5cm]NE) --
        ([yshift=-4.2cm]NE) --
        ([yshift=-8.5cm]NW) --
        cycle;

    \draw[neo@onprimary, opacity=0.1, line width=1pt]
        ([xshift=-2cm, yshift=-1cm]NE) -- ([xshift=-2cm, yshift=-5cm]NE);

    \node[
        anchor=north west,
        inner sep=0pt,
    ] (headerbox) at ([xshift=1.5cm, yshift=-1.25cm]current page.north west) {
        \usebox{\neo@magazine@headercontent}
    };

  \end{tikzpicture}

  \neo@top@compensate
  \if@twocolumn \vspace*{8cm} \else \vspace*{7cm}\fi
}

