\cs_new_protected:Npn \CTEX@addloflotskip #1
  {
    \skip_set:Nn \l__ctex_heading_skip { \use:c { CTEX@#1@lofskip } }
    \skip_if_eq:nnF { \l__ctex_heading_skip } { \c_zero_skip }
      {
